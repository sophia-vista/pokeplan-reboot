-- Version 9 to 10: LINK's own record tables (see Data.sq). New in this version: nothing is moved, the tables start empty.
CREATE TABLE link_person (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE link_note (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE link_date (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE link_followup (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE link_state (
    key TEXT NOT NULL PRIMARY KEY,
    json TEXT NOT NULL
);
