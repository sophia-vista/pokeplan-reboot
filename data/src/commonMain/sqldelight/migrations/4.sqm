-- Version 4 to 5: PLAN's own record tables (see Data.sq). PLAN's part of the save document moves into them once, when the app starts.
CREATE TABLE plan_task (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE plan_list (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE plan_event (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE plan_series (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE plan_goal (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE plan_review (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE plan_focus_record (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

-- The two sets of days (rest days; days with a paid task or a finished session), one row each.
CREATE TABLE plan_day (
    kind TEXT NOT NULL,
    day TEXT NOT NULL,
    PRIMARY KEY (kind, day)
);

CREATE TABLE plan_state (
    key TEXT NOT NULL PRIMARY KEY,
    json TEXT NOT NULL
);
