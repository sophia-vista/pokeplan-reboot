ALTER TABLE owned_pokemon ADD COLUMN position INTEGER NOT NULL DEFAULT 0;
ALTER TABLE owned_pokemon ADD COLUMN origin_json TEXT;
UPDATE owned_pokemon SET position = rowid;

CREATE TABLE pokemon_place (
    owned_id TEXT NOT NULL PRIMARY KEY REFERENCES owned_pokemon(id) ON DELETE CASCADE,
    kind TEXT NOT NULL CHECK (kind IN ('buddy', 'party', 'guardian')),
    ref TEXT NOT NULL DEFAULT '',
    slot INTEGER NOT NULL DEFAULT 0,
    UNIQUE (kind, ref, slot),
    CHECK ((kind = 'buddy' AND ref = '' AND slot = 0) OR (kind = 'guardian' AND ref = '' AND slot >= 1) OR (kind = 'party' AND ref <> '' AND slot >= 1))
);

INSERT OR IGNORE INTO pokemon_place(owned_id, kind, ref, slot) SELECT owned_id, 'guardian', '', slot FROM guardian_slot ORDER BY slot;
INSERT OR IGNORE INTO pokemon_place(owned_id, kind, ref, slot) SELECT owned_id, 'buddy', '', 0 FROM buddy_selection;
INSERT OR IGNORE INTO pokemon_place(owned_id, kind, ref, slot) SELECT owned_id, 'party', lower(module_id), slot FROM module_party ORDER BY module_id, slot;

DROP TABLE guardian_slot;
DROP TABLE buddy_selection;
DROP TABLE module_party;

CREATE TABLE pokemon_state (
    key TEXT NOT NULL PRIMARY KEY,
    json TEXT NOT NULL
);
