-- Version 8 to 9: HOME's own record tables (see Data.sq). New in this version: nothing is moved, the tables start empty.
CREATE TABLE home_area (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE home_chore (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

