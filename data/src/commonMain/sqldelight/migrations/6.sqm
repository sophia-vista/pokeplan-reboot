-- Version 6 to 7: HEAL's own record tables (see Data.sq). New in this version: nothing is moved, the tables start empty.
CREATE TABLE heal_activity (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE heal_hydration (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE heal_sleep (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE heal_measurement (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE heal_goal (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE heal_state (
    key TEXT NOT NULL PRIMARY KEY,
    json TEXT NOT NULL
);
