-- Schema version 7 of the PokéLife database (docs/pokelife ARCHITECTURE/DATA_AND_MIGRATIONS.md sections 7 and 8).
-- It holds the shared Pokémon and economy side and a legacy sidecar for every module that has no tables yet.
-- Every later change is a numbered migration (N.sqm) checked against the committed schema file (databases/N.db).

CREATE TABLE app_meta (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

-- One owned Pokémon (POKEMON_ECOSYSTEM.md section 4). The id is the legacy id, kept as it was.
CREATE TABLE owned_pokemon (
    id TEXT NOT NULL PRIMARY KEY,
    species_id INTEGER NOT NULL CHECK (species_id > 0),
    form_identifier TEXT NOT NULL,
    nickname TEXT NOT NULL,
    nature TEXT NOT NULL,
    ability TEXT NOT NULL,
    gender TEXT,
    iv_hp INTEGER NOT NULL CHECK (iv_hp BETWEEN 0 AND 31),
    iv_attack INTEGER NOT NULL CHECK (iv_attack BETWEEN 0 AND 31),
    iv_defense INTEGER NOT NULL CHECK (iv_defense BETWEEN 0 AND 31),
    iv_sp_attack INTEGER NOT NULL CHECK (iv_sp_attack BETWEEN 0 AND 31),
    iv_sp_defense INTEGER NOT NULL CHECK (iv_sp_defense BETWEEN 0 AND 31),
    iv_speed INTEGER NOT NULL CHECK (iv_speed BETWEEN 0 AND 31),
    ev_hp INTEGER NOT NULL CHECK (ev_hp BETWEEN 0 AND 252),
    ev_attack INTEGER NOT NULL CHECK (ev_attack BETWEEN 0 AND 252),
    ev_defense INTEGER NOT NULL CHECK (ev_defense BETWEEN 0 AND 252),
    ev_sp_attack INTEGER NOT NULL CHECK (ev_sp_attack BETWEEN 0 AND 252),
    ev_sp_defense INTEGER NOT NULL CHECK (ev_sp_defense BETWEEN 0 AND 252),
    ev_speed INTEGER NOT NULL CHECK (ev_speed BETWEEN 0 AND 252),
    level INTEGER NOT NULL CHECK (level BETWEEN 1 AND 100),
    candy_progress INTEGER NOT NULL CHECK (candy_progress >= 0),
    total_candies INTEGER NOT NULL CHECK (total_candies >= 0),
    friendship INTEGER NOT NULL CHECK (friendship BETWEEN 0 AND 255),
    is_shiny INTEGER NOT NULL CHECK (is_shiny IN (0, 1)),
    held_item TEXT,
    tera_type TEXT,
    cosmetic_form TEXT,
    personality INTEGER NOT NULL,
    caught_at_millis INTEGER NOT NULL,
    -- Global favourite flag (POKEMON_ECOSYSTEM.md section 6.4).
    is_favorite INTEGER NOT NULL DEFAULT 0 CHECK (is_favorite IN (0, 1)),
    -- How it joined the collection (the legacy "origin"), null for Pokémon from before it was recorded.
    origin_how TEXT,
    origin_region TEXT,
    -- Any field of the legacy record this version has no column for, kept as raw JSON, never dropped.
    extra_json TEXT,
    -- Version 6: the place in the collection's list (the order the Pokémon were owned, which a party's member order follows), and the
    -- origin exactly as the save keeps it (origin_how and origin_region are its lookup columns).
    position INTEGER NOT NULL DEFAULT 0,
    origin_json TEXT,
    CHECK (ev_hp + ev_attack + ev_defense + ev_sp_attack + ev_sp_defense + ev_speed <= 510)
);

CREATE INDEX owned_pokemon_species ON owned_pokemon(species_id, form_identifier);

-- Where a Pokémon is (POKEMON_ECOSYSTEM.md sections 2.2 and 6.2, owner decision 7 November 2026): **one place only**. The primary key is the
-- Pokémon, so a second row for it cannot exist; no row means the PC. A party is its module's party id in `ref` (the lower-case module id the save uses, `plan`) and the lead is slot 1; the buddy
-- is the one row of its kind (slot 0); a Guardian has its slot. A WORLD expedition team and a GEAR helper are the other two places: their
-- records stay with their module (the 'save' row), and the live write refuses a save that puts one of those Pokémon here as well.
CREATE TABLE pokemon_place (
    owned_id TEXT NOT NULL PRIMARY KEY REFERENCES owned_pokemon(id) ON DELETE CASCADE,
    kind TEXT NOT NULL CHECK (kind IN ('buddy', 'party', 'guardian')),
    ref TEXT NOT NULL DEFAULT '',
    slot INTEGER NOT NULL DEFAULT 0,
    UNIQUE (kind, ref, slot),
    CHECK ((kind = 'buddy' AND ref = '' AND slot = 0) OR (kind = 'guardian' AND ref = '' AND slot >= 1) OR (kind = 'party' AND ref <> '' AND slot >= 1))
);

-- Species and forms ever seen, caught or owned as a shiny; they survive a transfer (POKEMON_ECOSYSTEM.md section 5).
CREATE TABLE dex_history (
    kind TEXT NOT NULL CHECK (kind IN ('caught_species', 'shiny_species', 'caught_form', 'shiny_form', 'seen_species')),
    ref INTEGER NOT NULL,
    PRIMARY KEY (kind, ref)
);

CREATE TABLE player_progress (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    egg_meter INTEGER NOT NULL CHECK (egg_meter >= 0),
    trainer_points INTEGER NOT NULL CHECK (trainer_points >= 0)
);

-- The player's single values that have no table of their own (version 6): the leads a party was given, the roles version and any field a
-- newer build adds to the player, the favourites and origins of Pokémon that are no longer owned. One row per key, as JSON.
CREATE TABLE pokemon_state (
    key TEXT NOT NULL PRIMARY KEY,
    json TEXT NOT NULL
);

-- The one Bag: candies, berries, evolution items and every other stack.
CREATE TABLE bag_stack (
    item_id TEXT NOT NULL PRIMARY KEY,
    quantity INTEGER NOT NULL CHECK (quantity >= 0)
);

-- The one currency, Poké.
CREATE TABLE currency_balance (
    currency TEXT NOT NULL PRIMARY KEY CHECK (currency = 'poke'),
    amount INTEGER NOT NULL CHECK (amount >= 0)
);

-- A settled event. event_id is the idempotency key: <module>:<source record>:<kind>[:<occurrence>].
CREATE TABLE reward_event (
    event_id TEXT NOT NULL PRIMARY KEY,
    source_module TEXT NOT NULL,
    source_record_id TEXT NOT NULL,
    event_kind TEXT NOT NULL,
    policy_version TEXT NOT NULL,
    settled_at INTEGER NOT NULL,
    metadata_json TEXT
);

-- Append-only: an entry is never changed or removed; a reversal is a new entry that points at the original.
CREATE TABLE reward_ledger_entry (
    entry_id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    event_id TEXT NOT NULL REFERENCES reward_event(event_id),
    asset TEXT NOT NULL,
    delta INTEGER NOT NULL CHECK (delta <> 0),
    reverses_entry_id INTEGER REFERENCES reward_ledger_entry(entry_id),
    UNIQUE (event_id, asset)
);

CREATE INDEX reward_ledger_asset ON reward_ledger_entry(asset);

CREATE TRIGGER reward_ledger_no_update BEFORE UPDATE ON reward_ledger_entry
BEGIN
    SELECT RAISE(ABORT, 'the reward ledger is append-only');
END;

CREATE TRIGGER reward_ledger_no_delete BEFORE DELETE ON reward_ledger_entry
BEGIN
    SELECT RAISE(ABORT, 'the reward ledger is append-only');
END;

CREATE TABLE outbox_event (
    outbox_id TEXT NOT NULL PRIMARY KEY,
    event_kind TEXT NOT NULL,
    contract_version INTEGER NOT NULL,
    payload_json TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE processed_event (
    consumer TEXT NOT NULL,
    outbox_id TEXT NOT NULL REFERENCES outbox_event(outbox_id),
    processed_at INTEGER NOT NULL,
    PRIMARY KEY (consumer, outbox_id)
);

-- One row per import or schema migration run.
CREATE TABLE migration_history (
    migration_id TEXT NOT NULL PRIMARY KEY,
    kind TEXT NOT NULL CHECK (kind IN ('legacy_json_import')),
    source_checksum TEXT NOT NULL,
    status TEXT NOT NULL CHECK (status IN ('complete')),
    completed_at INTEGER NOT NULL,
    summary_json TEXT NOT NULL
);

CREATE TABLE import_warning (
    warning_id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    migration_id TEXT NOT NULL REFERENCES migration_history(migration_id),
    code TEXT NOT NULL,
    detail TEXT NOT NULL
);

-- Every legacy field that has no table yet (PLAN, CARE, WORLD, GEAR, settings), as raw JSON by its legacy path.
-- Written only by the importer; a module moves its fields out when it gets its own tables.
CREATE TABLE legacy_sidecar (
    source TEXT NOT NULL CHECK (source IN ('save', 'care')),
    path TEXT NOT NULL,
    json TEXT NOT NULL,
    PRIMARY KEY (source, path)
);

-- The live save (version 2, the cutover): the app's own JSON documents ('save' = AppData, 'care' = CareData) kept inside the
-- database so every write is one transaction and a backup is one file. This is the single authority once the activation
-- marker is set; the normalized tables above are not read by the app until each module is refactored onto them (REP-014).
-- Unreadable documents are kept aside under 'aside:<name>:<millis>' and never overwritten.
CREATE TABLE live_document (
    name TEXT NOT NULL PRIMARY KEY,
    json TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

-- The shared reminder feature's own records (INTEGRATIONS_AND_PRIVACY.md section 9): only reminders held back from what the modules
-- rebuild by themselves (a snooze, an unanswered-reminder repeat). Opaque references and times only, never a title or a note; the modules'
-- own records stay canonical and every other reminder is rebuilt from them (section 9.8).
CREATE TABLE reminder_hold (
    id TEXT NOT NULL PRIMARY KEY,
    module TEXT NOT NULL,
    source_ref TEXT NOT NULL,
    kind TEXT NOT NULL,
    occurrence TEXT NOT NULL,
    at_millis INTEGER NOT NULL,
    reason TEXT NOT NULL CHECK (reason IN ('snooze', 'repeat')),
    created_at INTEGER NOT NULL
);

-- CARE's own records (version 4, REP-014): the Care save moved out of the live document into tables, one family per kind of
-- record so a private kind (the journal, the diary) can be read, exported or erased on its own. A record table keeps the
-- columns the app asks by (its key, its place in the list, its day) and the record itself as JSON in `json`, so the typed
-- model stays the one definition of a record and a field it does not know yet is never dropped. `position` is the order of the
-- list; a record without an id of its own is keyed by its position.
CREATE TABLE care_routine (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

-- The days a routine was done, one row each (a routine's json holds everything but these).
CREATE TABLE care_routine_completion (
    routine_key TEXT NOT NULL REFERENCES care_routine(key) ON DELETE CASCADE,
    day TEXT NOT NULL,
    PRIMARY KEY (routine_key, day)
);

CREATE TABLE care_diary_card (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE care_journal_entry (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE care_calm_break (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE care_skill_practice (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

-- Visitors in the meadow and in the queue (in arrival order), and the ones the player sent away (kept, so a dismissal can be undone).
CREATE TABLE care_visitor (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE care_dismissed_visitor (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

-- Everything else Care keeps that is one value rather than a list: its settings, the visit in progress, the journal draft, the
-- skipped prompts, the rhythm weeks, the visitor seed, and any field a newer build adds. One row per top-level field.
CREATE TABLE care_state (
    key TEXT NOT NULL PRIMARY KEY,
    json TEXT NOT NULL
);

-- PLAN's own records (version 5, REP-014): PLAN's part of the save document ('save' = AppData, which PLAN shares with the player) moved
-- into tables. Same shape as CARE's (key, position, day, and the record as JSON in `json`). What is not PLAN's stays in the 'save'
-- row of live_document. `plan_day` holds the rest days and the active days; `plan_state` the single values (the running focus
-- session, the completions waiting out their undo, the pick, the emergency pauses, the legacy habits kept after their merge into
-- recurring tasks, and any field a newer build adds).
CREATE TABLE plan_task (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE plan_list (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE plan_event (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE plan_series (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE plan_goal (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE plan_review (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE plan_focus_record (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE plan_day (
    kind TEXT NOT NULL,
    day TEXT NOT NULL,
    PRIMARY KEY (kind, day)
);

CREATE TABLE plan_state (
    key TEXT NOT NULL PRIMARY KEY,
    json TEXT NOT NULL
);

-- HEAL's own records (version 7, REP-014): the Heal save kept in tables from the start, one family per kind of private record (activity,
-- hydration, sleep, body measurements, goals) so each can be read, exported or erased on its own. Same shape as CARE's and PLAN's (key,
-- position, day, and the record as JSON in `json`). `heal_state` holds the settings and any field a newer build adds. HEAL never has a
-- row in `live_document`: it is created in the tables.
CREATE TABLE heal_activity (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE heal_hydration (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE heal_sleep (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE heal_measurement (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE heal_goal (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE heal_state (
    key TEXT NOT NULL PRIMARY KEY,
    json TEXT NOT NULL
);

-- MINT's own records (version 8, REP-014): the Mint save kept in tables from the start, one family per kind of private record (account, category,
-- transaction, budget, bill, bill payment, reconciliation, review) so each can be read, exported or erased on its own. Same shape as HEAL's (key,
-- position, day, and the record as JSON in `json`; every amount is an integer in minor units inside that JSON, never a floating-point number).
-- `mint_state` holds the settings and any field a newer build adds. MINT never has a row in `live_document`: it is created in the tables.
CREATE TABLE mint_account (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE mint_category (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE mint_transaction (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE mint_budget (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE mint_bill (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE mint_bill_payment (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE mint_reconciliation (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE mint_review (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE mint_state (
    key TEXT NOT NULL PRIMARY KEY,
    json TEXT NOT NULL
);

-- Owned Pokémon.
insertPokemon:
INSERT INTO owned_pokemon(
    id, species_id, form_identifier, nickname, nature, ability, gender,
    iv_hp, iv_attack, iv_defense, iv_sp_attack, iv_sp_defense, iv_speed,
    ev_hp, ev_attack, ev_defense, ev_sp_attack, ev_sp_defense, ev_speed,
    level, candy_progress, total_candies, friendship, is_shiny, held_item, tera_type, cosmetic_form,
    personality, caught_at_millis, is_favorite, origin_how, origin_region, extra_json, position, origin_json
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

pokemonById:
SELECT * FROM owned_pokemon WHERE id = ?;

allPokemon:
SELECT * FROM owned_pokemon ORDER BY position, caught_at_millis, id;

pokemonCount:
SELECT count(*) FROM owned_pokemon;

nextPokemonPosition:
SELECT coalesce(max(position), 0) + 1 FROM owned_pokemon;

updatePokemon:
UPDATE owned_pokemon SET
    species_id = ?, form_identifier = ?, nickname = ?, nature = ?, ability = ?, gender = ?,
    iv_hp = ?, iv_attack = ?, iv_defense = ?, iv_sp_attack = ?, iv_sp_defense = ?, iv_speed = ?,
    ev_hp = ?, ev_attack = ?, ev_defense = ?, ev_sp_attack = ?, ev_sp_defense = ?, ev_speed = ?,
    level = ?, candy_progress = ?, total_candies = ?, friendship = ?, is_shiny = ?, held_item = ?, tera_type = ?, cosmetic_form = ?,
    personality = ?, caught_at_millis = ?, is_favorite = ?, origin_how = ?, origin_region = ?, extra_json = ?, position = ?, origin_json = ?
WHERE id = ?;

releasePokemon:
DELETE FROM owned_pokemon WHERE id = ?;

-- Places: a Pokémon has at most one row.
placeOf:
SELECT kind, ref, slot FROM pokemon_place WHERE owned_id = ?;

allPlaces:
SELECT owned_id, kind, ref, slot FROM pokemon_place ORDER BY kind, ref, slot;

removePlace:
DELETE FROM pokemon_place WHERE owned_id = ?;

insertPlace:
INSERT INTO pokemon_place(owned_id, kind, ref, slot) VALUES (?, ?, ?, ?);

clearPlaces:
DELETE FROM pokemon_place WHERE kind = ? AND ref = ?;

partyOf:
SELECT slot, owned_id FROM pokemon_place WHERE kind = 'party' AND ref = ? ORDER BY slot;

partySlotCount:
SELECT count(*) FROM pokemon_place WHERE kind = 'party';

buddy:
SELECT owned_id FROM pokemon_place WHERE kind = 'buddy';

guardians:
SELECT slot, owned_id FROM pokemon_place WHERE kind = 'guardian' ORDER BY slot;

placeCount:
SELECT count(*) FROM pokemon_place;

moveSlot:
UPDATE pokemon_place SET slot = ? WHERE owned_id = ?;

-- Dex history.
addDex:
INSERT OR IGNORE INTO dex_history(kind, ref) VALUES (?, ?);

dexOf:
SELECT ref FROM dex_history WHERE kind = ? ORDER BY ref;

-- Progress.
setProgress:
INSERT OR REPLACE INTO player_progress(id, egg_meter, trainer_points) VALUES (1, ?, ?);

progress:
SELECT egg_meter, trainer_points FROM player_progress WHERE id = 1;

-- Bag and Poké balances (changed only together with a ledger entry).
ensureBalance:
INSERT OR IGNORE INTO currency_balance(currency, amount) VALUES ('poke', 0);

pokeBalance:
SELECT amount FROM currency_balance WHERE currency = 'poke';

addPoke:
UPDATE currency_balance SET amount = amount + ? WHERE currency = 'poke';

bagQuantity:
SELECT quantity FROM bag_stack WHERE item_id = ?;

-- No upsert: Android 8 (minSdk 26) ships SQLite 3.18.
ensureStack:
INSERT OR IGNORE INTO bag_stack(item_id, quantity) VALUES (?, 0);

addToBag:
UPDATE bag_stack SET quantity = quantity + ? WHERE item_id = ?;

dropEmptyStacks:
DELETE FROM bag_stack WHERE quantity = 0;

bag:
SELECT item_id, quantity FROM bag_stack ORDER BY item_id;

-- Events and the ledger.
eventById:
SELECT * FROM reward_event WHERE event_id = ?;

insertEvent:
INSERT INTO reward_event(event_id, source_module, source_record_id, event_kind, policy_version, settled_at, metadata_json)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertLedgerEntry:
INSERT INTO reward_ledger_entry(event_id, asset, delta, reverses_entry_id) VALUES (?, ?, ?, ?);

lastInsertedRow:
SELECT last_insert_rowid();

ledgerOfEvent:
SELECT * FROM reward_ledger_entry WHERE event_id = ? ORDER BY entry_id;

ledgerReversalOf:
SELECT entry_id FROM reward_ledger_entry WHERE reverses_entry_id = ?;

ledgerTotals:
SELECT asset, sum(delta) AS total FROM reward_ledger_entry GROUP BY asset ORDER BY asset;

ledgerCount:
SELECT count(*) FROM reward_ledger_entry;

eventCount:
SELECT count(*) FROM reward_event;

-- Outbox.
insertOutbox:
INSERT INTO outbox_event(outbox_id, event_kind, contract_version, payload_json, created_at) VALUES (?, ?, ?, ?, ?);

pendingOutbox:
SELECT o.* FROM outbox_event o
WHERE NOT EXISTS (SELECT 1 FROM processed_event p WHERE p.consumer = ? AND p.outbox_id = o.outbox_id)
ORDER BY o.created_at, o.outbox_id;

markProcessed:
INSERT INTO processed_event(consumer, outbox_id, processed_at) VALUES (?, ?, ?);

-- Meta, migrations, warnings and the sidecar.
setMeta:
INSERT OR REPLACE INTO app_meta(key, value) VALUES (?, ?);

meta:
SELECT value FROM app_meta WHERE key = ?;

insertMigration:
INSERT INTO migration_history(migration_id, kind, source_checksum, status, completed_at, summary_json) VALUES (?, ?, ?, 'complete', ?, ?);

migrationById:
SELECT * FROM migration_history WHERE migration_id = ?;

migrations:
SELECT * FROM migration_history ORDER BY completed_at, migration_id;

insertWarning:
INSERT INTO import_warning(migration_id, code, detail) VALUES (?, ?, ?);

warningsOf:
SELECT code, detail FROM import_warning WHERE migration_id = ? ORDER BY warning_id;

insertSidecar:
INSERT INTO legacy_sidecar(source, path, json) VALUES (?, ?, ?);

sidecarOf:
SELECT path, json FROM legacy_sidecar WHERE source = ? ORDER BY path;

sidecarJson:
SELECT json FROM legacy_sidecar WHERE source = ? AND path = ?;

-- The live documents.
liveRead:
SELECT json FROM live_document WHERE name = ?;

liveWrite:
INSERT OR REPLACE INTO live_document(name, json, updated_at) VALUES (?, ?, ?);

liveNames:
SELECT name FROM live_document ORDER BY name;

liveDelete:
DELETE FROM live_document WHERE name = ?;

-- Held reminders.
holdPut:
INSERT OR REPLACE INTO reminder_hold(id, module, source_ref, kind, occurrence, at_millis, reason, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

holdAll:
SELECT * FROM reminder_hold ORDER BY at_millis, id;

holdDelete:
DELETE FROM reminder_hold WHERE id = ?;

holdDeleteBefore:
DELETE FROM reminder_hold WHERE at_millis < ?;

-- HOME's own records (version 9, REP-014): the Home save kept in tables from the start, one family per kind of private record (area, chore, chore entry,
-- supply, stock adjustment, restocking entry, asset, maintenance schedule, maintenance record, warranty, reference note) so each can be read, exported or erased
-- on its own. Same shape as HEAL's (key, position, day, and the record as JSON in `json`). `home_state` holds the settings and any field a newer build adds.
-- HOME never has a row in `live_document`: it is created in the tables. Nothing is sealed (that is MINT's alone).
CREATE TABLE home_area (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE home_chore (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE home_entry (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE home_supply (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE home_adjustment (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE home_restock (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE home_asset (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE home_schedule (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE home_maintenance (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE home_warranty (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE home_reference (
    key TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    day TEXT,
    json TEXT NOT NULL
);

CREATE TABLE home_state (
    key TEXT NOT NULL PRIMARY KEY,
    json TEXT NOT NULL
);
