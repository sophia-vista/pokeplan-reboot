insertPokemon:
INSERT INTO owned_pokemon(
    id, species_id, form_identifier, nickname, nature, ability, gender,
    iv_hp, iv_attack, iv_defense, iv_sp_attack, iv_sp_defense, iv_speed,
    ev_hp, ev_attack, ev_defense, ev_sp_attack, ev_sp_defense, ev_speed,
    level, candy_progress, total_candies, friendship, is_shiny, held_item, tera_type, cosmetic_form,
    personality, caught_at_millis, is_favorite, origin_how, origin_region, extra_json, position, origin_json
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

pokemonById:
SELECT * FROM owned_pokemon WHERE id = ?;

allPokemon:
SELECT * FROM owned_pokemon ORDER BY position, caught_at_millis, id;

pokemonCount:
SELECT count(*) FROM owned_pokemon;

nextPokemonPosition:
SELECT coalesce(max(position), 0) + 1 FROM owned_pokemon;

updatePokemon:
UPDATE owned_pokemon SET
    species_id = ?, form_identifier = ?, nickname = ?, nature = ?, ability = ?, gender = ?,
    iv_hp = ?, iv_attack = ?, iv_defense = ?, iv_sp_attack = ?, iv_sp_defense = ?, iv_speed = ?,
    ev_hp = ?, ev_attack = ?, ev_defense = ?, ev_sp_attack = ?, ev_sp_defense = ?, ev_speed = ?,
    level = ?, candy_progress = ?, total_candies = ?, friendship = ?, is_shiny = ?, held_item = ?, tera_type = ?, cosmetic_form = ?,
    personality = ?, caught_at_millis = ?, is_favorite = ?, origin_how = ?, origin_region = ?, extra_json = ?, position = ?, origin_json = ?
WHERE id = ?;

releasePokemon:
DELETE FROM owned_pokemon WHERE id = ?;

placeOf:
SELECT kind, ref, slot FROM pokemon_place WHERE owned_id = ?;

allPlaces:
SELECT owned_id, kind, ref, slot FROM pokemon_place ORDER BY kind, ref, slot;

removePlace:
DELETE FROM pokemon_place WHERE owned_id = ?;

insertPlace:
INSERT INTO pokemon_place(owned_id, kind, ref, slot) VALUES (?, ?, ?, ?);

clearPlaces:
DELETE FROM pokemon_place WHERE kind = ? AND ref = ?;

partyOf:
SELECT slot, owned_id FROM pokemon_place WHERE kind = 'party' AND ref = ? ORDER BY slot;

partySlotCount:
SELECT count(*) FROM pokemon_place WHERE kind = 'party';

buddy:
SELECT owned_id FROM pokemon_place WHERE kind = 'buddy';

guardians:
SELECT slot, owned_id FROM pokemon_place WHERE kind = 'guardian' ORDER BY slot;

placeCount:
SELECT count(*) FROM pokemon_place;

moveSlot:
UPDATE pokemon_place SET slot = ? WHERE owned_id = ?;

addDex:
INSERT OR IGNORE INTO dex_history(kind, ref) VALUES (?, ?);

dexOf:
SELECT ref FROM dex_history WHERE kind = ? ORDER BY ref;

setProgress:
INSERT OR REPLACE INTO player_progress(id, egg_meter, trainer_points) VALUES (1, ?, ?);

progress:
SELECT egg_meter, trainer_points FROM player_progress WHERE id = 1;

ensureBalance:
INSERT OR IGNORE INTO currency_balance(currency, amount) VALUES ('poke', 0);

pokeBalance:
SELECT amount FROM currency_balance WHERE currency = 'poke';

addPoke:
UPDATE currency_balance SET amount = amount + ? WHERE currency = 'poke';

bagQuantity:
SELECT quantity FROM bag_stack WHERE item_id = ?;

ensureStack:
INSERT OR IGNORE INTO bag_stack(item_id, quantity) VALUES (?, 0);

addToBag:
UPDATE bag_stack SET quantity = quantity + ? WHERE item_id = ?;

dropEmptyStacks:
DELETE FROM bag_stack WHERE quantity = 0;

bag:
SELECT item_id, quantity FROM bag_stack ORDER BY item_id;

eventById:
SELECT * FROM reward_event WHERE event_id = ?;

insertEvent:
INSERT INTO reward_event(event_id, source_module, source_record_id, event_kind, policy_version, settled_at, metadata_json)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertLedgerEntry:
INSERT INTO reward_ledger_entry(event_id, asset, delta, reverses_entry_id) VALUES (?, ?, ?, ?);

lastInsertedRow:
SELECT last_insert_rowid();

ledgerOfEvent:
SELECT * FROM reward_ledger_entry WHERE event_id = ? ORDER BY entry_id;

ledgerReversalOf:
SELECT entry_id FROM reward_ledger_entry WHERE reverses_entry_id = ?;

ledgerTotals:
SELECT asset, sum(delta) AS total FROM reward_ledger_entry GROUP BY asset ORDER BY asset;

ledgerCount:
SELECT count(*) FROM reward_ledger_entry;

eventCount:
SELECT count(*) FROM reward_event;

insertOutbox:
INSERT INTO outbox_event(outbox_id, event_kind, contract_version, payload_json, created_at) VALUES (?, ?, ?, ?, ?);

pendingOutbox:
SELECT o.* FROM outbox_event o
WHERE NOT EXISTS (SELECT 1 FROM processed_event p WHERE p.consumer = ? AND p.outbox_id = o.outbox_id)
ORDER BY o.created_at, o.outbox_id;

markProcessed:
INSERT INTO processed_event(consumer, outbox_id, processed_at) VALUES (?, ?, ?);

setMeta:
INSERT OR REPLACE INTO app_meta(key, value) VALUES (?, ?);

meta:
SELECT value FROM app_meta WHERE key = ?;

insertMigration:
INSERT INTO migration_history(migration_id, kind, source_checksum, status, completed_at, summary_json) VALUES (?, ?, ?, 'complete', ?, ?);

migrationById:
SELECT * FROM migration_history WHERE migration_id = ?;

migrations:
SELECT * FROM migration_history ORDER BY completed_at, migration_id;

insertWarning:
INSERT INTO import_warning(migration_id, code, detail) VALUES (?, ?, ?);

warningsOf:
SELECT code, detail FROM import_warning WHERE migration_id = ? ORDER BY warning_id;

insertSidecar:
INSERT INTO legacy_sidecar(source, path, json) VALUES (?, ?, ?);

sidecarOf:
SELECT path, json FROM legacy_sidecar WHERE source = ? ORDER BY path;

sidecarJson:
SELECT json FROM legacy_sidecar WHERE source = ? AND path = ?;

liveRead:
SELECT json FROM live_document WHERE name = ?;

liveWrite:
INSERT OR REPLACE INTO live_document(name, json, updated_at) VALUES (?, ?, ?);

liveNames:
SELECT name FROM live_document ORDER BY name;

liveDelete:
DELETE FROM live_document WHERE name = ?;

liveDeleteAside:
DELETE FROM live_document WHERE name LIKE 'aside:%';

holdPut:
INSERT OR REPLACE INTO reminder_hold(id, module, source_ref, kind, occurrence, at_millis, reason, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

holdAll:
SELECT * FROM reminder_hold ORDER BY at_millis, id;

holdDelete:
DELETE FROM reminder_hold WHERE id = ?;

holdDeleteBefore:
DELETE FROM reminder_hold WHERE at_millis < ?;

holdDeleteAll:
DELETE FROM reminder_hold;

