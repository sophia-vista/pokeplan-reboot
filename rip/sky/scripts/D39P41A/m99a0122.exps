
def 0 {
    back_SetGround(LEVEL_D39P41A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_IN_THE_DEPTHS_OF_THE_PIT, 0, 256);
    Wait(30);
    message_SetFace(ACTOR_NPC_PARUKIA, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english="""
             ...[K]I...[K]I HAVE BEEN DEFEATED...[K]
            GRRR-OOOOOO!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Wait(60);
    message_Mail({
        english="[CN][CS:N]Palkia[CR] wants to join the team.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    @label_5;
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    switch ( ProcessSpecial(PROCESS_SPECIAL_PREPARE_MENU_ACCEPT_TEAM_MEMBER, 8, 0) ) { }
    switch ( message_Menu(MENU_ACCEPT_TEAM_MEMBER) ) {
        case 1:
        default:
            @label_0;
            message_SetFace(ACTOR_NPC_NEW_FRIEND, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
            message_Talk({
                english=" ...[K]YOU DEFEATED ME.",
            });
            message_Talk({
                english="""
                     IT IS NOT THE STRONG
                    THAT WIN.[K] THOSE THAT WIN ARE STRONG.
                """,
            });
            message_Talk({
                english="""
                     AND YOUR STRENGTH...[K]
                    I SUBMIT TO IT.
                """,
            });
            message_Talk({
                english="""
                     FROM NOW ON, I TOO WILL
                    WALK...[K]TOGETHER WITH YOU!
                """,
            });
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            bgm_Stop();
            me_Play(5);
            message_Mail({
                english="[CN][c_name:NPC_NEW_FRIEND] joined the team!",
            });
            WaitMe(5);
            message_Close();
            bgm_FadeOut(120);
            screen_FadeOut(1, 60);
            WaitBgm(BGM_IN_THE_DEPTHS_OF_THE_PIT);
            @label_2;
            message_Explanation({
                english="""
                    [CN][player] cleared [CS:P]Spacial Rift[CR]
                    [CN]in admirable fashion!
                """,
            });
            message_Close();
            end;
        case 2:
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_Mail({
                english="""
                    [CN]Are you sure?[K]
                    [CN]You're sure you won't accept
                    [CN]this potential new member?
                """,
            });
            switch ( message_SwitchMenu(0, 1) ) {
                case menu({
                    english="Reconsider",
                }):
                default:
                    jump @label_5;
                case menu({
                    english="Refuse",
                }):
                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                    message_Mail({
                        english="""
                            [CN][player] turned down
                            [CN]the Pokémon's offer to join.
                        """,
                    });
                    message_Mail({
                        english="""
                            [CN][CS:N]Palkia[CR] appears to be
                            [CN]a little disappointed...
                        """,
                    });
                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                    bgm_FadeOut(60);
                    se_Play(8200);
                    SetAnimation<actor ACTOR_NPC_PARUKIA>(25);
                    WaitAnimation<actor ACTOR_NPC_PARUKIA>();
                    supervision_Acting(1);
                    SetOutputAttribute<object OBJECT_H02P99C5_120>(1);
                    SetAnimation<object OBJECT_H02P99C5_120>(17);
                    WaitAnimation<object OBJECT_H02P99C5_120>();
                    WaitExecuteLives(ACTOR_NPC_PARUKIA);
                    Destroy<actor ACTOR_NPC_PARUKIA>();
                    WaitExecuteObject(OBJECT_H02P99C5_120);
                    SetAnimation<object OBJECT_H02P99C5_120>(20);
                    Wait(10);
                    SetAnimation<object OBJECT_H02P99C5_120>(22);
                    WaitAnimation<object OBJECT_H02P99C5_120>();
                    WaitExecuteObject(OBJECT_H02P99C5_120);
                    Destroy<object OBJECT_H02P99C5_120>();
                    WaitSe(8200);
                    message_Mail({
                        english="[CN][CS:N]Palkia[CR] sadly went away...",
                    });
                    message_Close();
                    screen_FadeOut(1, 60);
                    WaitBgm(BGM_IN_THE_DEPTHS_OF_THE_PIT);
                    jump @label_2;
            }
            break;
    }
}
