
def 0 {
    switch ( $GROUND_ENTER ) {
        case 249:
            @label_0;
            $SIDE02_TALK[0] = 1;
            ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
            ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
            message_SetFace(ACTOR_NPC_UPAA, FACE_HAPPY, FACE_POS_STANDARD);
            message_Talk({
                english=" Yay! Gummis!",
            });
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SetFace(ACTOR_PLAYER_PUPURIN, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
            message_Talk({
                english=" How are they?",
            });
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            ExecuteCommon<actor ACTOR_NPC_UPAA>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
            WaitExecuteLives(ACTOR_NPC_UPAA);
            message_SetFace(ACTOR_NPC_UPAA, FACE_HAPPY, FACE_POS_STANDARD);
            message_Talk({
                english=" Great! Delicious![K] Thank you! ♪",
            });
            message_Close();
            if ( $SIDE02_TALK[1] ) {
                if ( $SIDE02_TALK[2] ) {
                    message_Close();
                    bgm_FadeOut(60);
                    screen2_FadeOut(0, 60);
                    screen_FadeOut(1, 60);
                    supervision_ExecuteCommon(CORO_EVENT_N02_03);
                    hold;
                } else {
                    @label_1;
                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                    JumpCommon(CORO_END_TALK);
                }
            } else {
                jump @label_1;
            }
            break;
        default:
            jump @label_1;
    }
}
