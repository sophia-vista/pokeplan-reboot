
def 0 {
    switch ( $GROUND_ENTER ) {
        case 249:
            @label_0;
            $SIDE02_TALK[1] = 1;
            ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
            ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
            message_SetFace(ACTOR_NPC_MUCHUURU, FACE_HAPPY, FACE_POS_STANDARD);
            message_Talk({
                english=" Yay! I love Gummis! ♪",
            });
            message_Talk({
                english="""
                     Thanks, [CS:Y]Igglybuff[CR]! ♪[K]
                    Smooches! ♪
                """,
            });
            if ( $SIDE02_TALK[0] ) {
                if ( $SIDE02_TALK[2] ) {
                    message_Close();
                    bgm_FadeOut(60);
                    screen2_FadeOut(0, 60);
                    screen_FadeOut(1, 60);
                    supervision_ExecuteCommon(CORO_EVENT_N02_03);
                    hold;
                } else {
                    @label_1;
                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                    JumpCommon(CORO_END_TALK);
                }
            } else {
                jump @label_1;
            }
            break;
        default:
            jump @label_1;
    }
}
