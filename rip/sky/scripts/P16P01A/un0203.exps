
def 0 {
    switch ( $GROUND_ENTER ) {
        case 249:
            @label_0;
            $SIDE02_TALK[2] = 1;
            ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
            ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
            message_SetFace(ACTOR_NPC_SUBOMII, FACE_NORMAL, FACE_POS_STANDARD);
            message_Talk({
                english="""
                     Chew-chew...[K] Gummis
                    are tasty! ♪
                """,
            });
            message_SetFace(ACTOR_NPC_SUBOMII, FACE_HAPPY, FACE_POS_STANDARD);
            message_Talk({
                english=" You're the best, [CS:Y]Igglybuff[CR]! ♪",
            });
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SetFace(ACTOR_PLAYER_PUPURIN, FACE_HAPPY, FACE_POS_BOTTOM_R_FACEINW);
            message_Talk({
                english="""
                     Hee-hee, I'm happy too...[K]
                    friendly friend. ♪
                """,
            });
            message_Close();
            if ( $SIDE02_TALK[0] ) {
                if ( $SIDE02_TALK[1] ) {
                    message_Close();
                    bgm_FadeOut(60);
                    screen2_FadeOut(0, 60);
                    screen_FadeOut(1, 60);
                    supervision_ExecuteCommon(CORO_EVENT_N02_03);
                    hold;
                } else {
                    @label_1;
                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                    JumpCommon(CORO_END_TALK);
                }
            } else {
                jump @label_1;
            }
            break;
        default:
            jump @label_1;
    }
}
