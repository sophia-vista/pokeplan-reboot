
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_D13P11A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_NORTHERN_DESERT, 0, 256);
    MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m0', 31, 33.5>);
    MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m1', 27, 33.5>);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Wait(30);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Let's find that Time Gear
                    this time!
                """,
            }
        case 2:
            {
                english="""
                     Let's find the Time Gear
                    this time!
                """,
            }
        default:
            {
                english="""
                     Let's find that Time Gear
                    this time!
                """,
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Let's give it our best,
                    [hero]!
                """,
            }
        case 2:
            {
                english=" Let's do our best, [hero]!",
            }
        default:
            {
                english=" Let's try our best, [hero]!",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetAnimation<actor ACTOR_PLAYER>(71);
    SetAnimation<actor ACTOR_ATTENDANT1>(71);
    WaitAnimation<actor ACTOR_PLAYER>();
    WaitAnimation<actor ACTOR_ATTENDANT1>();
    SetAnimation<actor ACTOR_PLAYER>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    Wait(30);
    MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m2', 28.5, 20.5>);
    Wait(20);
    MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m3', 28.5, 20.5>);
    Wait(20);
    screen_FadeOut(1, 30);
    main_EnterDungeon(20, 0);
    switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
    main_EnterDungeon(-1, 0);
    hold;
    end;
}
