                                                english=" Bottom Left Center",
                                            });
                                            message_SetFacePosition(FACE_POS_BOTTOM_R_CENTER);
                                            message_Talk({
                                                english=" Bottom Right Center",
                                            });
                                            message_SetFacePosition(FACE_POS_BOTTOM_C_FACEL);
                                            message_Talk({
                                                english=" Bottom Center Left-Facing",
                                            });
                                            message_SetFacePosition(FACE_POS_BOTTOM_L_FACEOUTW);
                                            message_Talk({
                                                english=" Bottom Left Outer-Facing",
                                            });
                                            message_SetFacePosition(FACE_POS_BOTTOM_R_FACEOUTW);
                                            message_Talk({
                                                english=" Bottom Right Outer-Facing",
                                            });
                                            message_SetFacePosition(FACE_POS_BOTTOM_LC_FACEOUTW);
                                            message_Talk({
                                                english=" Bottom Left-Center Outer-Facing",
                                            });
                                            message_SetFacePosition(FACE_POS_BOTTOM_RC_FACEOUTW);
                                            message_Talk({
                                                english=" Bottom Right-Center Outer-Facing",
                                            });
                                            jump @label_43;
                                        case menu({
                                            english="Top",
                                        }):
                                            message_SetFacePosition(FACE_POS_TOP_C_FACER);
                                            message_Talk({
                                                english=" Top Center (Right-Facing)",
                                            });
                                            message_SetFacePosition(FACE_POS_TOP_L_FACEINW);
                                            message_Talk({
                                                english=" Top Left Inner-Facing",
                                            });
                                            message_SetFacePosition(FACE_POS_TOP_R_FACEINW);
                                            message_Talk({
                                                english=" Top Right Inner-Facing",
                                            });
                                            message_SetFacePosition(FACE_POS_TOP_L_CENTER);
                                            message_Talk({
                                                english=" Top Left Center",
                                            });
                                            message_SetFacePosition(FACE_POS_TOP_R_CENTER);
                                            message_Talk({
                                                english=" Top Right Center",
                                            });
                                            message_SetFacePosition(FACE_POS_TOP_C_FACEL);
                                            message_Talk({
                                                english=" Top Center (Left-Facing)",
                                            });
                                            message_SetFacePosition(FACE_POS_TOP_L_FACEOUTW);
                                            message_Talk({
                                                english=" Top Left-Center Right-Facing",
                                            });
                                            message_SetFacePosition(FACE_POS_TOP_RC_FACER);
                                            message_Talk({
                                                english=" Top Right-Center Right-Facing",
                                            });
                                            message_SetFacePosition(FACE_POS_TOP_LC_FACEOUTW);
                                            message_Talk({
                                                english=" Top Left-Center Outer-Facing",
                                            });
                                            message_SetFacePosition(FACE_POS_TOP_RC_FACEOUTW);
                                            message_Talk({
                                                english=" Top Right-Center Outer-Facing",
                                            });
                                            jump @label_43;
                                        case menu({
                                            english="Cancel",
                                        }):
                                            jump @label_23;
                                        default:
                                            jump @label_15;
                                    }
                                    break;
                                case menu({
                                    english="FacePositionOffset",
                                }):
                                    message_SetFace(ACTOR_NPC_ZUBATTO, FACE_NORMAL, FACE_POS_STANDARD);
                                    message_Talk({
                                        english=" Set the Portrait Window.",
                                    });
                                    message_FacePositionOffset(10, 0);
                                    message_Talk({
                                        english="""
                                             The Portrait was moved
                                            (X: 10). Moving it on the Y-axis will make it
                                            cover the Message Window.
                                        """,
                                    });
                                    message_FacePositionOffset(0, 0);
                                    message_Talk({
                                        english=" The Portrait was moved back.",
                                    });
                                    message_SetFace(ACTOR_NPC_ZUBATTO, FACE_NORMAL, FACE_POS_ABSCOORD);
                                    message_Talk({
                                        english="""
                                             Right-Facing and on the corner
                                            is the default position.
                                        """,
                                    });
                                    message_FacePositionOffset(20, 10);
                                    message_Talk({
                                        english="""
                                             Moved the Portrait.
                                            (X: 20, Y: 10)
                                        """,
                                    });
                                    message_FacePositionOffset(0, 0);
                                    message_Talk({
                                        english="""
                                             The Portrait was returned to
                                            the corner.
                                        """,
                                    });
                                    message_SetFace(ACTOR_NPC_ZUBATTO, FACE_NORMAL, FACE_POS_STANDARD);
                                    jump @label_23;
                                case menu({
                                    english="Cancel",
                                }):
                                    jump @label_10;
                                default:
                                    jump @label_15;
                            }
                            break;
                        default:
                            jump @label_7;
                    }
                    break;
                case menu({
                    english="Message Output",
                }):
                    @label_16;
                    message_Notice({
                        english="""
                             This is Message Output.
                            What do you want to do? Choose.
                            [CS:E]B Button Cancel: Go back one menu step[CR]
                        """,
                    });
                    switch ( message_SwitchMenu(1, 1) ) {
                        case menu({
                            english="Notice",
                        }):
                            message_Notice({
                                english="""
                                     Text is displayed all at once.
                                    There is no Portrait Window.
                                """,
                            });
                            jump @label_16;
                        case menu({
                            english="Monologue",
                        }):
                            message_Monologue({
                                english=" It's like this.",
                            });
                            message_Talk({
                                english="""
                                     You don't get the talking
                                    sound effect.
                                """,
                            });
                            jump @label_16;
                        case menu({
                            english="Talk",
                        }):
                            message_Talk({
                                english=" It's like this.",
                            });
                            jump @label_16;
                        case menu({
                            english="Mail",
                        }):
                            message_Mail({
                                english="""
                                     It's like this. You don't get a
                                    Portrait Window.
                                """,
                            });
                            jump @label_16;
                        case menu({
                            english="ImitationSound",
                        }):
                            message_ImitationSound({
                                english="Kabooooooom!",
                            });
                            Wait(20);
                            message_Notice({
                                english="""
                                     You can use that for
                                    indicating sounds.
                                """,
                            });
                            message_Notice({
                                english="""
                                     Incidentally, it shouldn't be
                                    set to wait for the A Button, but it is.
                                """,
                            });
                            message_SetFace(ACTOR_NPC_ZUBATTO, FACE_NORMAL, FACE_POS_STANDARD);
                            message_ImitationSound({
                                english="""
                                     The Portrait Window should be
                                    displayed, but it doesn't appear to be set.
                                """,
                            });
                            jump @label_16;
                        case menu({
                            english="Cancel",
                        }):
                            jump @label_10;
                        default:
                            jump @label_7;
                    }
                    break;
                case menu({
                    english="Choice Message",
                }):
                    message_Notice({
                        english="""
                             The speech will change depending
                            on the hero and partner characters.
                        """,
                    });
                    message_SetFace(ACTOR_PLAYER, FACE_NORMAL, FACE_POS_STANDARD);
                    message_SwitchMonologue ($HERO_TALK_KIND) {
                        case 4:
                            {
                                english="(I'm disappointed but I'm a boy.)",
                            }
                        default:
                            {
                                english="(I'm a girl...)",
                            }
                    }
                    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
                    message_SwitchTalk ($PARTNER_TALK_KIND) {
                        case 1:
                            {
                                english="""
                                     I'm a Type 1 [partner].[K]
                                    Nice to meet you!
                                """,
                            }
                        case 2:
                            {
                                english="""
                                     I'm a Type 2 [partner].[K]
                                    Nice to meet you!
                                """,
                            }
                        default:
                            {
                                english="""
                                     I'm a Type 3 [partner].[K]
                                    Nice to meet you!
                                """,
                            }
                    }
                    jump @label_7;
                case menu({
                    english="Multiple-Choice Tag",
                }):
                    message_Notice({
                        english="To be added",
                    });
                    jump @label_7;
                case menu({
                    english="Cancel",
                }):
                    jump @label_10;
                default:
                    jump @label_11;
            }
            break;
        case menu({
            english="Message Color",
        }):
            message_Notice({
                english="""
                     [CS:T]Transparent[CR]
                    [CS:D]Standard Color[CR]
                    [CS:E]Bold Text[CR]
                """,
            });
            message_Notice({
                english="""
                     [CS:C]Caution[CR]
                    [CS:W]Warning[CR]
                    [CS:F]Team Pokémon Name[CR]
                """,
            });
            message_Notice({
                english="""
                     [CS:N]Pokémon Name[CR]
                    [CS:K]Poké Species Name[CR]
                    [CS:M]Move Name[CR]
                """,
            });
            message_Notice({
                english="""
                     [CS:P]Place Name[CR]
                    [CS:I]Item Name[CR]
                    [CS:V]Number[CR]
                """,
            });
            message_Notice({
                english="""
                     [CS:B]Forbidden Choice[CR]
                    [CS:S]Multiple Items Selected[CR]
                    [CS:A]Identified Item[CR]
                """,
            });
            message_Notice({
                english="""
                     [CS:U]Unidentified Item[CR]
                    [CS:G]Money[CR]
                    [CS:R]Selling Price[CR]
                """,
            });
            message_Close();
            jump @label_10;
        case menu({
            english="Cancel",
        }):
            message_Notice({
                english=" All right.",
            });
            jump @label_10;
        default:
            message_Talk({
                english="""
                     Oh, you canceled? Leaving me
                    lonesome again...
                """,
            });
            jump @label_10;
    }
}
