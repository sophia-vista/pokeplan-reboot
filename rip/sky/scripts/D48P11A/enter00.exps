
def 0 {
    debug_Print('START');
    switch ( sector() ) {
        case 1:
            @label_0;
            supervision_StationCommon(0);
            switch ( sector() ) {
                case 1:
                    @label_1;
                    debug_Print('LABEL_END');
                    JumpCommon(CORO_COMMON_ENTER);
                default:
                    debug_Print('LABEL_PLAYER_SET');
                    debug_Print('LABEL_PLAYER_SET_RESUME');
                    if ( $SCENARIO_MAIN_BIT_FLAG[7] ) {
                        debug_Print('LABEL_JUPUTORU_RESUME');
                        $SCENARIO_MAIN_BIT_FLAG[7] = 0;
                        supervision_StationCommon(52);
                        @label_4;
                        debug_Print('SET_BGM');
                        bgm_PlayFadeIn(BGM_TEMPORAL_TOWER, 0, 256);
                        debug_Print('LABEL_ENTER_END');
                        jump @label_1;
                    } else {
                        @label_3;
                        debug_Print('LABEL_JUPUTORU_SET_NORMAL');
                        supervision_StationCommon(51);
                        jump @label_4;
                    }
                    break;
            }
            break;
        default:
            screen_FadeOutAll(1, 0);
            debug_Print('LABEL_BACK_SET');
            back_SetGround(LEVEL_D48P11A);
            jump @label_0;
    }
}

def 1 for actor ACTOR_PLAYER_FUTURE {
    SetAnimation(2);
    WaitScreenFade();
    WaitScreenFadeAll();
    end;
}
