
def 0 {
    if ( scn($SCENARIO_SIDE) >= [43, 2] ) {
    }
    @label_2;
    ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
    ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
    message_SetFace(ACTOR_NPC_PONIITA, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Our leader is always nervous
            around fire.[K] But that's a small thing compared
            to all the positives!
        """,
    });
    message_Talk({
        english="""
             So I'm happy to support our
            leader through thick or thin.
        """,
    });
    message_Close();
    @label_1;
    JumpCommon(CORO_END_TALK);
}
