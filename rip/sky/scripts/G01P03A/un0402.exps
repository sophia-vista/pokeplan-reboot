
def 0 {
    if ( scn($SCENARIO_SIDE) >= [43, 2] ) {
        @label_0;
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        message_SetFace(ACTOR_NPC_CHIRIIN, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 Oh! [CS:Y]Sunflora[CR]![K]
                How are you?
            """,
        });
        message_Talk({
            english="""
                 I just started running the
                Assembly, so there's still a lot I don't know...
            """,
        });
        message_Talk({
            english="""
                 But it's just so fun and
                rewarding!
            """,
        });
        message_Talk({
            english=" Let's both do our best!",
        });
        message_Close();
        @label_2;
        JumpCommon(CORO_END_TALK);
    } elseif ( $SCENARIO_TALK_BIT_FLAG[133] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        message_SetFace(ACTOR_NPC_CHIRIIN, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english=" Let's both do our best!",
        });
        message_Close();
        jump @label_2;
    } else {
        $SCENARIO_TALK_BIT_FLAG[133] = 1;
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        message_SetFace(ACTOR_NPC_CHIRIIN, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english=" Oh! [CS:Y]Sunflora[CR]!",
        });
        message_Talk({
            english="""
                 So, [CS:N]Chatot[CR] called you to the
                Guildmaster's Chamber earlier...
            """,
        });
        message_Talk({
            english=" Something happening?",
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        message_SetFace(ACTOR_PLAYER_KIMAWARI, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
        message_Talk({
            english="""
                 Yeah. [K]Truth is, Officer
                [CS:N]Magnezone[CR] has come here to discuss a job...
            """,
        });
        message_Talk({
            english="""
                 It seems like they want to
                entrust me with the job, so the Guildmaster
                has asked me to do it.
            """,
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        message_SetFace(ACTOR_NPC_CHIRIIN, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 Wow![K] Does that mean that
                you've been selected as guild representative?
            """,
        });
        message_Talk({
            english=" [CS:Y]Sunflora[CR]![K] Good luck!",
        });
        message_Talk({
            english="""
                 That reminds me, starting
                today...
            """,
        });
        message_Talk({
            english="""
                 I've been assigned to a new job
                around the guild!
            """,
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        se_Play(8978);
        SetEffect<actor ACTOR_PLAYER_KIMAWARI>(EFFECT_EXCLAMATION_MARK, 3);
        WaitEffect<actor ACTOR_PLAYER_KIMAWARI>();
        WaitExecuteLives(ACTOR_PLAYER_KIMAWARI);
        message_SetFace(ACTOR_PLAYER_KIMAWARI, FACE_HAPPY, FACE_POS_BOTTOM_R_FACEINW);
        message_Talk({
            english=" Really? [K]That's wonderful!",
        });
        message_Talk({
            english=" Congratulations, [CS:N]Chimecho[CR]!",
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        message_SetFace(ACTOR_NPC_CHIRIIN, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english=" Yeah! [K]Let's both work hard!",
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        message_SetFace(ACTOR_PLAYER_KIMAWARI, FACE_HAPPY, FACE_POS_BOTTOM_R_FACEINW);
        message_Talk({
            english=" Yeah!",
        });
        message_Close();
        jump @label_2;
    }
}
