
def 0 {
    if ( scn($SCENARIO_SIDE) >= [40, 7] || scn($SCENARIO_SIDE) >= [40, 3] || scn($SCENARIO_SIDE) >= [40, 2] ) {
        @label_3;
        JumpCommon(CORO_END_TALK);
    } else {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        message_SetFace(ACTOR_NPC_TANEBOO, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english=" We're Team [CS:X]Seedgey[CR]!",
        });
        message_Talk({
            english="""
                 We're [CS:N]Seedot[CR] and [CS:N]Pidgey[CR].[K]
                Our team name, [CS:X]Seedgey[CR], combines our names!
            """,
        });
        message_Talk({
            english=" So remember it!",
        });
        message_Close();
        jump @label_3;
    }
}
