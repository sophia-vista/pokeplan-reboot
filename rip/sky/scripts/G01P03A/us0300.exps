def 1 for actor ACTOR_NPC_HEIGANI {
    switch ( sector() ) {
        case 17:
            SetMoveRange(Position<'m0', 46, 29>, 12, 7);
            JumpCommon(CORO_MOVE_TYPE1);
        case 18:
            SetMoveRange(Position<'m1', 46, 29>, 12, 7);
            JumpCommon(CORO_MOVE_TYPE1);
        default:
            JumpCommon(CORO_LIVES_MOVE_NORMAL);
    }
}

