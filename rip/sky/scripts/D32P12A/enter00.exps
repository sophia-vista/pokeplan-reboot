
def 0 {
    switch ( sector() ) {
        case 1:
            @label_0;
            supervision_StationCommon(0);
            switch ( sector() ) {
                case 1:
                    end;
                default:
                    if ( scn($SCENARIO_MAIN) >= [29, 67] ) {
                        @label_2;
                        supervision_StationCommon(1);
                        @label_4;
                        debug_Print('SET_BGM');
                        bgm_PlayFadeIn(BGM_IN_THE_DEPTHS_OF_THE_PIT, 0, 256);
                        JumpCommon(CORO_COMMON_ENTER);
                    } elseif ( $SCENARIO_MAIN_BIT_FLAG[44] ) {
                        supervision_StationCommon(2);
                        jump @label_4;
                    } else {
                        jump @label_2;
                    }
                    break;
            }
            break;
        default:
            screen_FadeOutAll(1, 0);
            back_SetGround(LEVEL_D32P12A);
            jump @label_0;
    }
}

def 1 for actor ACTOR_PLAYER {
    SetAnimation(2);
    WaitScreenFade();
    WaitScreenFadeAll();
    end;
}

def 2 for actor ACTOR_ATTENDANT1 {
    SetAnimation(2);
    WaitScreenFade();
    WaitScreenFadeAll();
    end;
}
