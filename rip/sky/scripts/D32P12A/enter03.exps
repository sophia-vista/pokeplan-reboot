
def 0 {
    SetAnimation<actor ACTOR_PLAYER_APPOINT>(2);
    message_ResetActor();
    message_Mail({
        english="[CN]Would you like to go on?",
    });
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            message_Close();
            debug_Print('BGM_FADEOUT');
            bgm_FadeOut(60);
            screen_FadeOut(0, 30);
            switch ( ProcessSpecial(PROCESS_SPECIAL_IS_RECURITABLE_IN_TEAM, 0, 0) ) {
                case 1:
                    @label_2;
                    supervision_ExecuteCommon(CORO_EVENT_S04_23);
                    end;
                default:
                    supervision_ExecuteCommon(CORO_EVENT_S04_10);
                    jump @label_2;
            }
            break;
        case menu({
            english="No",
        }):
            message_Close();
            supervision_Suspend(-2);
            end;
    }
}
