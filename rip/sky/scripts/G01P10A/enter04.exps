
def 0 {
    SetAnimation<actor ACTOR_PLAYER>(2);
    SetAnimation<actor ACTOR_PLAYER_KIMAWARI>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    Turn2DirectionMark<actor ACTOR_PLAYER>(4, 10, Position<'m0', 26.5, 30>, 1, 1);
    Turn2DirectionMark<actor ACTOR_PLAYER_KIMAWARI>(4, 10, Position<'m1', 26.5, 30>, 1, 1);
    Turn2DirectionMark<actor ACTOR_ATTENDANT1>(4, 10, Position<'m2', 26.5, 30>, 1, 1);
    WaitExecuteLives(ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_PLAYER_KIMAWARI);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    SetAnimation<object OBJECT_G01P10A1_549>(18);
    WaitAnimation<object OBJECT_G01P10A1_549>();
    WaitExecuteObject(OBJECT_G01P10A1_549);
    SetAnimation<object OBJECT_G01P10A1_549>(19);
    message_ResetActor();
    message_Notice({
        english="[CN]Something is written here...",
    });
    @label_57;
    message_Notice({
        english="""
            [CN]This is [CS:N]Bidoof[CR]'s diary.
            [CN]Should we sneak a peek?
        """,
    });
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Read",
        }):
            @label_0;
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            switch ( $EXECUTE_SPECIAL_EPISODE_TYPE ) {
                case 2:
                    $EVENT_LOCAL = 4;
                    @label_55;
                    switch ( message_Menu(MENU_DIARY_BIDOOF_SP_E_P) ) {
                        case 4:
                            message_Mail({
                                english="""
                                    [CN][CS:N]Bidoof[CR]'s Yup Yup Journal
                                    [CN]Entry 4: Exploring with [CS:Y]Sunflora[CR]
                                    [CN]OO Month XX Day, Sunny
                                """,
                            });
                            message_Mail({
                                english="[CS:Y]Sunflora[CR] is some kind of awesome!",
                            });
                            message_Mail({
                                english="""
                                    Yup yup! I went exploring with [CS:Y]Sunflora[CR] the
                                    other day.
                                """,
                            });
                            message_Mail({
                                english="""
                                    It turns out [CS:Y]Sunflora[CR]'s a real expert at
                                    fighting in dungeons.
                                """,
                            });
                            message_Mail({
                                english="""
                                    When an enemy is just out of reach, she
                                    doesn't move toward it! Instead she uses [M:B2] to
                                    launch her regular attack, striking at nothing!
                                """,
                            });
                            message_Mail({
                                english="""
                                    Then the enemy usually spends that turn closing
                                    the distance on her. And then, on her next turn,
                                    she's the first one close enough to hit!
                                """,
                            });
                            message_Mail({
                                english="""
                                    Yup yup! She sure knows what she's doing,
                                    by golly!
                                """,
                            });
                            message_Mail({
                                english="""
                                    Why, I wanted to whoop and holler when I saw
                                    her use that trick. So thrilling![K] Sigh...
                                """,
                            });
                            message_Mail({
                                english="""
                                    As for me, I always rush into a fight...[K]
                                    That's why I end up being first to get hit!
                                """,
                            });
                            message_Mail({
                                english="""
                                    But it's all right, I reckon. I know the way to
                                    do it now and can explore better now. Yup yup!
                                """,
                            });
