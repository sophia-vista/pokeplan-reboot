                                """,
                            });
                            message_Mail({
                                english="""
                                    I get so frustrated being so klutzy and slow...
                                    Yup yup! Don't I know it!
                                """,
                            });
                            message_Mail({
                                english="""
                                    I'm a slow worker. And it takes me longer to
