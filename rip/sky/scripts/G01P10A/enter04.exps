                            message_Mail({
                                english="""
                                    [CN][CS:N]Bidoof[CR]'s Yup Yup Journal
                                    [CN]Entry 1: I'll Try Hard!
                                    [CN]OO Month XX Day, Sunny
                                """,
                            });
                            message_Mail({
                                english="""
                                    Oof...![K] Seems that it's been a mighty long time
