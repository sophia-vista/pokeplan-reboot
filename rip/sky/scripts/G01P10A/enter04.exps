                                jump @label_1;
                            case 11:
                                @label_17;
                                message_Mail({
                                    english="""
                                        [CN][CS:N]Bidoof[CR]'s Yup Yup Journal
                                        [CN]Entry 11: The Guild at Night
                                        [CN]OO Month XX Day, Sunny
                                    """,
                                });
                                message_Mail({
                                    english="""
                                        Thanks to [CS:N]Croagunk[CR], I haven't been able to
                                        get a good night's sleep lately.
                                    """,
                                });
                                message_Mail({
                                    english="""
                                        There's nothing to do if you're awake at night,
                                        so I took a stroll through the guild. Yup yup!
                                    """,
                                });
                                message_Mail({
                                    english="""
                                        I glanced in [partner] and [hero]'s
                                        room, but they were deep in sleep, by golly.
                                    """,
                                });
                                message_Mail({
                                    english="""
                                        I reckon they must be exhausted from their
                                        daily training, yup yup.
                                    """,
                                });
                                message_Mail({
                                    english="""
                                        I didn't peek into [CS:N]Chimecho[CR] and [CS:N]Sunflora[CR]'s
                                        room. That'd be downright rude. Yup yup.
                                    """,
                                });
                                message_Mail({
                                    english="Huh, diary? You wanted me to peek?",
