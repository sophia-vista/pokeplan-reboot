
def 0 {
    debug_Print('ENTER');
    switch ( sector() ) {
        case 1:
            @label_0;
            debug_Print('CHARA_SET');
            supervision_StationCommon(0);
            switch ( $EXECUTE_SPECIAL_EPISODE_TYPE ) {
                case 1:
                default:
                    break;
            }
            @label_2;
            switch ( sector() ) {
                case 1:
                    @label_3;
                    debug_Print('LABEL_END');
                    JumpCommon(CORO_COMMON_ENTER);
                default:
                    debug_Print('LABEL_PLAYE_SET');
                    debug_Print('LABEL_PLAYER_SET_RESUME');
                    if ( $SCENARIO_MAIN_BIT_FLAG[7] ) {
                        debug_Print('LABEL_PUPURIN_RESUME');
                        $SCENARIO_MAIN_BIT_FLAG[7] = 0;
                        supervision_StationCommon(32);
                        @label_6;
                        debug_Print('SET_BGM');
                        bgm_PlayFadeIn(BGM_FORTUNE_RAVINE_DEPTHS, 0, 256);
                        debug_Print('LABEL_ENTER_END');
                        jump @label_3;
                    } else {
                        @label_5;
                        debug_Print('LABEL_PUPURIN_SET_NORMAL');
                        supervision_StationCommon(31);
                        jump @label_6;
                    }
                    break;
            }
            break;
        default:
            screen_FadeOutAll(1, 0);
            debug_Print('LABEL_BACK_SET');
            back_SetGround(LEVEL_D45P21A);
            jump @label_0;
    }
}

def 1 for actor ACTOR_PLAYER_PUPURIN {
    SetAnimation(2);
    WaitScreenFade();
    WaitScreenFadeAll();
    end;
}
