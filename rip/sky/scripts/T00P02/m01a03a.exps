
def 0 {
    debug_Print('acting_M01A03A');
    message_ResetActor();
    message_Talk({
        english="A Special Movement Test will be conducted.",
    });
    message_Close();
    supervision_Acting(0);
    WaitExecuteLives(ACTOR_NPC_TEST010);
