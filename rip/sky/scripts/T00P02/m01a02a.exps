
def 0 {
    debug_Print('acting_M01A02A');
    message_ResetActor();
    message_Talk({
        english="An Acting Test will be conducted.",
    });
    message_Close();
    supervision_Acting(0);
    camera_SetPositionMark(Position<'m0', 43, 29.5>);
    WaitExecutePerformer(3);
    Wait(120);
    message_Talk({
        english="The Event Test is finished.",
    });
    message_Close();
    camera_SetDefault();
    supervision_Suspend(-2);
    supervision_RemoveActing(0);
    end;
}

def 1 for actor ACTOR_PLAYER {
    hold;
}

def 2 for actor ACTOR_ATTENDANT1 {
    hold;
}

def 3 for performer 3 {
    SetEffect(EFFECT_TRAPPED_BY_ELECTRIC_CAGE, 0);
    Wait(240);
    SetEffect(EFFECT_NONE, 0);
    Destroy();
}
