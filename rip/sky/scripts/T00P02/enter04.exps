
def 0 {
    message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="What can I help you with today?",
    });
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            message_Talk({
                english="Do you really need help with anything?",
            });
            switch ( message_SwitchMenu(0, 1) ) {
                case menu({
                    english="Yes",
                }):
                default:
                    message_Talk({
                        english="I can't help you with anything right now.",
                    });
                    @label_3;
                    debug_Print('END_TALK');
                    message_Close();
                    debug_Print('SUSPEND_START');
                    supervision_Suspend(-2);
                    debug_Print('SUSPEND_END');
                    end;
                case menu({
                    english="No",
                }):
                    @label_1;
                    message_Talk({
                        english="I see...",
                    });
                    jump @label_3;
            }
            break;
        case menu({
            english="No",
        }):
            jump @label_1;
    }
}

def 1 for actor ACTOR_TALK_MAIN {
    debug_Print('LIVES_REPLY_NORMAL_A');
    SetAnimation(2);
    TurnDirection(32767);
    debug_Print('LIVES_REPLY_NORMAL_A_HOLD');
    hold;
}

def 2 for actor ACTOR_TALK_SUB {
    debug_Print('LIVES_REPLY_NORMAL_B');
    SetAnimation(2);
    TurnDirection(32767);
    debug_Print('LIVES_REPLY_NORMAL_B_HOLD');
    hold;
}
