
def 0 {
    ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
    ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
    @label_6;
    message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
            An event will be activated.
            Which one would you like?
        """,
    });
    switch ( message_SwitchMenu(1, 1) ) {
        case menu({
            english="ACTING_TEST",
        }):
            @label_0;
            message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
            message_Talk({
                english="""
                    An Acting Test will be activated.
                    Which one would you like?
                """,
            });
            switch ( message_SwitchMenu(1, 1) ) {
                case menu({
                    english="M01A01A",
                }):
                    debug_Print('EXECUTE_T00P02_M01A01A');
                    message_Close();
                    supervision_ExecuteActing(LEVEL_T00P02, 'M01A01A', 0);
                    hold;
                case menu({
                    english="M01A02A",
                }):
                    debug_Print('EXECUTE_T00P02_M01A02A');
                    message_Close();
                    supervision_ExecuteActing(LEVEL_T00P02, 'M01A02A', 0);
                    hold;
                case menu({
                    english="M01A03A",
                }):
                    debug_Print('EXECUTE_T00P02_M01A03A');
                    message_Close();
                    supervision_ExecuteActing(LEVEL_T00P02, 'M01A03A', 0);
                    hold;
                default:
                    jump @label_6;
            }
            break;
        case menu({
            english="ITEM_TEST",
        }):
            message_Talk({
                english="""
                    An Item Usage Test will be activated.
                    Which one would you like?
                """,
            });
            switch ( message_SwitchMenu(1, 1) ) {
                case menu({
                    english="CHECK_ITEM_CARRY",
                }):
                    message_Close();
                    switch ( ProcessSpecial(PROCESS_SPECIAL_COUNT_ITEM_TYPE_IN_BAG, 121, 0) ) {
                        case 1:
                            @label_11;
                            message_Notice({
                                english="""
                                    
                                    [CN]You have 1 Blue Gummi.
                                """,
                            });
                            JumpCommon(CORO_END_TALK);
                        case >= 2:
                            @label_12;
                            message_Notice({
                                english="""
                                    
                                    [CN]You have 2 or more Blue Gummis.
                                """,
                            });
                            JumpCommon(CORO_END_TALK);
                        default:
                            message_Notice({
                                english="""
                                    
                                    [CN]You have no Blue Gummis.
                                """,
                            });
                            JumpCommon(CORO_END_TALK);
                    }
                    break;
                case menu({
                    english="CHECK_ITEM_WAREHOUSE",
                }):
                    message_Close();
                    switch ( ProcessSpecial(PROCESS_SPECIAL_COUNT_ITEM_TYPE_IN_STORAGE, 121, 0) ) {
                        case 1:
                            jump @label_11;
                        case >= 2:
                            jump @label_12;
                        default:
                            message_Notice({
                                english="""
                                    
                                    [CN]There are no Blue Gummis in storage.
                                """,
                            });
                            JumpCommon(CORO_END_TALK);
                    }
                    break;
                case menu({
                    english="ADD_ITEM",
                }):
                    message_Close();
                    item_Set(0, 121, 0);
                    switch ( ProcessSpecial(PROCESS_SPECIAL_ADD_TABLE_ITEM_TO_BAG, 0, 0) ) {
                        case 0:
                            message_Notice({
                                english="""
                                    
                                    [CN]A Blue Gummi couldn't be obtained.
                                """,
                            });
                            JumpCommon(CORO_END_TALK);
                        default:
                            message_Notice({
                                english="""
                                    
                                    [CN]Received [s_item:0].
                                """,
                            });
                            JumpCommon(CORO_END_TALK);
                    }
                    break;
                case menu({
                    english="DEL_ITEM",
                }):
                    message_Close();
                    item_Set(0, 121, 0);
                    switch ( ProcessSpecial(PROCESS_SPECIAL_REMOVE_TABLE_ITEMS_TYPE_IN_BAG, 0, 0) ) {
                        case 0:
                            message_Notice({
                                english="""
                                    
                                    [CN]You never had a Blue Gummi to start with.
                                """,
                            });
                            JumpCommon(CORO_END_TALK);
                        default:
                            message_Notice({
                                english="""
                                    
                                    [CN]You lost a Blue Gummi.
                                """,
                            });
                            JumpCommon(CORO_END_TALK);
                    }
                    break;
                default:
                    jump @label_6;
            }
            break;
        case menu({
            english="MAP_TEST",
        }):
            message_Close();
            screen_FadeOut(1, 30);
            back_SetGround(LEVEL_P14P01A);
            camera_SetPositionMark(Position<'m0', 47, 32.5>);
            screen_FadeIn(1, 30);
            Wait(30);
            message_Notice({
                english="The Map will be switched.",
            });
            message_Close();
            back_ChangeGround(LEVEL_P14P01A2);
            Wait(30);
            message_Notice({
                english="The Map was switched.",
            });
            message_Close();
            screen_FadeOut(1, 30);
            supervision_ExecuteEnter(2);
            hold;
        default:
            message_Talk({
                english="I see...",
            });
            JumpCommon(CORO_END_TALK);
    }
}
