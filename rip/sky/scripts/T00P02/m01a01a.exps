
def 0 {
    debug_Print('acting_M01A01A');
    message_ResetActor();
    message_Talk({
        english="An Acting Test will be conducted.",
    });
    message_Close();
    supervision_Acting(0);
    WaitExecuteLives(ACTOR_NPC_TEST010);
    message_Talk({
        english="The Event Test is finished.",
    });
    message_Close();
    camera_Move2Default(1.0);
    supervision_Suspend(-2);
    supervision_RemoveActing(0);
    end;
}

def 1 for performer 0 {
    camera_SetMyself();
    hold;
}

def 2 for actor ACTOR_PLAYER {
    SetEffect(EFFECT_TWO_ARROWS_AT_SIDE_LEFT, 0);
    WaitEffect();
    hold;
}

def 3 for actor ACTOR_ATTENDANT1 {
    SetEffect(EFFECT_TWO_ARROWS_AT_SIDE_LEFT, 0);
    WaitEffect();
    hold;
}

def 4 for actor ACTOR_NPC_TEST010 {
    debug_Print('TEST010_MOVE1');
    SetEffect(EFFECT_LAUGHING, 0);
    Wait(60);
    SetEffect(EFFECT_NONE, 0);
    MoveDirection(16, 0.5, DIR_DOWN);
    SetEffect(EFFECT_EXCLAMATION_MARK, 0);
    WaitEffect();
    SetEffect(EFFECT_NONE, 0);
    MoveDirection(16, 0.5, DIR_RIGHT);
    SetEffect(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 0);
    Wait(60);
    SetEffect(EFFECT_NONE, 0);
    MoveDirection(16, 0.5, DIR_UP);
    SetEffect(EFFECT_TWO_ARROWS_AT_SIDE_LEFT, 0);
    WaitEffect();
    SetEffect(EFFECT_NONE, 0);
    MoveDirection(16, 0.5, DIR_LEFT);
    SetEffect(EFFECT_JOYOUS, 0);
    Wait(60);
    SetEffect(EFFECT_NONE, 0);
    hold;
}
