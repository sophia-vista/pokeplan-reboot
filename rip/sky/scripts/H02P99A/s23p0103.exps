    message_Talk({
        english=" ...[K]You don't...[K]want me?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    bgm_PlayFadeIn(BGM_AT_THE_END_OF_THE_DAY, 0, 256);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_ATTENDANT1>();
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_TEARY_EYED, FACE_POS_TOP_L_CENTER);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Urk...[K] Of course we want you
                    to stay with us![K] Right, [hero]?
                """,
            }
        case 2:
            {
                english="""
                     Urk...[K] Of course we want you
                    to stay with us![K] Right, [hero]?
                """,
            }
        default:
            {
                english="""
                     Urk...[K] Of course we want you
