
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_H02P99A);
    supervision_StationCommon(0);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 60);
    bgm_PlayFadeIn(BGM_GOODNIGHT, 0, 256);
    Wait(30);
    ExecuteCommon<actor ACTOR_NPC_MANAFI>(CORO_LOOK_AROUND_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_MANAFI);
    message_SetFace(ACTOR_NPC_MANAFI, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Wow...[K]I remember this place.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_MANAFI>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_NPC_MANAFI);
    message_Talk({
        english=" I hatched here, didn't I?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Yes, you're right.[K] This is where 
                    we came to know each other.
                """,
            }
        case 2:
            {
                english="""
                     Yes, you're right.[K] This is where 
                    we came to know each other.
                """,
            }
        default:
            {
                english="""
                     Yes, you're right.[K] This is where 
                    we came to know each other.
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     I'm surprised you still
                    remember that.
                """,
            }
        case 2:
            {
                english="""
                     I'm surprised you still
                    remember that.
                """,
            }
        default:
            {
                english="""
                     I'm surprised you can
                    remember that.
                """,
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
