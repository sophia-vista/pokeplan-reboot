    WaitMe(5);
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    screen_FadeOut(1, 60);
    $SCENARIO_MAIN = scn[29, 95];
    Destroy<actor ACTOR_NPC_MANAFI>();
