    Wait(15);
    ExecuteCommon<actor ACTOR_NPC_MANAFI>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_MANAFI);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_ATTENDANT1);
