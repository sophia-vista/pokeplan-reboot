    switch ( ProcessSpecial(PROCESS_SPECIAL_PREPARE_MENU_ACCEPT_TEAM_MEMBER, 16, 0) ) { }
    switch ( message_Menu(MENU_ACCEPT_TEAM_MEMBER) ) { }
    bgm_Stop();
    me_Play(5);
    message_Mail({
        english="[CN][c_name:NPC_NEW_FRIEND] joined the team!",
