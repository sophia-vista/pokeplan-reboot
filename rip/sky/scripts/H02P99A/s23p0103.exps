    SetPositionMark<actor ACTOR_PLAYER>(Position<'m0', 35.5, 24.5>);
    SetPositionMark<actor ACTOR_ATTENDANT1>(Position<'m1', 32.5, 24.5>);
    SetDirection<actor ACTOR_PLAYER>(DIR_DOWN);
    SetDirection<actor ACTOR_ATTENDANT1>(DIR_DOWN);
