    message_SetFace(ACTOR_NPC_MANAFI, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             I was told that I have to decide
            that on my own.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_MANAFI>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_NPC_MANAFI);
    message_Talk({
        english="""
             Well, um... So, uh...[K] I thought
