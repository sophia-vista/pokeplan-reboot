    WaitEffect<actor ACTOR_NPC_MANAFI>();
    WaitExecuteLives(ACTOR_NPC_MANAFI);
    message_SetFace(ACTOR_NPC_MANAFI, FACE_SURPRISED, FACE_POS_STANDARD);
    message_Talk({
        english="""
             D-don't worry![K] I'm grown up!
