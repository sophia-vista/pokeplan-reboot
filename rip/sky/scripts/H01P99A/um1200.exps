
def 0 {
    supervision_Station(0);
    if ( scn($SCENARIO_MAIN) >= [13, 2] ) {
        @label_0;
        if ( $SCENARIO_TALK_BIT_FLAG[23] ) {
            @label_2;
            end;
        } else {
            supervision_Station(4);
            end;
        }
    } elseif ( scn($SCENARIO_MAIN) >= [13, 1] ) {
        if ( $SCENARIO_TALK_BIT_FLAG[23] ) {
            jump @label_2;
        } else {
            supervision_Station(2);
            jump @label_2;
        }
    } else {
        end;
    }
}
