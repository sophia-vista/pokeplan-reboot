
def 0 {
    supervision_Station(0);
    if ( scn($SCENARIO_MAIN) >= [17, 3] ) {
        @label_0;
        if ( $SCENARIO_TALK_BIT_FLAG[24] ) {
            @label_2;
            end;
        } else {
            supervision_Station(3);
            jump @label_2;
        }
    } elseif ( scn($SCENARIO_MAIN) >= [17, 1] ) {
        supervision_Station(1);
        end;
    } else {
        end;
    }
}
