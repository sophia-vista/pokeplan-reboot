
def 0 {
    if ( scn($SCENARIO_SIDE) >= [40, 7] ) {
        @label_0;
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        message_SetFace(ACTOR_NPC_DAGUTORIO, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english=" Hey, [CS:Y]Bidoof[CR]!",
        });
        message_Talk({
            english="""
                 Do your best on the exploration!
                (You know we really wanted to go...)
            """,
        });
        message_Talk({
            english="""
                 I know you can do it!
                (It should have been us doing it...)
            """,
        });
        message_Talk({
            english="""
                 Do your best!
                (Jealous... So jealous...)
            """,
        });
        message_Talk({
            english=" Don't fail! (Still jealous...)",
        });
        message_Close();
        @label_3;
        JumpCommon(CORO_END_TALK);
    } elseif ( scn($SCENARIO_SIDE) >= [40, 3] || scn($SCENARIO_SIDE) >= [40, 2] ) {
        jump @label_3;
    } else {
        jump @label_3;
    }
}
