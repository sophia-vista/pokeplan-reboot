
def 0 {
    $BIT_FUWARANTE_LOCAL[0] = 1;
    $BIT_FUWARANTE_LOCAL[1] = 1;
    $BIT_FUWARANTE_LOCAL[2] = 1;
    $BIT_FUWARANTE_LOCAL[3] = 1;
    $BIT_FUWARANTE_LOCAL[4] = 1;
    switch ( $GROUND_ENTER ) {
        case 156:
            @label_0;
            $BIT_FUWARANTE_LOCAL[0] = 0;
            @label_4;
            if ( scn($SCENARIO_MAIN) < [29, 18] ) {
                $BIT_FUWARANTE_LOCAL[2] = 0;
                $BIT_FUWARANTE_LOCAL[3] = 0;
                @label_7;
                ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
                Turn2DirectionLives<actor ACTOR_NPC_FUWARAIDO>(4, 10, ACTOR_TALK_MAIN);
                WaitExecuteLives(ACTOR_NPC_FUWARAIDO);
                Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_FUWARAIDO);
                SetAnimation<actor ACTOR_ATTENDANT1>(2);
                Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_FUWARAIDO);
                message_SetFace(ACTOR_NPC_FUWARAIDO, FACE_NORMAL, FACE_POS_STANDARD);
                message_Talk({
                    english="""
                         Hi!
                        This is [CS:K]Drifblim[CR]'s Gondola.
                        Where would you like to go?
                    """,
                });
                @label_17;
                switch ( message_SwitchMenu2(0, 1, 98) ) {
                    case menu({
                        english="Shaymin Village",
                    }):
                        $EVENT_LOCAL = 0;
                        message_SetFace(ACTOR_NPC_FUWARAIDO, FACE_NORMAL, FACE_POS_STANDARD);
                        message_Talk({
                            english=" To the [CS:P]Shaymin Village[CR]?",
                        });
                        @label_14;
                        switch ( message_SwitchMenu(0, 1) ) {
                            case menu({
                                english="Yes",
                            }):
                                switch ( $GROUND_ENTER ) {
                                    case 156:
                                        if ( scn($SCENARIO_MAIN) >= [29, 31] ) {
                                            @label_19;
                                            $SCENARIO_MAIN_BIT_FLAG[46] = 1;
                                            message_SetFace(ACTOR_NPC_FUWARAIDO, FACE_NORMAL, FACE_POS_STANDARD);
                                            message_Talk({
                                                english=" Now...here we go!",
                                            });
                                            message_Close();
                                            switch ( $GROUND_ENTER ) {
                                                case 156:
                                                default:
                                                    CallCommon(CORO_SORANOITADAKI_FLAGSET);
                                                    bgm_FadeOut(60);
                                                    main_EnterDungeon(111, 30);
                                                    switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
                                                    @label_24;
                                                    switch ( $EVENT_LOCAL ) {
                                                        case 0:
                                                        default:
                                                            bgm_FadeOut(60);
                                                            $DUNGEON_RESULT = 3;
                                                            switch ( message_Menu(MENU_DUNGEON_TEAM_RETURNS_FROM_MAP) ) { }
                                                            main_EnterGround(LEVEL_D73P11A, 30);
                                                            hold;
                                                            end;
                                                        case 1:
                                                            bgm_FadeOut(60);
                                                            main_EnterGround(LEVEL_D73P22A, 30);
                                                            hold;
                                                            end;
                                                        case 2:
                                                            bgm_FadeOut(60);
                                                            main_EnterGround(LEVEL_D73P24A, 30);
                                                            hold;
                                                            end;
                                                        case 3:
                                                            bgm_FadeOut(60);
                                                            main_EnterGround(LEVEL_D73P26A, 30);
                                                            hold;
                                                            end;
                                                    }
                                                    break;
                                                case 158:
                                                    if ( scn($SCENARIO_MAIN) >= [29, 15] ) {
                                                        jump @label_24;
                                                    } else {
                                                        $SCENARIO_MAIN = scn[29, 15];
                                                        jump @label_24;
                                                    }
                                                    break;
                                                case 160:
                                                    if ( scn($SCENARIO_MAIN) >= [29, 19] ) {
                                                        jump @label_24;
                                                    } else {
                                                        $SCENARIO_MAIN = scn[29, 19];
                                                        jump @label_24;
                                                    }
                                                    break;
                                                case 162:
                                                    if ( scn($SCENARIO_MAIN) >= [29, 23] ) {
                                                        jump @label_24;
                                                    } else {
                                                        $SCENARIO_MAIN = scn[29, 23];
                                                        jump @label_24;
                                                    }
                                                    break;
                                            }
                                        } else {
                                            switch ( ProcessSpecial(PROCESS_SPECIAL_RECURITABLE_CAN_ADD, 21, 0) ) {
                                                case 1:
                                                    jump @label_19;
                                                default:
                                                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                                    message_Mail({
                                                        english="""
                                                            [CN]You have too many team members
                                                            [CN]for [CS:N]Shaymin[CR] to join your team.
                                                        """,
                                                    });
                                                    message_Mail({
                                                        english="""
                                                            [CN]Head to the [CS:K]Chimecho[CR] Assembly Post
                                                            [CN]near the entrance to reduce the number of
                                                            [CN]members in your team.
                                                        """,
                                                    });
                                                    message_Close();
                                                    @label_13;
                                                    JumpCommon(CORO_END_TALK);
                                            }
                                        }
                                        break;
                                    default:
                                        jump @label_19;
                                }
                                break;
                            case menu({
                                english="No",
                            }):
                            default:
                                message_SetFace(ACTOR_NPC_FUWARAIDO, FACE_NORMAL, FACE_POS_STANDARD);
                                message_Talk({
                                    english=" Where would you like to go?",
                                });
                                jump @label_17;
                        }
                        break;
                    case menu({
                        english="Sky Peak 2nd Station Clearing",
                    }):
                        $EVENT_LOCAL = 1;
                        message_Talk({
                            english=" [CS:P]Sky Peak[CR] 2nd Station Clearing?",
                        });
                        jump @label_14;
                    case menu({
                        english="Sky Peak 4th Station Clearing",
                    }):
                        $EVENT_LOCAL = 2;
                        message_Talk({
                            english=" [CS:P]Sky Peak[CR] 4th Station Clearing?",
                        });
                        jump @label_14;
                    case menu({
                        english="Sky Peak 6th Station Clearing",
                    }):
                        $EVENT_LOCAL = 3;
                        message_Talk({
                            english=" [CS:P]Sky Peak[CR] 6th Station Clearing?",
                        });
                        jump @label_14;
                    case menu({
                        english="Cancel",
                    }):
                    default:
                        message_SetFace(ACTOR_NPC_FUWARAIDO, FACE_NORMAL, FACE_POS_STANDARD);
                        message_Talk({
                            english=" Thank you for your patronage.",
                        });
                        message_Close();
                        jump @label_13;
                }
            } elseif ( scn($SCENARIO_MAIN) < [29, 22] ) {
                $BIT_FUWARANTE_LOCAL[3] = 0;
                jump @label_7;
            } else {
                jump @label_7;
            }
            break;
        case 158:
            $BIT_FUWARANTE_LOCAL[1] = 0;
            jump @label_4;
        case 160:
            $BIT_FUWARANTE_LOCAL[2] = 0;
            jump @label_4;
        case 162:
            $BIT_FUWARANTE_LOCAL[3] = 0;
            jump @label_4;
        default:
            jump @label_4;
    }
}
