            case 159:
                jump @label_80;
        }
    } elseif ( scn($SCENARIO_MAIN) >= [29, 15] ) {
        switch ( $GROUND_ENTER ) {
            case 156:
            default:
                jump @label_65;
            case 157:
            case 158:
                jump @label_70;
        }
    } elseif ( scn($SCENARIO_MAIN) >= [29, 14] ) {
        switch ( $GROUND_ENTER ) {
            case 156:
            default:
                jump @label_65;
            case 157:
                jump @label_70;
            case 158:
                ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
                ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
                message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_STANDARD);
                message_Talk({
                    english="""
                         Mountain climbing is so great
                        when everyone cooperates!
                    """,
                });
                message_Talk({
                    english="""
                         I know. I'm just so
                        incredibly excited!
                    """,
                });
                message_Close();
                jump @label_64;
        }
    } elseif ( scn($SCENARIO_MAIN) >= [29, 13] ) {
        switch ( $GROUND_ENTER ) {
            case 156:
            default:
                jump @label_65;
            case 157:
                jump @label_70;
        }
    } elseif ( scn($SCENARIO_MAIN) >= [29, 12] ) {
        switch ( $GROUND_ENTER ) {
            case 156:
            default:
                jump @label_65;
            case 157:
                ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
                ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
                message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_STANDARD);
                message_Talk({
                    english="""
                         [CS:P]Sky Peak[CR] has resting areas,
                        labeled 1st Station through 9th Station.
                    """,
                });
                message_Talk({
                    english="""
                         The 10th Station is, of course,
                        the summit.
                    """,
                });
                message_Talk({
                    english="""
                         The road ahead is long, so let's
                        take it in stages.
                    """,
                });
                message_Close();
                jump @label_64;
        }
    } elseif ( scn($SCENARIO_MAIN) >= [29, 11] ) {
        switch ( $GROUND_ENTER ) {
            case 156:
            default:
                break;
        }
        jump @label_65;
    } elseif ( scn($SCENARIO_MAIN) >= [29, 10] ) {
        switch ( $GROUND_ENTER ) {
            case 156:
            default:
                break;
        }
        jump @label_65;
    } else {
        jump @label_64;
    }
}
