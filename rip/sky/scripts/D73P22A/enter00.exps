    SetOutputAttribute(2);
    hold;
}

def 4 for object OBJECT_D73P28A6_392 {
    SetOutputAttribute(2);
    hold;
}

def 5 for object OBJECT_D73P28A8_394 {
    SetOutputAttribute(2);
    hold;
}
