
def 0 {
    SetAnimation<actor ACTOR_PLAYER>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    message_Mail({
        english="""
            [CN]Items and money must be
            [CN]stored or they will be lost.
            [CN]Return to the menu?
        """,
    });
    switch ( message_SwitchMenu(0, 2) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            if ( $SCENARIO_MAIN_BIT_FLAG[40] ) {
                @label_2;
                CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                switch ( message_Menu(MENU_SAVE_MENU) ) { }
                @label_3;
                bgm_FadeOut(60);
                bgm2_FadeOut(60);
                switch ( ProcessSpecial(PROCESS_SPECIAL_JUMP_TO_TITLE_SCREEN, 30, 0) ) { }
                hold;
            } else {
                switch ( $NOTE_MODIFY_FLAG ) {
                    case 1:
                        jump @label_2;
                    default:
                        jump @label_3;
                }
            }
            break;
        case menu({
            english="No",
        }):
            message_Close();
            supervision_Suspend(-2);
            end;
    }
}

def 1 for actor ACTOR_PLAYER {
    hold;
}
