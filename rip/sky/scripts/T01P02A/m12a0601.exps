
def 0 {
    back_SetGround(LEVEL_T01P02A);
    supervision_StationCommon(0);
    supervision_Acting(0);
    supervision_Acting(1);
    camera_SetMyself<performer 0>();
    message_Narration(30, {
        english="[CN]Meanwhile, back at Treasure Town...",
    });
    message_Close();
    WaitBgm(BGM_FAR_AMP_PLAINS);
    CallCommon(CORO_FADE_OUT_ALL_BEFORE);
    bgm_PlayFadeIn(BGM_TREASURE_TOWN, 0, 256);
    screen_FadeInAll(1, 30);
    Wait(30);
    message_SetFace(ACTOR_NPC_KAKUREON1, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english="""
             Ah, I see! That's what happened
            to your [CS:Z]Water Float[CR]!
        """,
    });
    message_Talk({
        english=" What a mean thing to do!",
    });
    message_Talk({
        english="""
             So, [hero]'s team is on
            the way there right now, yes?
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    ExecuteCommon<actor ACTOR_NPC_RURIRI>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_RURIRI);
    message_SetFace(ACTOR_NPC_RURIRI, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Yep!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_MARIRU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             They said they would go get it
            for us!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_KAKUREON1, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english="""
             Good for you! You can rest easy
            knowing Team [team:] is on the case!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_MARIRU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" Yes. That's true!",
    });
    message_Talk({
        english="""
             They once saved [CS:N]Azurill[CR] too.
            We're so grateful for their help!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Wait(1);
    message_SetActor(ACTOR_NPC_YONOWAARU);
    message_Talk({
        english="""
             Good day to you all. Is something
            the matter?
        """,
    });
    MovePositionMark<actor ACTOR_NPC_YONOWAARU>(1, Position<'m0', 51, 26>);
    se_Play(8964);
    Turn2Direction<actor ACTOR_NPC_RURIRI>(4, 10, DIR_RIGHT);
    Wait(5);
    Turn2Direction<actor ACTOR_NPC_MARIRU>(4, 10, DIR_RIGHT);
    Turn2Direction<actor ACTOR_NPC_KAKUREON1>(4, 10, DIR_RIGHT);
    Wait(5);
    Turn2Direction<actor ACTOR_NPC_KAKUREON2>(4, 10, DIR_RIGHT);
    MovePositionMark<actor ACTOR_NPC_YONOWAARU>(1, Position<'m1', 46, 26>);
    MovePositionMark<actor ACTOR_NPC_MARIRU>(1, Position<'m2', 40, 26.5>);
    Turn2Direction<actor ACTOR_NPC_KAKUREON1>(4, 10, DIR_DOWNRIGHT);
    Turn2Direction<actor ACTOR_NPC_KAKUREON2>(4, 10, DIR_DOWNRIGHT);
    Turn2Direction<actor ACTOR_NPC_MARIRU>(4, 10, DIR_RIGHT);
    WaitExecuteLives(ACTOR_NPC_YONOWAARU);
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8978);
    SetEffect<actor ACTOR_NPC_KAKUREON1>(EFFECT_EXCLAMATION_MARK, 3);
    WaitEffect<actor ACTOR_NPC_KAKUREON1>();
    WaitExecuteLives(ACTOR_NPC_KAKUREON1);
    message_SetFace(ACTOR_NPC_KAKUREON1, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english="""
             Hello, [CS:N]Dusknoir[CR], sir! We're
            talking about [CS:N]Marill[CR]'s lost item.
        """,
    });
    message_Talk({
        english="""
             Do you remember? We discussed
            that very same thing here not long ago.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_NPC_YONOWAARU>(4, 10, ACTOR_NPC_KAKUREON1);
    WaitExecuteLives(ACTOR_NPC_YONOWAARU);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             Of course.[K] I believe you're
            referring to the [CS:Z]Water Float[CR]?
        """,
    });
    message_Talk({
        english="""
             I seem to recall you'd heard that
            it was on the beach.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_KAKUREON1, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english="""
             Exactly! Exactly![K] But now there
