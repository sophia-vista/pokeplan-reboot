        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_MARIRU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" They went to [CS:P]Amp Plains[CR].",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    bgm_FadeOut(10);
    se_Play(8968);
    Turn2Direction<actor ACTOR_NPC_YONOWAARU>(4, 10, DIR_LEFT);
    SetEffect<actor ACTOR_NPC_YONOWAARU>(EFFECT_SHOCKED, 3);
    WaitEffect<actor ACTOR_NPC_YONOWAARU>();
    WaitExecuteLives(ACTOR_NPC_YONOWAARU);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             Pardon?[K] Did you say [CS:P]Amp
            Plains[CR]?
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_YONOWAARU>(4, 10, DIR_DOWNLEFT);
    WaitExecuteLives(ACTOR_NPC_YONOWAARU);
    message_Talk({
        english="""
             But in [CS:P]Amp Plains[CR], at this time
            of year...[K] It's the season for...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8967);
    SetEffect<actor ACTOR_NPC_YONOWAARU>(EFFECT_SHOCKED, 3);
    WaitEffect<actor ACTOR_NPC_YONOWAARU>();
    WaitExecuteLives(ACTOR_NPC_YONOWAARU);
    message_Talk({
        english=" No! This is ruinous!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_NPC_YONOWAARU>(1, 10, ACTOR_NPC_KAKUREON1);
    WaitExecuteLives(ACTOR_NPC_YONOWAARU);
    message_Talk({
        english="""
             Team [team:] is in grave
            danger!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8974);
    SetEffect<actor ACTOR_NPC_KAKUREON2>(EFFECT_SHOCKED_MIRRORED, 3);
    ExecuteCommon<actor ACTOR_NPC_KAKUREON1>(CORO_JUMP_SURPRISE_FUNC_SERIES, 0);
    SetEffect<actor ACTOR_NPC_RURIRI>(EFFECT_EXCLAMATION_MARK, 3);
    SetEffect<actor ACTOR_NPC_MARIRU>(EFFECT_SHOCKED_MIRRORED, 3);
    message_SetFace(ACTOR_NPC_KAKUREON1, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english=" What?!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             I must leave for [CS:P]Amp Plains[CR]
            immediately!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    MovePositionOffset<actor ACTOR_NPC_YONOWAARU>(1.5, 160, 0);
    Wait(30);
    se_Play(8972);
    SetEffect<actor ACTOR_NPC_KAKUREON1>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_NPC_KAKUREON1>();
    WaitExecuteLives(ACTOR_NPC_KAKUREON1);
    message_SetFace(ACTOR_NPC_KAKUREON1, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
