        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    ExecuteCommon<actor ACTOR_NPC_KAKUREON1>(CORO_EXPLANATION_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_KAKUREON1);
    message_Mail({
        english="""
            [CN][CS:N]Kecleon[CR] explained to [CS:N]Dusknoir[CR]
            [CN]what had taken place.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" I see. That is terrible indeed.",
    });
    message_Talk({
        english="""
             It's hard to imagine why anyone
            would do something so wretched.
        """,
    });
    message_Talk({
        english="""
             It must take some pathetic thugs
            to stoop so low.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8970);
    ExecuteCommon<actor ACTOR_NPC_KAKUREON1>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_KAKUREON1);
    message_SetFace(ACTOR_NPC_KAKUREON1, FACE_ANGRY, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english="""
             I just couldn't agree more![K]
            To be so mean spirited to children! And to
            children so young as these brothers!
        """,
    });
    message_Talk({
        english=" It's utterly unforgivable!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             One more thing...[K] Where has
