
def 0 {
    if ( scn($SCENARIO_SIDE) >= [40, 7] || scn($SCENARIO_SIDE) >= [40, 3] ) {
        @label_3;
        JumpCommon(CORO_END_TALK);
    } elseif ( scn($SCENARIO_SIDE) >= [40, 2] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        message_SetFace(ACTOR_NPC_BANEBUU, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 Hey, [CS:Y]Bidoof[CR]![K]
                Hello!
            """,
        });
        message_Talk({
            english=" I've been doing well, but...",
        });
        message_Talk({
            english="""
                 I've been so happy, the pearl
                on top of my head has started to come loose...
            """,
        });
        message_Talk({
            english=" I'm worried it might fall off...",
        });
        message_Talk({
            english=" This pearl is everything to me.",
        });
        message_Talk({
            english="""
                 It seems like more bad Pokémon
                are appearing lately...
            """,
        });
        message_Talk({
            english=" If my pearl gets stolen...",
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        se_Play(8972);
        SetEffect<actor ACTOR_NPC_BANEBUU>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
        WaitEffect<actor ACTOR_NPC_BANEBUU>();
        WaitExecuteLives(ACTOR_NPC_BANEBUU);
        message_SetFace(ACTOR_NPC_BANEBUU, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english=" I don't know what I would do!",
        });
        message_Talk({
            english="""
                 ...But maybe I'm just worrying
                too much.
            """,
        });
        message_Talk({
            english="""
                 Worrying so much isn't good for
                my health. That makes me worry even more.
            """,
        });
        message_KeyWait();
        SetEffect<actor ACTOR_NPC_BANEBUU>(EFFECT_LAUGHING, 3);
        message_Talk({
            english=" Ha-hahahaha!",
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        Wait(10);
        SetEffect<actor ACTOR_NPC_BANEBUU>(EFFECT_NONE, 3);
        WaitEffect<actor ACTOR_NPC_BANEBUU>();
        WaitExecuteLives(ACTOR_NPC_BANEBUU);
        jump @label_3;
    } else {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        message_SetFace(ACTOR_NPC_BANEBUU, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 Oh, hey! [CS:Y]Bidoof[CR]! Good to see
                you![K] How are you?
            """,
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        message_SetFace(ACTOR_PLAYER_BIPPA, FACE_SPECIAL2, FACE_POS_BOTTOM_R_FACEINW);
        message_Talk({
            english="""
                 Um...[K]
                Well... It's like...[K]yup.
            """,
        });
        message_Talk({
            english="""
                 By golly, how about you,
                [CS:N]Spoink[CR]?
            """,
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        message_SetFace(ACTOR_NPC_BANEBUU, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 I'm doing great! Wonderful!
                Superb![K] Just swimmingly!
            """,
        });
        message_Talk({
            english="""
                 The pearl on top of my head is
                also radiant!
            """,
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        message_SetFace(ACTOR_PLAYER_BIPPA, FACE_SPECIAL2, FACE_POS_BOTTOM_R_FACEINW);
        message_Talk({
            english="""
                 That...[K] That's good, yup yup.[K]
                To tell the truth, I'm a little jealous...
            """,
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        message_SetFace(ACTOR_NPC_BANEBUU, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 Oh, OK![K] I hope you feel better
                soon, [CS:Y]Bidoof[CR]!
            """,
        });
        message_Close();
        jump @label_3;
    }
}
