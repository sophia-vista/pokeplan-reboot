}

def 1 for actor ACTOR_NPC_YARUKIMONO {
    switch ( sector() ) {
        case 10:
            SetMoveRange(Position<'m0', 19, 27>, 9, 3);
            JumpCommon(CORO_MOVE_TYPE1);
        case 8:
            SetMoveRange(Position<'m1', 19, 27>, 9, 3);
            JumpCommon(CORO_MOVE_TYPE1);
        default:
            JumpCommon(CORO_LIVES_MOVE_NORMAL);
    }
}

