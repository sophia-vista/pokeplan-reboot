
def 0 {
    if ( scn($SCENARIO_SIDE) >= [40, 7] ) {
        @label_0;
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        @label_4;
        switch ( message_Menu(MENU_KANGASKHAN_STORAGE) ) { }
        @label_3;
        JumpCommon(CORO_END_TALK);
    } elseif ( scn($SCENARIO_SIDE) >= [40, 3] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        jump @label_4;
    } elseif ( scn($SCENARIO_SIDE) >= [40, 2] ) {
        if ( $SCENARIO_TALK_BIT_FLAG[127] ) {
            jump @label_4;
        } else {
            $SCENARIO_TALK_BIT_FLAG[127] = 1;
            ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
            ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
            message_SetFace(ACTOR_NPC_GARUURA, FACE_NORMAL, FACE_POS_STANDARD);
            message_Talk({
                english="""
                     Huh? [CS:Y]Bidoof[CR]![K]
                    Long time no see!
                """,
            });
            message_Talk({
                english=" You want to use the storage?",
            });
            message_Talk({
                english="""
                     My dear, anything you want
                    to store, I'll take good care of for you!
                """,
            });
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            jump @label_4;
        }
    } else {
        jump @label_3;
    }
}
