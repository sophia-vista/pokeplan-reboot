
def 0 {
    if ( scn($SCENARIO_SIDE) >= [40, 7] ) {
        @label_0;
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        @label_4;
        switch ( message_Menu(MENU_KECLEON_WARES) ) { }
        @label_3;
        JumpCommon(CORO_END_TALK);
    } elseif ( scn($SCENARIO_SIDE) >= [40, 3] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        jump @label_4;
    } elseif ( scn($SCENARIO_SIDE) >= [40, 2] ) {
        if ( $SCENARIO_TALK_BIT_FLAG[130] ) {
            jump @label_4;
        } else {
            $SCENARIO_TALK_BIT_FLAG[130] = 1;
            ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
            ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
            message_SetFace(ACTOR_NPC_KAKUREON2, FACE_NORMAL, FACE_POS_STANDARD);
            message_Talk({
                english=" Ah, [CS:Y]Bidoof[CR]! ♪",
            });
            message_Talk({
                english="""
                     If you need any TMs, please let
                    me know! ♪
                """,
            });
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            jump @label_4;
        }
    } else {
        jump @label_3;
    }
}
