
def 0 {
    ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
    ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
    if ( scn($SCENARIO_SIDE) >= [43, 2] || $SCENARIO_TALK_BIT_FLAG[137] ) {
        @label_0;
        switch ( message_Menu(MENU_KECLEON_WARES) ) { }
        @label_1;
        JumpCommon(CORO_END_TALK);
    } else {
        $SCENARIO_TALK_BIT_FLAG[137] = 1;
        message_SetFace(ACTOR_NPC_KAKUREON2, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english=" Ah! Hello, [CS:Y]Sunflora[CR]! ♪",
        });
        message_Talk({
            english=" Oh? [K]Is it a new job?",
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        jump @label_0;
    }
}
