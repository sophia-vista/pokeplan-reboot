
def 0 {
    ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
    ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
    if ( scn($SCENARIO_SIDE) >= [43, 2] || $SCENARIO_TALK_BIT_FLAG[135] ) {
        @label_0;
        switch ( message_Menu(MENU_KANGASKHAN_STORAGE) ) { }
        @label_1;
        JumpCommon(CORO_END_TALK);
    } else {
        $SCENARIO_TALK_BIT_FLAG[135] = 1;
        message_SetFace(ACTOR_NPC_GARUURA, FACE_HAPPY, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 I've got it! [CS:Y]Sunflora[CR]![K]
                Have you come to use the storage?
            """,
        });
        message_Talk({
            english="""
                 I'll take good care of your items,
                so you can entrust them to me!
            """,
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        jump @label_0;
    }
}
