
def 0 {
    ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
    ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
    if ( scn($SCENARIO_SIDE) >= [43, 2] || $SCENARIO_TALK_BIT_FLAG[136] ) {
        @label_0;
        switch ( message_Menu(MENU_KECLEON_SHOP) ) { }
        @label_1;
        JumpCommon(CORO_END_TALK);
    } else {
        $SCENARIO_TALK_BIT_FLAG[136] = 1;
        message_SetFace(ACTOR_NPC_KAKUREON1, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 It looks like your workload is
                piling up... It must be tough!
            """,
        });
        message_Talk({
            english=" But do your best! ♪",
        });
        message_Talk({
            english="""
                 Feel free to purchase some of
                our items for your use. ♪
            """,
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        jump @label_0;
    }
}
