
def 0 {
    if ( scn($SCENARIO_SIDE) >= [40, 7] || scn($SCENARIO_SIDE) >= [40, 3] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        message_SetFace(ACTOR_NPC_YARUKIMONO, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english=" Yo! [CS:Y]Bidoof[CR]!",
        });
        message_Talk({
            english="""
                 Not that I'm particularly
                concerned...
            """,
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        ExecuteCommon<actor ACTOR_NPC_YARUKIMONO>(CORO_LOOK_AROUND_FUNC_SERIES, 0);
        WaitExecuteLives(ACTOR_NPC_YARUKIMONO);
        message_SetFace(ACTOR_NPC_YARUKIMONO, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 But I haven't seen [CS:N]Spoink[CR]
                lately...
            """,
        });
        message_Talk({
            english="""
                 Yeah, [K]have you heard about the
                recent increase in bad Pokémon?
            """,
        });
        message_Talk({
            english="""
                 [CS:N]Spoink[CR]...[K]
                He carries a pearl on top of his head.
            """,
        });
        message_Talk({
            english=" So, I'm a little worried...",
        });
        message_Talk({
            english="""
                 But...[K]
                Maybe I'm just being paranoid!
            """,
        });
        message_Talk({
            english=" He always looks so happy...",
        });
        message_Talk({
            english="""
                 I guess he will show up
                one day feeling happy...just like always!
            """,
        });
        message_KeyWait();
        SetEffect<actor ACTOR_NPC_YARUKIMONO>(EFFECT_LAUGHING, 3);
        message_Talk({
            english=" Hah-hahahaha!",
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        Wait(10);
        SetEffect<actor ACTOR_NPC_YARUKIMONO>(EFFECT_NONE, 3);
        SetEffect<actor ACTOR_NPC_YARUKIMONO>(EFFECT_NONE, 3);
        WaitEffect<actor ACTOR_NPC_YARUKIMONO>();
        WaitExecuteLives(ACTOR_NPC_BANEBUU);
        @label_3;
        JumpCommon(CORO_END_TALK);
    } elseif ( scn($SCENARIO_SIDE) >= [40, 2] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        message_SetFace(ACTOR_NPC_YARUKIMONO, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 Yo! [CS:Y]Bidoof[CR]![K] How's guild life
                treating you?
            """,
        });
        message_Talk({
            english="""
                 Work hard at your training!
                Work real hard!
            """,
        });
        message_Talk({
            english=" Work hard and do your best!",
        });
        message_Close();
        jump @label_3;
    } else {
        jump @label_3;
    }
}
