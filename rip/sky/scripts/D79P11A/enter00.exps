
def 0 {
    switch ( sector() ) {
        case 1:
            @label_0;
            supervision_StationCommon(0);
            @label_1;
            if ( $SCENARIO_MAIN_BIT_FLAG[7] ) {
                $SCENARIO_MAIN_BIT_FLAG[7] = 0;
                supervision_StationCommon(2);
                @label_4;
                debug_Print('SET_BGM');
                bgm_PlayFadeIn(BGM_IN_THE_DEPTHS_OF_THE_PIT, 0, 256);
                JumpCommon(CORO_COMMON_ENTER);
            } else {
                @label_3;
                switch ( sector() ) {
                    case 1:
                        end;
                    default:
                        switch ( $GROUND_GETOUT ) { }
                        supervision_StationCommon(1);
                        jump @label_4;
                }
            }
            break;
        default:
            screen_FadeOutAll(1, 0);
            back_SetGround(LEVEL_D79P11A);
            jump @label_0;
    }
}

def 1 for actor ACTOR_PLAYER {
    SetAnimation(2);
    WaitScreenFade();
    WaitScreenFadeAll();
    end;
}

def 2 for actor ACTOR_ATTENDANT1 {
    SetAnimation(2);
    WaitScreenFade();
    WaitScreenFadeAll();
    end;
}
