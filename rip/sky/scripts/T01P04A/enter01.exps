
def 0 {
    SetAnimation<actor ACTOR_PLAYER>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    dungeon_mode(191) = DMODE_OPEN_AND_REQUEST;
    switch ( main_EnterTraining2(-1, 30) ) {
        case 1:
            @label_0;
            supervision_Suspend(-2);
            end;
        default:
            message_Mail({
                english="""
                    
                    [CN]Caution!
                """,
            });
            message_Mail({
                english="""
                    [CN]If you enter here, all the items in
                    [CN]your Treasure Bag will be lost.
                """,
            });
            message_Mail({
                english="""
                    [CN]Will you enter, even though
                    [CN]all your items will be lost?
                """,
            });
            switch ( message_SwitchMenu(0, 2) ) {
                case menu({
                    english="Yes",
                }):
                    message_Close();
                    switch ( main_EnterTraining2(251, 30) ) { }
                    hold;
                case menu({
                    english="No",
                }):
                    message_Close();
                    message_Mail({
                        english="""
                            [CN]You should leave important items with
                            [CN][CS:K]Kangaskhan[CR] Storage before coming here.
                        """,
                    });
                    message_Close();
                    jump @label_0;
                default:
                    jump @label_0;
            }
            break;
    }
}

def 1 for actor ACTOR_PLAYER {
    hold;
}
