
def 0 {
    switch ( $GROUND_ENTER ) {
        case 113:
        case 114:
        case 117:
        case 118:
        case 119:
        case 50:
        case 121:
        case 122:
        case 123:
        case 125:
            @label_12;
            JumpCommon(CORO_END_TALK);
        case 129:
            if ( scn($SCENARIO_SIDE) >= [48, 9] ) {
                ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
                ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
                message_SetFace(ACTOR_NPC_SEREBII, FACE_NORMAL, FACE_POS_STANDARD);
                message_Talk({
                    english="""
                         I can feel the world is slowly
                        changing.
                    """,
                });
                message_Talk({
                    english=" Let's hurry, [CS:Y]Grovyle[CR]!",
                });
                message_Close();
                jump @label_12;
            } elseif ( scn($SCENARIO_SIDE) >= [48, 6] ) {
                ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
                ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
                message_SetFace(ACTOR_NPC_SEREBII, FACE_NORMAL, FACE_POS_STANDARD);
                message_Talk({
                    english="""
                         We'll definitely catch up with 
                        [CS:N]Dialga[CR] this time, [CS:Y]Grovyle[CR]!
                    """,
                });
                message_Talk({
                    english=" To protect the future!",
                });
                message_Close();
                jump @label_12;
            } else {
                ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
                ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
                message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_STANDARD);
                message_Talk({
                    english="""
                         [CS:N]Celebi[CR]...[K]I never thought
                        you would be caught like this.
                    """,
                });
                CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                message_SetFace(ACTOR_NPC_SEREBII, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
                message_Talk({
                    english="""
                         Oh, I didn't imagine that I'd get
                        caught either.
                    """,
                });
                message_KeyWait();
                SetEffect<actor ACTOR_NPC_SEREBII>(EFFECT_NONE, 3);
                WaitEffect<actor ACTOR_NPC_SEREBII>();
                WaitExecuteLives(ACTOR_NPC_SEREBII);
                message_Talk({
                    english="""
                         I really didn't think [CS:N]Dialga[CR]
                        himself would come after me...
                    """,
                });
                message_Talk({
                    english="""
                         By the way, I didn't think you'd
                        be coming back to this world, [CS:Y]Grovyle[CR].
                    """,
                });
                message_SetFace(ACTOR_NPC_SEREBII, FACE_HAPPY, FACE_POS_BOTTOM_R_FACEINW);
                message_Talk({
                    english="""
                         I was worried that you had
                        failed again, you know? Hee-hee-hee!
                    """,
                });
                message_SetFace(ACTOR_NPC_SEREBII, FACE_SIGH, FACE_POS_BOTTOM_R_FACEINW);
                message_Talk({
                    english=" (But...[K]I got to see you again!)",
                });
                message_Talk({
                    english=" (I'm so happy!)",
                });
                message_Close();
                jump @label_12;
            }
            break;
        case 131:
            if ( scn($SCENARIO_SIDE) >= [48, 9] ) {
                ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
                ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
                message_SetFace(ACTOR_NPC_SEREBII, FACE_NORMAL, FACE_POS_STANDARD);
                message_Talk({
                    english=" I'm fine, [CS:Y]Grovyle[CR].",
                });
                message_Talk({
                    english="""
                         I've said this before.[K]
                        I'm prepared for this.
                    """,
                });
                message_Talk({
                    english="""
                         Let's hurry![K]
                        To the top!
                    """,
                });
                message_Close();
                jump @label_12;
            } elseif ( scn($SCENARIO_SIDE) >= [48, 8] ) {
                ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
                ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
                message_SetFace(ACTOR_NPC_SEREBII, FACE_NORMAL, FACE_POS_STANDARD);
                message_Talk({
                    english="""
                         At the pinnacle, we'll find the
                        Passage of Time.
                    """,
                });
                message_Talk({
                    english="""
                         As long as [CS:N]Dialga[CR] hasn't
                        destroyed it...
                    """,
                });
                message_Close();
                jump @label_12;
            } else {
                ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
                ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
                message_SetFace(ACTOR_NPC_SEREBII, FACE_NORMAL, FACE_POS_STANDARD);
                message_Talk({
                    english="""
                         At the pinnacle, we'll find the
                        Passage of Time.
                    """,
                });
                message_Talk({
                    english="""
                         As long as [CS:N]Dialga[CR] hasn't
                        destroyed it...
                    """,
                });
                message_Close();
                jump @label_12;
            }
            break;
        default:
            jump @label_12;
    }
}
