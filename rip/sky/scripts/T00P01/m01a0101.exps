
def 0 {
    ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
    ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
    message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
            ...Fnarff... Yes? I'll open up the shop-related
            menus for you. Which one would you like?
        """,
    });
    switch ( message_SwitchMenu(1, 1) ) {
        case menu({
            english="Assembly",
        }):
            @label_0;
            message_Close();
            switch ( message_Menu(MENU_TEAM_ASSEMBLY) ) { }
            JumpCommon(CORO_END_TALK);
        case menu({
            english="Check Assembly",
        }):
            switch ( ProcessSpecial(PROCESS_SPECIAL_RECURITABLE_CAN_ADD, 21, 0) ) {
                case 1:
                    message_Talk({
                        english="Can add Shaymin",
                    });
                    message_Close();
                    JumpCommon(CORO_END_TALK);
                default:
                    message_Talk({
                        english="Cannot add Shaymin",
                    });
                    message_Close();
                    JumpCommon(CORO_END_TALK);
            }
            break;
        case menu({
            english="Link Moves",
        }):
            message_Close();
            switch ( message_Menu(MENU_LINK_SHOP) ) { }
            JumpCommon(CORO_END_TALK);
        case menu({
            english="Mini Game",
        }):
            message_Close();
            screen2_FadeOut(0, 30);
            screen_FadeOut(1, 30);
            supervision_ExecuteActing(LEVEL_S08P01A, 'QUIZ01', 0);
            hold;
        case menu({
            english="Sort Items",
        }):
            message_Close();
            switch ( message_Menu(MENU_STAFF_CREDITS4) ) { }
            JumpCommon(CORO_END_TALK);
        case menu({
            english="Appraisal",
        }):
            message_Close();
            switch ( message_Menu(MENU_APPRAISAL) ) { }
            JumpCommon(CORO_END_TALK);
        case menu({
            english="Add Team Members",
        }):
            message_Close();
            switch ( ProcessSpecial(PROCESS_SPECIAL_PREPARE_MENU_ACCEPT_TEAM_MEMBER, 14, 0) ) { }
            switch ( message_Menu(MENU_ACCEPT_TEAM_MEMBER) ) { }
            switch ( ProcessSpecial(PROCESS_SPECIAL_PREPARE_MENU_ACCEPT_TEAM_MEMBER, 16, 0) ) { }
            switch ( message_Menu(MENU_ACCEPT_TEAM_MEMBER) ) { }
            switch ( ProcessSpecial(PROCESS_SPECIAL_PREPARE_MENU_ACCEPT_TEAM_MEMBER, 5, 0) ) { }
            switch ( message_Menu(MENU_ACCEPT_TEAM_MEMBER) ) { }
            message_SetFace(ACTOR_NPC_NEW_FRIEND, FACE_NORMAL, FACE_POS_STANDARD);
            message_Talk({
                english="Good morning! I am [c_name:NPC_NEW_FRIEND].",
            });
            JumpCommon(CORO_END_TALK);
        case menu({
            english="Add Items ",
        }):
            message_Close();
            item_Set(0, 121, 0);
            switch ( message_Menu(MENU_GIVE_ITEM) ) { }
            JumpCommon(CORO_END_TALK);
        case menu({
            english="Add Items2",
        }):
            message_Close();
            item_SetTableData(0, 0);
            switch ( ProcessSpecial(PROCESS_SPECIAL_ADD_TABLE_ITEM_TO_BAG, 0, 0) ) { }
            switch ( ProcessSpecial(PROCESS_SPECIAL_ADD_TABLE_ITEM_TO_STORAGE, 0, 0) ) {
                case 0:
                    message_Notice({
                        english="[CN]Could not receive [s_item:0]",
                    });
                    JumpCommon(CORO_END_TALK);
                default:
                    message_Notice({
                        english="[CN]Received [s_item:0]",
                    });
                    JumpCommon(CORO_END_TALK);
            }
            break;
        case menu({
            english="NPC Job",
        }):
            message_Close();
            switch ( ProcessSpecial(PROCESS_SPECIAL_INIT_RANDOM_NPC_JOBS, 0, 0) ) { }
            switch ( ProcessSpecial(PROCESS_SPECIAL_GET_RANDOM_NPC_JOB_STILL_AVAILABLE, 0, 0) ) {
                case 1:
                    back2_SetMode(7);
                    WaitSubScreen();
                    message_SetFace(ACTOR_RANDOM_REQUEST_NPC01, FACE_NORMAL, FACE_POS_STANDARD);
                    message_Talk({
                        english="Will you take the job?",
                    });
                    switch ( message_SwitchMenu(1, 2) ) {
                        case menu({
                            english="Yes",
                        }):
                            back2_SetMode(-1);
                            switch ( ProcessSpecial(PROCESS_SPECIAL_ACCEPT_RANDOM_NPC_JOB, 0, 0) ) {
                                case 1:
                                    message_Talk({
                                        english="Added to list.",
                                    });
                                    switch ( ProcessSpecial(PROCESS_SPECIAL_GET_RANDOM_NPC_JOB_TYPE, 0, 0) ) {
                                        case 10:
                                            switch ( ProcessSpecial(PROCESS_SPECIAL_GET_RANDOM_NPC_JOB_SUB_TYPE, 0, 0) ) {
                                                case 0:
                                                case 1:
                                                case 2:
                                                default:
                                                    break;
                                            }
                                            @label_21;
                                            JumpCommon(CORO_END_TALK);
                                        case 11:
                                            switch ( ProcessSpecial(PROCESS_SPECIAL_GET_RANDOM_NPC_JOB_SUB_TYPE, 0, 0) ) {
                                                case 1:
                                                case 2:
                                                case 3:
                                                default:
                                                    break;
                                            }
                                            @label_22;
                                            JumpCommon(CORO_END_TALK);
                                        default:
                                            JumpCommon(CORO_END_TALK);
                                    }
                                    break;
                                default:
                                    message_Talk({
                                        english="List is full.",
                                    });
                                    JumpCommon(CORO_END_TALK);
                            }
                            break;
                        case menu({
                            english="No",
                        }):
                        default:
                            back2_SetMode(-1);
                            message_Talk({
                                english="Good-bye.",
                            });
                            JumpCommon(CORO_END_TALK);
                    }
                    break;
                default:
                    message_Talk({
                        english="Job Distribution Complete",
                    });
                    JumpCommon(CORO_END_TALK);
            }
            break;
        case menu({
            english="Bottled Message Job",
        }):
            message_Close();
            switch ( ProcessSpecial(PROCESS_SPECIAL_INIT_RANDOM_NPC_JOBS, 1, 0) ) { }
            switch ( ProcessSpecial(PROCESS_SPECIAL_GET_RANDOM_NPC_JOB_STILL_AVAILABLE, 0, 0) ) {
                case 1:
                    message_Notice({
                        english="[CN]There was a Message in the Bottle.",
                    });
                    message_Close();
                    back2_SetMode(7);
                    WaitSubScreen();
                    message_Notice({
                        english="[CN]Receive this Message?",
                    });
                    switch ( message_SwitchMenu(1, 2) ) {
                        case menu({
                            english="Yes",
                        }):
                            back2_SetMode(-1);
                            switch ( ProcessSpecial(PROCESS_SPECIAL_ACCEPT_RANDOM_NPC_JOB, 0, 0) ) {
                                case 1:
                                    message_Notice({
                                        english="[CN]Added to list.",
                                    });
                                    JumpCommon(CORO_END_TALK);
                                default:
                                    message_Notice({
                                        english="[CN]List is full.",
                                    });
                                    JumpCommon(CORO_END_TALK);
                            }
                            break;
                        case menu({
                            english="No",
                        }):
                        default:
                            back2_SetMode(-1);
                            message_Notice({
                                english="[CN]Left that spot.",
                            });
                            JumpCommon(CORO_END_TALK);
                    }
                    break;
                default:
                    message_Notice({
                        english="[CN]The Bottle was empty.",
                    });
                    JumpCommon(CORO_END_TALK);
            }
            break;
        case menu({
            english="Release Jobs",
        }):
            $PERFORMANCE_PROGRESS_LIST[9] = 1;
            adventure_log = 3;
            $PERFORMANCE_PROGRESS_LIST[17] = 1;
            dungeon_mode(43) = DMODE_REQUEST;
            dungeon_mode(42) = DMODE_REQUEST;
            dungeon_mode(41) = DMODE_REQUEST;
            dungeon_mode(40) = DMODE_REQUEST;
            dungeon_mode(39) = DMODE_REQUEST;
            dungeon_mode(38) = DMODE_REQUEST;
            $PERFORMANCE_PROGRESS_LIST[16] = 1;
            $PERFORMANCE_PROGRESS_LIST[25] = 1;
            dungeon_mode(37) = DMODE_REQUEST;
            dungeon_mode(36) = DMODE_REQUEST;
            dungeon_mode(35) = DMODE_OPEN_AND_REQUEST;
            dungeon_mode(34) = DMODE_REQUEST;
            dungeon_mode(33) = DMODE_REQUEST;
            dungeon_mode(32) = DMODE_REQUEST;
            adventure_log = 2;
            $PERFORMANCE_PROGRESS_LIST[15] = 1;
            dungeon_mode(31) = DMODE_REQUEST;
            dungeon_mode(30) = DMODE_REQUEST;
            dungeon_mode(29) = DMODE_REQUEST;
            dungeon_mode(28) = DMODE_REQUEST;
            dungeon_mode(27) = DMODE_REQUEST;
            dungeon_mode(25) = DMODE_REQUEST;
            dungeon_mode(24) = DMODE_REQUEST;
            dungeon_mode(26) = DMODE_REQUEST;
            dungeon_mode(23) = DMODE_REQUEST;
            dungeon_mode(22) = DMODE_REQUEST;
            dungeon_mode(21) = DMODE_REQUEST;
            $PERFORMANCE_PROGRESS_LIST[28] = 1;
            dungeon_mode(20) = DMODE_OPEN_AND_REQUEST;
            dungeon_mode(19) = DMODE_REQUEST;
            dungeon_mode(18) = DMODE_REQUEST;
            dungeon_mode(17) = DMODE_OPEN_AND_REQUEST;
            $PERFORMANCE_PROGRESS_LIST[14] = 1;
            $PERFORMANCE_PROGRESS_LIST[30] = 1;
            dungeon_mode(16) = DMODE_REQUEST;
            dungeon_mode(15) = DMODE_REQUEST;
            dungeon_mode(14) = DMODE_REQUEST;
            $PERFORMANCE_PROGRESS_LIST[13] = 1;
            adventure_log = 1;
            dungeon_mode(13) = DMODE_REQUEST;
            dungeon_mode(12) = DMODE_OPEN_AND_REQUEST;
            dungeon_mode(11) = DMODE_REQUEST;
            dungeon_mode(10) = DMODE_OPEN_AND_REQUEST;
            dungeon_mode(9) = DMODE_REQUEST;
            dungeon_mode(8) = DMODE_OPEN_AND_REQUEST;
            $PERFORMANCE_PROGRESS_LIST[31] = 1;
            dungeon_mode(7) = DMODE_OPEN_AND_REQUEST;
            $PERFORMANCE_PROGRESS_LIST[29] = 1;
            dungeon_mode(6) = DMODE_OPEN_AND_REQUEST;
            $PERFORMANCE_PROGRESS_LIST[5] = 1;
            $PERFORMANCE_PROGRESS_LIST[8] = 1;
            adventure_log = 0;
            $PERFORMANCE_PROGRESS_LIST[27] = 1;
            $PERFORMANCE_PROGRESS_LIST[4] = 1;
            dungeon_mode(5) = DMODE_REQUEST;
            dungeon_mode(4) = DMODE_OPEN_AND_REQUEST;
            $PERFORMANCE_PROGRESS_LIST[3] = 1;
            $PERFORMANCE_PROGRESS_LIST[12] = 1;
            dungeon_mode(3) = DMODE_OPEN_AND_REQUEST;
            $PERFORMANCE_PROGRESS_LIST[1] = 1;
            $PERFORMANCE_PROGRESS_LIST[2] = 1;
            dungeon_mode(2) = DMODE_REQUEST;
            dungeon_mode(1) = DMODE_OPEN_AND_REQUEST;
            message_Notice({
                english="[CN]Unlocked a dungeon.",
            });
            JumpCommon(CORO_END_TALK);
        case menu({
            english="Cleared all Special Episodes",
        }):
            adventure_log = 1000;
            adventure_log = 1001;
            adventure_log = 1002;
            adventure_log = 1003;
            adventure_log = 1004;
            message_Notice({
                english="[CN]Cleared all Special Episodes.",
            });
            JumpCommon(CORO_END_TALK);
        default:
            message_Talk({
                english="I see.",
            });
            JumpCommon(CORO_END_TALK);
    }
}
