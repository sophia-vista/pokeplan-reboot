    WaitExecuteLives(ACTOR_NPC_TEST007);
    WaitExecuteLives(ACTOR_NPC_TEST009);
    WaitExecuteLives(ACTOR_NPC_TEST010);
    message_Talk({
        english="The Event Test is finished.",
    });
    message_Close();
    camera_Move2Default(1.0);
    supervision_RemoveActing(1);
    supervision_RemoveActing(2);
    supervision_Suspend(-2);
    end;
}

