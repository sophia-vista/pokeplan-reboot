
def 0 {
    debug_Print('acting_M01A03A');
    message_ResetActor();
    message_Talk({
        english="An Acting Test will be conducted.",
    });
    message_Close();
    supervision_Acting(0);
    supervision_Acting(1);
    supervision_Acting(2);
    camera_Move2PositionMark(1.0, Position<'m0', 65, 39.5>, Position<'m1', 61, 39.5>, Position<'m2', 61, 36.5>, Position<'m3', 66, 34.5>);
    Move2PositionMark<actor ACTOR_NPC_TEST007>(1.0, Position<'m4', 65, 39.5>, Position<'m5', 61, 39.5>, Position<'m6', 61, 36.5>, Position<'m7', 66, 34.5>);
