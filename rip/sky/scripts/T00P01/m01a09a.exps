    screen_FlushOut(1, 30, 1, 255, 0, 0);
    screen_FlushIn(1, 30, 1, 255, 0, 0);
    screen2_FlushOut(0, 30, 2, 255, 0, 0);
    screen_FlushOut(1, 30, 2, 255, 0, 0);
    screen2_FlushIn(0, 30, 2, 255, 0, 0);
    screen_FlushIn(1, 30, 2, 255, 0, 0);
    screen2_FlushOut(0, 30, 4, 0, 255, 0);
