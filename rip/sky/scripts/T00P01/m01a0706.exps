
def 0 {
    ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
    ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
    message_ResetActor();
    message_Talk({
        english="Do you need something?",
    });
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            message_Talk({
                english="Do you really need something from me?",
            });
            switch ( message_SwitchMenu(0, 1) ) {
                case menu({
                    english="Yes",
                }):
                default:
                    item_Set(0, 18, 0);
                    item_Set(1, 69, 0);
                    item_GetVariable(0, $ITEM_BACKUP);
                    item_SetVariable(2, $ITEM_BACKUP);
                    message_Talk({
                        english="[s_item:0] and [s_item:1]",
                    });
                    message_Talk({
                        english="[s_item:2]?",
                    });
                    message_Talk({
                        english="I can't help you with anything right now.",
                    });
                    JumpCommon(CORO_END_TALK);
                case menu({
                    english="No",
                }):
                    @label_1;
                    message_Talk({
                        english="I see...",
                    });
                    JumpCommon(CORO_END_TALK);
            }
            break;
        case menu({
            english="No",
        }):
            jump @label_1;
    }
}
