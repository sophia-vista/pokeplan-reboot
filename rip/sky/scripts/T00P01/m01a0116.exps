
def 0 {
    ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
    ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
    @label_19;
    message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
            An event will be activated.
            Which one would you like to see?
        """,
    });
    switch ( message_SwitchMenu(1, 1) ) {
        case menu({
            english="ACTING_TEST",
        }):
            @label_0;
            message_Talk({
                english="""
                    An Acting Test will be activated.
                    Which one would you like?
                """,
            });
            switch ( message_SwitchMenu(1, 1) ) {
                case menu({
                    english="M01A01A",
                }):
                    debug_Print('EXECUTE_T00P01_M01A01A');
                    message_Close();
                    supervision_ExecuteActing(LEVEL_T00P01, 'M01A01A', 0);
                    hold;
                case menu({
                    english="M01A02A",
                }):
                    debug_Print('EXECUTE_T00P01_M01A02A');
                    message_Close();
                    supervision_ExecuteActing(LEVEL_T00P01, 'M01A02A', 0);
                    hold;
                case menu({
                    english="M01A03A",
                }):
                    debug_Print('EXECUTE_T00P01_M01A03A');
                    message_Close();
                    supervision_ExecuteActing(LEVEL_T00P01, 'M01A03A', 0);
                    hold;
                case menu({
                    english="M01A04A",
                }):
                    debug_Print('EXECUTE_T00P01_M01A04A');
                    message_Close();
                    supervision_ExecuteActing(LEVEL_T00P01, 'M01A04A', 0);
                    hold;
                case menu({
                    english="M01A05A",
                }):
                    debug_Print('EXECUTE_T00P01_M01A05A');
                    message_Close();
                    supervision_ExecuteActing(LEVEL_T00P01, 'M01A05A', 0);
                    hold;
                case menu({
                    english="M01A06A",
                }):
                    debug_Print('EXECUTE_T00P01_M01A06A');
                    message_Close();
                    supervision_ExecuteActing(LEVEL_T00P01, 'M01A06A', 0);
                    hold;
                case menu({
                    english="M01A07A",
                }):
                    debug_Print('EXECUTE_T00P01_M01A07A');
                    message_Close();
                    supervision_ExecuteActing(LEVEL_T00P01, 'M01A07A', 0);
                    hold;
                case menu({
                    english="M01A08A",
                }):
                    debug_Print('EXECUTE_T00P01_M01A08A');
                    message_Close();
                    supervision_ExecuteActing(LEVEL_T00P01, 'M01A08A', 0);
                    hold;
                case menu({
                    english="M01A09A",
                }):
                    debug_Print('EXECUTE_T00P01_M01A09A');
                    message_Close();
                    supervision_ExecuteActing(LEVEL_T00P01, 'M01A09A', 0);
                    hold;
                case menu({
                    english="M01A10A",
                }):
                    debug_Print('EXECUTE_T00P01_M01A10A');
                    message_Close();
                    supervision_ExecuteActing(LEVEL_T00P01, 'M01A10A', 0);
                    hold;
                default:
                    jump @label_19;
            }
            break;
        case menu({
            english="STATION_TEST",
        }):
            message_Talk({
                english="""
                    A Station Test will be activated.
                    Which one would you like?
                """,
            });
            switch ( message_SwitchMenu(1, 1) ) {
                case menu({
                    english="STATION_01",
                }):
                    message_Close();
                    debug_Print('STATION_01');
                    supervision_Station(1);
                    JumpCommon(CORO_END_TALK);
                case menu({
                    english="STATION_02",
                }):
                    message_Close();
                    debug_Print('STATION_02');
                    supervision_Station(2);
                    JumpCommon(CORO_END_TALK);
                case menu({
                    english="REMOVE_01",
                }):
                    message_Close();
