                    dungeon_mode(28) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(29) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(30) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(31) = DMODE_REQUEST;
                    dungeon_mode(32) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(33) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(34) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(35) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(36) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(37) = DMODE_REQUEST;
                    dungeon_mode(38) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(39) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(40) = DMODE_REQUEST;
                    dungeon_mode(41) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(42) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(43) = DMODE_REQUEST;
                    dungeon_mode(44) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(45) = DMODE_REQUEST;
                    dungeon_mode(46) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(47) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(48) = DMODE_REQUEST;
                    dungeon_mode(49) = DMODE_REQUEST;
                    dungeon_mode(50) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(51) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(52) = DMODE_REQUEST;
                    dungeon_mode(53) = DMODE_REQUEST;
                    dungeon_mode(54) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(55) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(56) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(57) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(58) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(59) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(60) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(61) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(62) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(63) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(64) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(65) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(66) = DMODE_REQUEST;
                    dungeon_mode(67) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(68) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(69) = DMODE_REQUEST;
                    JumpCommon(CORO_END_TALK);
                case menu({
                    english="TYPE1",
                }):
                    dungeon_mode(0) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(1) = DMODE_OPEN_AND_REQUEST;
                    dungeon_mode(2) = DMODE_REQUEST;
                    dungeon_mode(3) = DMODE_OPEN;
                    dungeon_mode(4) = DMODE_CLOSED;
                    dungeon_mode(5) = DMODE_CLOSED;
                    JumpCommon(CORO_END_TALK);
                case menu({
                    english="D006B_CLOSE",
                }):
                    dungeon_mode(212) = DMODE_CLOSED;
                    JumpCommon(CORO_END_TALK);
                case menu({
                    english="D006B_SCENARIO",
                }):
                    dungeon_mode(212) = DMODE_OPEN;
                    JumpCommon(CORO_END_TALK);
                default:
                    jump @label_19;
            }
            break;
        case menu({
            english="VISUAL_TEST",
        }):
            @label_4;
            message_Talk({
                english="""
                    A Visual Test will be activated.
                    Which one would you like?
                """,
            });
            switch ( message_SwitchMenu(1, 1) ) {
                case menu({
                    english="NEXT",
                }):
                    message_Talk({
                        english="""
                            A Visual Test will be activated.
                            Which one would you like?
                        """,
                    });
                    switch ( message_SwitchMenu(1, 1) ) {
                        case menu({
                            english="NEXT",
                        }):
                            message_Talk({
                                english="""
                                    A Visual Test will be activated.
                                    Which one would you like?
                                """,
                            });
                            switch ( message_SwitchMenu(1, 1) ) {
                                case menu({
                                    english="NEXT",
                                }):
                                    jump @label_4;
                                case menu({
                                    english="V00P03_M01A01A",
                                }):
                                    message_Close();
                                    screen_FadeOut(1, 30);
                                    supervision_ExecuteActing(LEVEL_V00P03, 'M01A01A', 0);
                                    hold;
                                default:
                                    jump @label_19;
                            }
                            break;
                        case menu({
                            english="V00P02_M01A01A",
                        }):
                            message_Close();
                            screen_FadeOut(1, 30);
                            supervision_ExecuteActing(LEVEL_V00P02, 'M01A01A', 0);
                            hold;
                        case menu({
                            english="V00P02_M01A02A",
                        }):
                            message_Close();
                            screen_FadeOut(1, 30);
                            supervision_ExecuteActing(LEVEL_V00P02, 'M01A02A', 0);
                            hold;
                        case menu({
                            english="V00P02_M01A03A",
                        }):
                            message_Close();
                            screen_FadeOut(1, 30);
                            supervision_ExecuteActing(LEVEL_V00P02, 'M01A03A', 0);
                            hold;
                        case menu({
                            english="V00P02_M01A04A",
                        }):
                            message_Close();
                            screen_FadeOut(1, 30);
                            supervision_ExecuteActing(LEVEL_V00P02, 'M01A04A', 0);
                            hold;
                        case menu({
                            english="V00P02_M01A05A",
                        }):
                            message_Close();
                            screen_FadeOut(1, 30);
                            supervision_ExecuteActing(LEVEL_V00P02, 'M01A05A', 0);
                            hold;
                        case menu({
                            english="V00P02_M01A06A",
                        }):
                            message_Close();
                            screen_FadeOut(1, 30);
                            supervision_ExecuteActing(LEVEL_V00P02, 'M01A06A', 0);
                            hold;
                        default:
                            jump @label_19;
                    }
                    break;
                case menu({
                    english="V00P01_M01A01A",
                }):
                    message_Close();
                    screen_FadeOut(1, 30);
                    supervision_ExecuteActing(LEVEL_V00P01, 'M01A01A', 0);
                    hold;
                case menu({
                    english="V00P01_M01A02A",
                }):
                    message_Close();
                    screen_FadeOut(1, 30);
                    supervision_ExecuteActing(LEVEL_V00P01, 'M01A02A', 0);
                    hold;
                default:
                    jump @label_19;
            }
            break;
        case menu({
            english="PARTY_TEST",
        }):
            @label_5;
            message_Talk({
                english="""
                    A Party Test will be activated.
                    Which one would you like?
                """,
            });
            switch ( message_SwitchMenu(1, 1) ) {
                case menu({
                    english="NEXT",
                }):
                    message_Talk({
                        english="""
                            A Party Test will be activated for adding
                            a new team member.
                            Which one would you like?
                        """,
                    });
                    switch ( message_SwitchMenu(1, 1) ) {
                        case menu({
                            english="NEXT",
                        }):
                            jump @label_5;
                        case menu({
                            english="CHECK_LIVES_EXIST",
                        }):
                            message_Close();
                            switch ( ProcessSpecial(PROCESS_SPECIAL_IS_RECURITABLE_IN_TEAM, 16, 0) ) {
                                case 0:
                                    message_Notice({
                                        english="""
                                            
                                            [CN][c_name:NPC_MANAFI] isn't in the team.
                                        """,
                                    });
                                    JumpCommon(CORO_END_TALK);
                                default:
                                    message_Notice({
                                        english="""
                                            
                                            [CN][c_name:NPC_MANAFI] is in the team.
                                        """,
                                    });
                                    JumpCommon(CORO_END_TALK);
                            }
                            break;
                        case menu({
                            english="CHECK_LIVES_LEVEL",
                        }):
                            message_Close();
                            switch ( ProcessSpecial(PROCESS_SPECIAL_GET_RECURITABLE_CURRENT_LEVEL, 16, 0) ) {
                                case <= 0:
                                default:
                                    message_Notice({
                                        english="""
                                            
                                            [CN][c_name:NPC_MANAFI] is not here.
                                        """,
                                    });
                                    JumpCommon(CORO_END_TALK);
                                case 1:
                                    message_Notice({
                                        english="""
                                            
                                            [CN][c_name:NPC_MANAFI] is Level 1.
                                        """,
                                    });
                                    JumpCommon(CORO_END_TALK);
                                case >= 2:
                                    message_Notice({
                                        english="""
                                            
                                            [CN][c_name:NPC_MANAFI] is at least Level 2.
                                        """,
                                    });
                                    JumpCommon(CORO_END_TALK);
                            }
                            break;
                        case menu({
                            english="JOIN_LIVES",
                        }):
                            message_Close();
                            switch ( ProcessSpecial(PROCESS_SPECIAL_ADD_RECRUITABLE_TO_TEAM, 16, 0) ) {
                                case 0:
                                    message_Notice({
                                        english="""
                                            
                                            [CN]
                                        """,
                                    });
                                    JumpCommon(CORO_END_TALK);
                                default:
                                    message_Notice({
                                        english="""
                                            
                                            [CN][c_name:NPC_NEW_FRIEND] joined the team.
                                        """,
                                    });
                                    JumpCommon(CORO_END_TALK);
                            }
                            break;
                        case menu({
                            english="CHECK_HERO",
                        }):
                            message_Close();
                            switch ( ProcessSpecial(PROCESS_SPECIAL_GET_HERO_KIND, 0, 0) ) {
                                case 0:
                                    message_Notice({
                                        english="It's Torchic.",
                                    });
                                    JumpCommon(CORO_END_TALK);
                                case 1:
                                    message_Notice({
                                        english="It's Charmander.",
                                    });
                                    JumpCommon(CORO_END_TALK);
                                default:
                                    message_Notice({
                                        english="It's something else.",
                                    });
                                    JumpCommon(CORO_END_TALK);
                            }
                            break;
                        case menu({
                            english="CHECK_PARTNER",
                        }):
                            message_Close();
                            switch ( ProcessSpecial(PROCESS_SPECIAL_GET_PARTNER_KIND, 0, 0) ) {
                                case 0:
                                    message_Notice({
                                        english="It's Torchic.",
                                    });
                                    JumpCommon(CORO_END_TALK);
                                case 1:
                                    message_Notice({
                                        english="It's Charmander.",
                                    });
                                    JumpCommon(CORO_END_TALK);
                                default:
                                    message_Notice({
                                        english="It's something else.",
                                    });
                                    JumpCommon(CORO_END_TALK);
                            }
                            break;
                        default:
                            jump @label_19;
                    }
                    break;
                case menu({
                    english="PLAYER_HERO",
                }):
                    message_Close();
                    $PLAYER_KIND = 0;
                    JumpCommon(CORO_END_TALK);
                case menu({
                    english="PLAYER_APPOINT",
                }):
                    message_Close();
                    $PLAYER_KIND = 3;
                    JumpCommon(CORO_END_TALK);
                case menu({
                    english="ATTENDANT1_NONE",
                }):
                    message_Close();
                    $ATTENDANT1_KIND = 0;
                    JumpCommon(CORO_END_TALK);
                case menu({
                    english="ATTENDANT1_PARTNER",
                }):
                    message_Close();
                    $ATTENDANT1_KIND = 2;
                    JumpCommon(CORO_END_TALK);
                case menu({
                    english="ATTENDANT2_NONE",
                }):
                    message_Close();
                    $ATTENDANT2_KIND = 0;
                    JumpCommon(CORO_END_TALK);
                case menu({
                    english="ATTENDANT2_MANAFI",
                }):
                    message_Close();
                    $ATTENDANT2_KIND = 10;
                    JumpCommon(CORO_END_TALK);
                default:
                    jump @label_19;
            }
            break;
        case menu({
            english="WORLD_MAP",
        }):
            message_Close();
            screen_FadeOut(1, 30);
            supervision_ExecuteActing(LEVEL_V00P02, 'M01A06A', 0);
            hold;
        case menu({
            english="KEY_WAIT",
        }):
            message_Close();
            debug_Print('Talk1');
            switch ( ProcessSpecial(PROCESS_SPECIAL_KEY_WAIT_INIT, 0, 0) ) { }
            switch ( ProcessSpecial(PROCESS_SPECIAL_KEY_WAIT_PRESS, 0, 0) ) { }
            debug_Print('Talk2');
            switch ( ProcessSpecial(PROCESS_SPECIAL_KEY_WAIT_INIT, 160, 0) ) { }
            @label_95;
            forever {
                Wait(1);
                switch ( ProcessSpecial(PROCESS_SPECIAL_KEY_WAIT_CHECK, 0, 0) ) {
                    case 0:
                        continue;  // may be redundant
                        break;
                    default:
                        break_loop;
                        break;
                }
            }
            debug_Print('Talk3');
            jump @label_19;
        case menu({
            english="MIST_FADE",
        }):
            back_SetWeather(11);
            Wait(120);
            back_SetEffect(17, 240);
            Wait(240);
            JumpCommon(CORO_END_TALK);
        default:
            message_Talk({
                english="I see...",
            });
            JumpCommon(CORO_END_TALK);
    }
}
