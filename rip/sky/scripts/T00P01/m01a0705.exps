
def 0 {
    ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
    ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
    message_ResetActor();
    message_Talk({
        english="Who are you?",
    });
    message_EmptyActor();
    message_Talk({
        english="[STS]Everyone:[STE] We are...",
    });
    message_Talk({
        english="[STS]Everyone:[STE] [hero] and [partner]!",
    });
    message_KeyWait();
    Wait(60);
    message_Close();
    message_SetFaceOnly(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="[c_name:PLAYER]",
    });
    message_Close();
    Wait(20);
    message_SetFace(ACTOR_TALK_MAIN, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchMonologue ($HERO_TALK_KIND) {
        case 4:
            {
                english="Male",
            }
        case 5:
            {
                english="Female",
            }
        default:
            {
                english="Mystery",
            }
    }
    Wait(20);
    message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="Male",
            }
        case 2:
            {
                english="Yo!",
            }
        default:
            {
                english="Hey!",
            }
    }
    message_Close();
    message_Talk({
        english="Good-bye.",
    });
    message_Close();
    message_Talk({
        english="Good-bye.",
    });
    Wait(30);
    message_CloseEnforce();
    JumpCommon(CORO_END_TALK);
}
