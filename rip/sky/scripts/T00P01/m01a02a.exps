
def 0 {
    debug_Print('acting_M01A02A');
    supervision_Acting(0);
    message_ResetActor();
    message_Talk({
        english="An Event Test is under way.",
    });
    message_Talk({
        english="A Placement Test will be conducted.",
    });
    message_Close();
    Wait(60);
    message_Talk({
        english="Place Sector 1",
    });
    message_Close();
    Wait(30);
    supervision_Acting(1);
    message_Talk({
        english="Place Sector 2",
    });
    message_Close();
    supervision_Acting(2);
    Wait(30);
    message_Talk({
        english="Remove Sector 1",
    });
    message_Close();
    supervision_RemoveActing(1);
    Wait(30);
    message_Talk({
        english="Remove Sector 2",
    });
    message_Close();
    supervision_RemoveActing(2);
    Wait(30);
    message_Talk({
        english="Place Date Indicator on Sector 1",
    });
    message_Close();
    Wait(30);
    supervision_ActingInvisible(1);
    message_Talk({
        english="Place Date Indicator on Sector 2",
    });
    message_Close();
    supervision_ActingInvisible(2);
    Wait(30);
    message_Talk({
        english="Label Request",
    });
    message_Close();
    ResetOutputAttribute<actor ACTOR_NPC_TEST009>(128);
    SetupOutputAttributeAndAnimation<actor ACTOR_NPC_TEST010>(4, 128, 11);
    Wait(30);
    message_Talk({
        english="Remove",
    });
    message_Close();
    supervision_RemoveActing(1);
    supervision_RemoveActing(2);
    Wait(30);
    message_Talk({
        english="The Event Test is finished.",
    });
    message_Close();
    supervision_Suspend(-2);
    end;
}
