                english="Which dungeon will you enter?  A",
            });
            message_Close();
            @label_3;
            switch ( main_EnterAdventure(-1, 30) ) {
                case 1:
                    @switch1_24;
                    message_Close();
                    supervision_Suspend(-2);
                    end;
                case 0:
                case 19:
                    @label_5;
                    message_Close();
                    switch ( main_EnterAdventure(251, 30) ) { }
