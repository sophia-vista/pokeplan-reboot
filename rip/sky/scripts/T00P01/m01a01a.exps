
def 0 {
    debug_Print('acting_M01A01A');
    with (actor ACTOR_PLAYER) {
        hold;
    }
    with (actor ACTOR_ATTENDANT1) {
        hold;
    }
    screen_FadeChange(1, 30, 256, 128);
    screen_FadeChange(1, 30, 128, 256);
    screen_FadeOut(1, 30);
    back_SetGround(LEVEL_T00P01);
    supervision_LoadStation(LEVEL_T00P01, 'M01A01');
    supervision_StationCommon(0);
    supervision_Station(3);
    supervision_Acting(0);
    with (actor ACTOR_PLAYER) {
        hold;
    }
    with (actor ACTOR_ATTENDANT1) {
        hold;
    }
    screen_FadeIn(1, 30);
    SetAnimation<actor ACTOR_PLAYER>(76);
    Wait(60);
    SetAnimation<actor ACTOR_PLAYER>(63);
    WaitAnimation<actor ACTOR_PLAYER>();
    Wait(30);
    SetAnimation<actor ACTOR_PLAYER>(76);
    Wait(20);
    SetEffect<actor ACTOR_PLAYER>(EFFECT_ANGRY, 3);
    Wait(120);
    SetAnimation<actor ACTOR_PLAYER>(5);
    Wait(60);
    SetEffect<actor ACTOR_PLAYER>(EFFECT_LAUGHING, 3);
    Wait(120);
    SetEffect<actor ACTOR_PLAYER>(EFFECT_NONE, 3);
    SetAnimation<actor ACTOR_PLAYER>(2);
    message_ResetActor();
    message_Talk({
        english="""
            It sounds like the natural disasters were
            interfering with our ability to evolve.
        """,
    });
    message_Talk({
        english="""
             I think the timing's right.[K]
            I should think about evolving...
        """,
    });
    message_Close();
    screen_FadeOut(1, 30);
