            message_Talk({
                english="""
                     Welcome to [CS:K]Marowak[CR] Dojo.[K]
                    Train yourselves to become better explorers!
                """,
            });
            switch ( message_SwitchMenu(1, 1) ) {
                case menu({
                    english="Info",
                }):
                    @label_124;
                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                    message_SetFace(ACTOR_NPC_GARAGARA, FACE_NORMAL, FACE_POS_STANDARD);
                    message_Talk({
                        english="""
                             The entrance to the training
