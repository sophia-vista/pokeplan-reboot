
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_T01P03A);
    if ( scn($SCENARIO_MAIN) < [29, 5] ) {
        @label_0;
        supervision_StationCommon(5);
        supervision_StationCommon(0);
        supervision_Acting(0);
        camera_SetMyself<performer 0>();
        if ( not debug ) {
            @label_1;
            message_Close();
            switch ( $GROUND_START_MODE ) {
                case 8:
                default:
                    switch ( $DUNGEON_ENTER_INDEX ) {
                        case 191:
                        case 192:
                        case 193:
                            if ( $SCENARIO_MAIN_BIT_FLAG[28] ) {
                                @label_6;
                                message_Close();
                                screen_FadeIn(1, 30);
                                Wait(30);
                                se_Play(8968);
                                SetEffect<actor ACTOR_NPC_GARAGARA>(EFFECT_SHOCKED, 3);
                                WaitEffect<actor ACTOR_NPC_GARAGARA>();
                                WaitExecuteLives(ACTOR_NPC_GARAGARA);
                                message_SetFace(ACTOR_NPC_GARAGARA, FACE_NORMAL, FACE_POS_TOP_C_FACER);
                                message_Talk({
                                    english=" Oh my![K] It's you again!",
                                });
                                message_Talk({
                                    english="""
                                         You've made it through that
                                        terrible place again!
                                    """,
                                });
                                ExecuteCommon<actor ACTOR_NPC_GARAGARA>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
                                WaitExecuteLives(ACTOR_NPC_GARAGARA);
                                message_KeyWait();
                                bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD_REMIX, 0, 256);
                                message_Talk({
                                    english="""
                                         Frankly, what you've managed to
                                        do defies belief.[K] You're something else.
                                    """,
                                });
                                message_Talk({
                                    english="""
                                         You're so exceptional that I...[K]
                                        I am inspired to be braver in all things![K]
                                        It's all thanks to you!
                                    """,
                                });
                                message_Talk({
                                    english="""
                                         I'll try harder![K] I expect you to
                                        do the same.[K] We'll all try harder!
                                    """,
                                });
                                message_Close();
                                end;
                            } else {
                                switch ( $DUNGEON_ENTER_INDEX ) {
                                    case 191:
                                    default:
                                        break;
                                }
                                @label_23;
                                $SCENARIO_MAIN_BIT_FLAG[25] = 0;
                                @label_24;
                                if ( $SCENARIO_MAIN_BIT_FLAG[25] ) {
                                    jump @label_6;
                                } else {
                                    @label_7;
                                    message_Close();
                                    $SCENARIO_MAIN_BIT_FLAG[28] = 1;
                                    screen_FadeIn(1, 30);
                                    Wait(30);
                                    se_Play(8968);
                                    SetEffect<actor ACTOR_NPC_GARAGARA>(EFFECT_SHOCKED, 3);
                                    WaitEffect<actor ACTOR_NPC_GARAGARA>();
                                    WaitExecuteLives(ACTOR_NPC_GARAGARA);
                                    message_SetFace(ACTOR_NPC_GARAGARA, FACE_NORMAL, FACE_POS_TOP_C_FACER);
                                    message_Talk({
                                        english=" Oh my![K] It's you!",
                                    });
                                    message_Talk({
                                        english="""
                                             Finally...[K] Finally...[K] You finally
                                            conquered that awful place!
                                        """,
                                    });
                                    ExecuteCommon<actor ACTOR_NPC_GARAGARA>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
                                    WaitExecuteLives(ACTOR_NPC_GARAGARA);
                                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                    bgm_PlayFadeIn(BGM_PERFECT_SENTRY_DUTY, 0, 256);
                                    WaitBgm(BGM_PERFECT_SENTRY_DUTY);
                                    bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD_REMIX, 0, 256);
                                    message_Talk({
                                        english="""
                                             It's incredible![K] It's incredibly
                                            incredible!
                                        """,
                                    });
                                    SetEffect<actor ACTOR_NPC_GARAGARA>(EFFECT_SHOCKED, 3);
                                    ExecuteCommon<actor ACTOR_NPC_GARAGARA>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
                                    WaitExecuteLives(ACTOR_NPC_GARAGARA);
                                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                    se_Play(8972);
                                    SetEffect<actor ACTOR_NPC_GARAGARA>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
                                    WaitEffect<actor ACTOR_NPC_GARAGARA>();
                                    WaitExecuteLives(ACTOR_NPC_GARAGARA);
                                    message_Talk({
                                        english="""
                                             Sniffle...[K] I'm getting all
                                            emotional over this...
                                        """,
                                    });
                                    message_Talk({
                                        english="""
                                             You've managed to inspire
                                            someone like me...[K] Thank you so very much...
                                        """,
                                    });
                                    message_Talk({
                                        english="""
                                             And this is my thanks...[K] It's my
                                            show of gratitude!
                                        """,
                                    });
                                    message_Talk({
                                        english="""
                                             It's my grandpa's treasure![K]
                                            Treat it with care!
                                        """,
                                    });
                                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                    me_Play(9);
                                    message_Mail({
                                        english="""
                                            [CN] Fantastic! [hero] obtained a
                                            [CN][CS:I]Brown Bow[CR]!
                                        """,
                                    });
                                    WaitMe(9);
                                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                    item_Set(0, 429, 0);
                                    switch ( message_Menu(MENU_GIVE_ITEM2) ) { }
                                    Wait(10);
                                    message_SetFace(ACTOR_NPC_GARAGARA, FACE_NORMAL, FACE_POS_TOP_C_FACER);
                                    message_Talk({
                                        english="""
                                             If he were around to hear that
                                            an exploration team conquered that
                                            awful place...
                                        """,
                                    });
                                    message_Talk({
                                        english="""
                                             Grandpa would have been
                                            overjoyed, that's for certain!
                                        """,
                                    });
                                    message_Close();
                                    end;
                                }
                            }
                            break;
                        default:
                            if ( $SCENARIO_MAIN_BIT_FLAG[24] ) {
                                @label_3;
                                message_Close();
                                screen_FadeIn(1, 30);
                                Wait(30);
                                se_Play(8967);
                                SetEffect<actor ACTOR_NPC_GARAGARA>(EFFECT_EXCLAMATION_MARK, 3);
                                WaitEffect<actor ACTOR_NPC_GARAGARA>();
                                WaitExecuteLives(ACTOR_NPC_GARAGARA);
                                message_SetFace(ACTOR_NPC_GARAGARA, FACE_NORMAL, FACE_POS_TOP_C_FACER);
                                message_Talk({
                                    english=" Oh![K] You've completed it!",
                                });
                                message_Talk({
                                    english=" That's good work, you two!",
                                });
                                ExecuteCommon<actor ACTOR_NPC_GARAGARA>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
                                WaitExecuteLives(ACTOR_NPC_GARAGARA);
                                message_KeyWait();
                                bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD_REMIX, 0, 256);
                                message_Talk({
                                    english="""
                                         But don't get too comfortable!
                                        Train more! Become more powerful!
                                    """,
                                });
                                message_Talk({
                                    english="""
                                         I'll try harder![K] I expect you to
                                        do the same.[K] We'll all try harder!
                                    """,
                                });
                                message_Close();
                                end;
                            } else {
                                switch ( $DUNGEON_ENTER_INDEX ) {
                                    case 180:
                                        $SCENARIO_MAIN_BIT_FLAG[14] = 0;
                                        @label_22;
                                        if ( $SCENARIO_MAIN_BIT_FLAG[14] || $SCENARIO_MAIN_BIT_FLAG[15] || $SCENARIO_MAIN_BIT_FLAG[16] || $SCENARIO_MAIN_BIT_FLAG[17] || $SCENARIO_MAIN_BIT_FLAG[18] || $SCENARIO_MAIN_BIT_FLAG[19] || $SCENARIO_MAIN_BIT_FLAG[20] || $SCENARIO_MAIN_BIT_FLAG[21] || $SCENARIO_MAIN_BIT_FLAG[22] || $SCENARIO_MAIN_BIT_FLAG[23] ) {
                                            jump @label_3;
                                        } else {
                                            @label_4;
                                            message_Close();
                                            $SCENARIO_MAIN_BIT_FLAG[24] = 1;
                                            $PERFORMANCE_PROGRESS_LIST[11] = 1;
                                            adventure_log = 7;
                                            screen_FadeIn(1, 30);
                                            Wait(30);
                                            se_Play(8967);
                                            SetEffect<actor ACTOR_NPC_GARAGARA>(EFFECT_EXCLAMATION_MARK, 3);
                                            WaitEffect<actor ACTOR_NPC_GARAGARA>();
                                            WaitExecuteLives(ACTOR_NPC_GARAGARA);
                                            message_SetFace(ACTOR_NPC_GARAGARA, FACE_NORMAL, FACE_POS_TOP_C_FACER);
                                            message_Talk({
                                                english=" Oh![K] You've completed it, then!",
                                            });
                                            message_Talk({
                                                english=" Not just that...",
                                            });
                                            message_Talk({
                                                english="""
                                                     You've cleared all the training
                                                    mazes![K] I'm blazed and amazed!
                                                """,
                                            });
                                            se_Play(8968);
                                            SetEffect<actor ACTOR_NPC_GARAGARA>(EFFECT_SHOCKED, 3);
                                            ExecuteCommon<actor ACTOR_NPC_GARAGARA>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
                                            WaitExecuteLives(ACTOR_NPC_GARAGARA);
                                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                            bgm_PlayFadeIn(BGM_PERFECT_SENTRY_DUTY, 0, 256);
                                            WaitBgm(BGM_PERFECT_SENTRY_DUTY);
                                            bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD_REMIX, 0, 256);
                                            message_Talk({
                                                english="""
                                                     Wow...[K] You've stomped all over
                                                    my dojo!
                                                """,
                                            });
                                            message_Talk({
                                                english="""
                                                     For such a thorough stomping,
                                                    you deserve a trophy of sorts...[K] Take the
                                                    dojo's sign...[K] No, that wouldn't do.
                                                """,
                                            });
                                            message_Talk({
                                                english="""
                                                     To begin with, the dojo doesn't
                                                    have a sign. Instead, I'll give you this!
                                                """,
                                            });
                                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                            me_Play(4);
                                            message_Mail({
                                                english="""
                                                    [CN] Excellent! [hero] obtained a
                                                    [CN][CS:I]Joy Seed[CR]!
                                                """,
                                            });
                                            WaitMe(4);
                                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                            item_Set(0, 89, 0);
                                            switch ( message_Menu(MENU_GIVE_ITEM2) ) { }
                                            Wait(10);
                                            message_SetFace(ACTOR_NPC_GARAGARA, FACE_NORMAL, FACE_POS_TOP_C_FACER);
                                            message_Talk({
                                                english="""
                                                     That's my personal treasure![K]
                                                    You're more than welcome to it!
                                                """,
                                            });
                                            message_Talk({
                                                english="""
                                                     But don't let this be the end!
                                                    You'll keep training here, won't you?
                                                """,
                                            });
                                            message_Close();
                                            end;
                                        }
                                        break;
                                    case 181:
                                        $SCENARIO_MAIN_BIT_FLAG[15] = 0;
                                        jump @label_22;
                                    case 182:
                                        $SCENARIO_MAIN_BIT_FLAG[16] = 0;
                                        jump @label_22;
                                    case 183:
                                        $SCENARIO_MAIN_BIT_FLAG[17] = 0;
                                        jump @label_22;
                                    case 184:
                                        $SCENARIO_MAIN_BIT_FLAG[18] = 0;
                                        jump @label_22;
                                    case 185:
                                        $SCENARIO_MAIN_BIT_FLAG[19] = 0;
                                        jump @label_22;
                                    case 186:
                                        $SCENARIO_MAIN_BIT_FLAG[20] = 0;
                                        jump @label_22;
                                    case 187:
                                        $SCENARIO_MAIN_BIT_FLAG[21] = 0;
                                        jump @label_22;
                                    case 188:
                                        $SCENARIO_MAIN_BIT_FLAG[22] = 0;
                                        jump @label_22;
                                    case 189:
                                        $SCENARIO_MAIN_BIT_FLAG[23] = 0;
                                        jump @label_22;
                                    default:
                                        jump @label_22;
                                }
                            }
                            break;
                    }
                    break;
                case 9:
                case 10:
                case 11:
                    switch ( $DUNGEON_ENTER_INDEX ) {
                        case 191:
                        case 192:
                        case 193:
                            @label_8;
                            message_Close();
                            screen_FadeIn(1, 30);
                            Wait(30);
                            se_Play(8972);
                            SetEffect<actor ACTOR_NPC_GARAGARA>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
                            WaitEffect<actor ACTOR_NPC_GARAGARA>();
                            WaitExecuteLives(ACTOR_NPC_GARAGARA);
                            message_SetFace(ACTOR_NPC_GARAGARA, FACE_NORMAL, FACE_POS_TOP_C_FACER);
                            message_Talk({
                                english=" Ack![K] Couldn't get through...",
                            });
                            message_Talk({
                                english="""
                                     Well, didn't I say?[K] You can only
                                    blame yourself for going to a place that awful.
                                """,
                            });
                            message_Talk({
                                english="""
                                     You should learn from that and
                                    never go back there!
                                """,
                            });
                            message_Close();
                            bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD_REMIX, 0, 256);
                            end;
                        default:
                            @label_5;
                            message_Close();
                            screen_FadeIn(1, 30);
                            Wait(30);
                            se_Play(8972);
                            SetEffect<actor ACTOR_NPC_GARAGARA>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
                            WaitEffect<actor ACTOR_NPC_GARAGARA>();
                            WaitExecuteLives(ACTOR_NPC_GARAGARA);
                            message_SetFace(ACTOR_NPC_GARAGARA, FACE_NORMAL, FACE_POS_TOP_C_FACER);
                            message_Talk({
                                english=" Ack![K] You couldn't get through...",
                            });
                            message_Talk({
                                english="""
                                     But one must try and try again
                                    in the face of failure...
                                """,
                            });
                            message_Talk({
                                english=" That's how everyone grows up!",
                            });
                            message_Talk({
                                english="""
                                     I'll try harder![K] I expect you to
                                    do the same.[K] We'll all try harder!
                                """,
                            });
                            ExecuteCommon<actor ACTOR_NPC_GARAGARA>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
                            WaitExecuteLives(ACTOR_NPC_GARAGARA);
                            message_Close();
                            bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD_REMIX, 0, 256);
                            end;
                    }
                    break;
            }
        } else {
            message_Notice({
                english="""
                    [M:D2][CS:C]Debug: What would
                    you like to do?[CR]
                """,
            });
            switch ( message_SwitchMenu(0, 1) ) {
                case menu({
                    english="Trust your own luck.",
                }):
                    jump @label_1;
                case menu({
                    english="Cheat.",
                }):
                default:
                    message_Close();
                    message_Notice({
                        english="""
                            [M:D2][CS:C]Debug: What's your
                            choice?[CR]
                        """,
                    });
                    switch ( message_SwitchMenu(0, 1) ) {
                        case menu({
                            english="Success.",
                        }):
                            jump @label_3;
                        case menu({
                            english="All success.",
                        }):
                            jump @label_4;
                        case menu({
                            english="Failure.",
                        }):
                            jump @label_5;
                        case menu({
                            english="Success on legend.",
                        }):
                            jump @label_6;
                        case menu({
                            english="Success on all legends.",
                        }):
                            jump @label_7;
                        case menu({
                            english="Failure on legend.",
                        }):
                            jump @label_8;
                        default:
                            jump @label_1;
                    }
                    break;
            }
        }
    } else {
        back_ChangeGround(LEVEL_T01P03A2);
        supervision_StationCommon(3);
        jump @label_0;
    }
}
