
def 0 {
    if ( scn($SCENARIO_SIDE) >= [40, 7] ) {
        @label_0;
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        message_SetFace(ACTOR_NPC_PERAPPU, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 The Guildmaster gave you this
                opportunity!
            """,
        });
        message_Talk({
            english=" Do your best!",
        });
        message_Close();
        @label_3;
        JumpCommon(CORO_END_TALK);
    } elseif ( scn($SCENARIO_SIDE) >= [40, 3] || scn($SCENARIO_SIDE) >= [40, 2] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        message_SetFace(ACTOR_NPC_PERAPPU, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english=" ......",
        });
        message_Talk({
            english="""
                 Your request for a day off is
                granted...[K]but...
            """,
        });
        message_Talk({
            english="""
                 Don't cause any trouble for
                other teams, OK?
            """,
        });
        message_Close();
        jump @label_3;
    } else {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        message_SetFace(ACTOR_NPC_PERAPPU, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english=" About the chore I mentioned...",
        });
        message_Talk({
            english="""
                 Could you head over to [CS:K]Kecleon[CR]
                Market and find out how many [CS:I]Oran Berries[CR]
                they have for sale? ♪
            """,
        });
        message_Talk({
            english=" I'll leave you to it! ♪",
        });
        message_Close();
        jump @label_3;
    }
}
