        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        SetAnimation<actor ACTOR_ATTENDANT1>(2);
        Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_KIMAWARI);
        message_SetFace(ACTOR_NPC_KIMAWARI, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 The expedition will be a very
                long journey.
            """,
        });
        message_Talk({
            english="""
                 It will be even harder if you
                don't take the right supplies.
            """,
        });
        message_Talk({
            english="""
                 We all should get properly
                stocked up before we go see [CS:N]Chatot[CR].
            """,
        });
        message_Close();
        jump @label_130;
    } elseif ( scn($SCENARIO_MAIN) >= [8, 7] || scn($SCENARIO_MAIN) >= [8, 6] || scn($SCENARIO_MAIN) >= [8, 5] || scn($SCENARIO_MAIN) >= [8, 3] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        SetAnimation<actor ACTOR_ATTENDANT1>(2);
        Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_KIMAWARI);
        message_SetFace(ACTOR_NPC_KIMAWARI, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 The members haven't been
                chosen yet!
            """,
        });
        message_Talk({
            english=" We must never give up! ♪",
        });
        message_Close();
        jump @label_130;
    } elseif ( scn($SCENARIO_MAIN) >= [8, 2] || scn($SCENARIO_MAIN) >= [8, 1] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        SetAnimation<actor ACTOR_ATTENDANT1>(2);
        Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_KIMAWARI);
        message_SetFace(ACTOR_NPC_KIMAWARI, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 Everyone's quite excited about
                the upcoming expedition. Eek!
            """,
        });
        message_Talk({
            english="""
                 We all should work hard so we
                get chosen for the expedition!
            """,
        });
        message_Close();
        jump @label_130;
    } elseif ( scn($SCENARIO_MAIN) >= [7, 6] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        SetAnimation<actor ACTOR_ATTENDANT1>(2);
        Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_KIMAWARI);
        message_SetFace(ACTOR_NPC_KIMAWARI, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 Well...complaining about the
                smell doesn't help.
            """,
        });
        message_Close();
        jump @label_130;
    } elseif ( scn($SCENARIO_MAIN) >= [7, 3] || scn($SCENARIO_MAIN) >= [7, 2] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        SetAnimation<actor ACTOR_ATTENDANT1>(2);
        Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_KIMAWARI);
        message_SetFace(ACTOR_NPC_KIMAWARI, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 I wonder why we had such an
                awful stench in our guild...
            """,
        });
        message_Talk({
            english=" It's a mystery! Eek!",
        });
        message_Close();
        jump @label_130;
    } elseif ( scn($SCENARIO_MAIN) >= [7, 1] || scn($SCENARIO_MAIN) >= [6, 5] || scn($SCENARIO_MAIN) >= [6, 1] || scn($SCENARIO_MAIN) >= [5, 5] ) {
        SetAnimation<actor ACTOR_NPC_KIMAWARI>(2);
        SetAnimation<actor ACTOR_PLAYER>(2);
        SetAnimation<actor ACTOR_ATTENDANT1>(2);
        Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_KIMAWARI);
        message_SetFace(ACTOR_NPC_KIMAWARI, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 Oh, there's nothing to be
                frightened of, [CS:N]Bidoof[CR].
            """,
        });
        message_Talk({
            english="""
                 Let us be brave and go on our
                exploration.
            """,
        });
        message_Close();
        jump @label_130;
    } elseif ( scn($SCENARIO_MAIN) >= [4, 7] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        SetAnimation<actor ACTOR_ATTENDANT1>(2);
        Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_KIMAWARI);
        message_SetFace(ACTOR_NPC_KIMAWARI, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english=" See that signboard on the left?",
        });
        message_Talk({
            english="""
                 That is the Pokémon Exploration
                Team Federation Q&A.
            """,
        });
        message_Talk({
            english="""
                 It lists topics that you should
                find useful as explorers.
            """,
        });
        message_Talk({
            english="""
                 You should take a look if you
                don't understand something.
            """,
        });
        message_Close();
        jump @label_130;
    } elseif ( scn($SCENARIO_MAIN) >= [4, 5] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        SetAnimation<actor ACTOR_ATTENDANT1>(2);
        Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_KIMAWARI);
        message_SetFace(ACTOR_NPC_KIMAWARI, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 Yes?[K] Oh, you want to know
                how the Job Bulletin Board works?
            """,
        });
        switch ( message_SwitchMenu(0, 1) ) {
            case menu({
                english="Yes",
            }):
            default:
                CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                message_SetFace(ACTOR_NPC_KIMAWARI, FACE_NORMAL, FACE_POS_STANDARD);
                message_Talk({
                    english="""
                         Very well.[K] I will be happy to
                        explain it to you.
                    """,
                });
                message_Talk({
                    english="""
                         First, you walk up to the Job
                        Bulletin Board and press [M:B2].
                    """,
                });
                message_Talk({
                    english="""
                         Using the Job Bulletin Board,
                        first choose the jobs you want to do someday.
                    """,
                });
                message_Talk({
                    english="""
                         The jobs you chose will then
                        appear in your menu's Job List. Each whole job
                        letter will be there with all the details.
                    """,
                });
                message_Talk({
                    english="""
                         Then use the Take Job command
                        to activate jobs on your Job List.[K] After that,
                        you can go to the dungeon to do the job!
                    """,
                });
                message_Talk({
                    english="""
                         Don't forget! You must activate
                        a job with Take Job if you want to do it.
                    """,
                });
                message_Close();
                jump @label_130;
            case menu({
                english="No",
            }):
                CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                message_SetFace(ACTOR_NPC_KIMAWARI, FACE_NORMAL, FACE_POS_STANDARD);
                message_Talk({
                    english="""
                         This Job Bulletin Board fills up
                        with many kinds of jobs.
                    """,
                });
                message_Talk({
                    english="""
                         They represent the cries of
                        Pokémon who are calling for our help.
                    """,
                });
                message_Talk({
                    english="""
                         Lending a helping hand to such
                        Pokémon in need is an important part of an
                        exploration team's work.
                    """,
                });
                message_Close();
                jump @label_130;
        }
    } elseif ( scn($SCENARIO_MAIN) >= [4, 3] || scn($SCENARIO_MAIN) >= [4, 2] || scn($SCENARIO_MAIN) >= [4, 1] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        SetAnimation<actor ACTOR_ATTENDANT1>(2);
        Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_KIMAWARI);
        message_SetFace(ACTOR_NPC_KIMAWARI, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english=" Eek!",
        });
        message_Talk({
            english="""
                 Oh my gosh! The new guild
                recruits![K] Delighted to meet you!
            """,
        });
        message_Talk({
            english="""
                 You can get all sorts of things
                here. It's quite convenient.
            """,
        });
        message_Talk({
            english="""
                 Do build a stock of items that
                will aid your explorations.
            """,
        });
        message_Close();
        jump @label_130;
    } elseif ( scn($SCENARIO_MAIN) >= [4, 0] || scn($SCENARIO_MAIN) >= [3, 1] ) {
        jump @label_130;
    } else {
        jump @label_130;
    }
}
