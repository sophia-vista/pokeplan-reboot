
def 0 {
    back_SetGround(LEVEL_D15P41A);
    if ( $PERFORMANCE_PROGRESS_LIST[7] ) {
        @label_0;
        supervision_Acting(2);
        @label_1;
        supervision_Acting(0);
        camera_SetMyself<performer 0>();
        screen_FadeIn(1, 30);
        bgm_PlayFadeIn(BGM_IN_THE_DEPTHS_OF_THE_PIT, 0, 256);
        Wait(30);
        message_SetFace(ACTOR_NPC_EMURITTO, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
        message_Talk({
            english=" ...[K]I...I lost.",
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        Wait(60);
        message_Mail({
            english="[CN][CS:N]Mesprit[CR] wants to join the team.",
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        @label_7;
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        switch ( ProcessSpecial(PROCESS_SPECIAL_PREPARE_MENU_ACCEPT_TEAM_MEMBER, 5, 0) ) { }
        switch ( message_Menu(MENU_ACCEPT_TEAM_MEMBER) ) {
            case 1:
            default:
                message_SetFace(ACTOR_NPC_NEW_FRIEND, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
                message_Talk({
                    english=" Oh, all right...[K] I'll go too.",
                });
                message_Talk({
                    english=" I'll go with you!",
                });
                CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                bgm_Stop();
                me_Play(5);
                message_Mail({
                    english="[CN][c_name:NPC_NEW_FRIEND] joined the team!",
                });
                WaitMe(5);
                message_Close();
                bgm_FadeOut(120);
                screen_FadeOut(1, 60);
                WaitBgm(BGM_IN_THE_DEPTHS_OF_THE_PIT);
                @label_4;
                message_Explanation({
                    english="""
                        [CN][player] cleared [CS:P]Quicksand Cave[CR]
                        [CN]in admirable fashion!
                    """,
                });
                message_Close();
                switch ( ProcessSpecial(55, 22, 0) ) { }
                end;
            case 2:
                CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                message_Mail({
                    english="""
                        [CN]Are you sure?[K]
                        [CN]You're sure you won't accept
                        [CN]this potential new member?
                    """,
                });
                switch ( message_SwitchMenu(0, 1) ) {
                    case menu({
                        english="Reconsider",
                    }):
                    default:
                        jump @label_7;
                    case menu({
                        english="Refuse",
                    }):
                        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                        message_Mail({
                            english="""
                                [CN][player] turned down
                                [CN]the Pokémon's offer to join.
                            """,
                        });
                        message_Mail({
                            english="""
                                [CN][CS:N]Mesprit[CR] appears to be
                                [CN]a little disappointed...
                            """,
                        });
                        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                        MovePositionMark<actor ACTOR_NPC_EMURITTO>(1, Position<'m0', 37.5, 10.5>);
                        WaitExecuteLives(ACTOR_NPC_EMURITTO);
                        Destroy<actor ACTOR_NPC_EMURITTO>();
                        message_Mail({
                            english="[CN][CS:N]Mesprit[CR] sadly went away...",
                        });
                        message_Close();
                        bgm_FadeOut(120);
                        screen_FadeOut(1, 60);
                        WaitBgm(BGM_IN_THE_DEPTHS_OF_THE_PIT);
                        jump @label_4;
                }
                break;
        }
    } else {
        supervision_Acting(1);
        jump @label_1;
    }
}
