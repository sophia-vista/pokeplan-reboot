
def 0 {
    back_SetGround(LEVEL_D01P11A);
    camera_SetPositionMark(Position<'m0', 20, 14.5>);
    screen_FadeIn(1, 30);
    back2_SetMode(0);
    dungeon_mode(0) = DMODE_OPEN_AND_REQUEST;
    dungeon_mode(1) = DMODE_OPEN_AND_REQUEST;
    dungeon_mode(2) = DMODE_REQUEST;
    dungeon_mode(3) = DMODE_OPEN;
    dungeon_mode(4) = DMODE_CLOSED;
    dungeon_mode(5) = DMODE_CLOSED;
    message_Notice({
        english="Which function would you like to use?",
    });
    switch ( message_SwitchMenu(1, 1) ) {
        case menu({
            english="Overall Presentation Check",
        }):
            @label_0;
            message_Close();
            worldmap_SetMode(1);
            worldmap_SetLevel(1);
            back2_SetMode(3);
            WaitSubScreen();
            worldmap_BlinkMark(1);
            worldmap_BlinkMark(2);
            worldmap_BlinkMark(192);
            worldmap_SetCamera(184);
            Wait(30);
            worldmap_MoveCamera(181);
            WaitSubScreen();
            worldmap_SetMessagePlace(181);
            Wait(120);
            worldmap_OffMessage();
            worldmap_MoveCamera(192);
            WaitSubScreen();
            worldmap_SetMessagePlace(192);
            Wait(120);
            worldmap_MoveCamera(2);
            WaitSubScreen();
            worldmap_SetMessagePlace(2);
            Wait(30);
            worldmap_OffMessage();
            worldmap_SetLevel(2);
            worldmap_SetCamera(184);
            WaitSubScreen();
            Wait(60);
            worldmap_ChangeLevel(3);
            worldmap_SetCamera(184);
            WaitSubScreen();
            Wait(60);
            worldmap_SetLevel(0);
            worldmap_SetCamera(193);
            WaitSubScreen();
            Wait(60);
            back2_SetMode(0);
            worldmap_SetMode(2);
            worldmap_SetLevel(1);
            back2_SetMode(3);
            worldmap_SetCamera(184);
            WaitSubScreen();
            Wait(30);
            worldmap_BlinkMark(2);
            Wait(60);
            worldmap_SetMark(2);
            Wait(30);
            worldmap_SetArrow(2);
            Wait(60);
            worldmap_DeleteArrow();
            Wait(30);
            worldmap_MoveCamera(2);
            WaitSubScreen();
            Wait(60);
            back2_SetMode(0);
            worldmap_SetMode(4);
            worldmap_SetLevel(2);
            back2_SetMode(3);
            worldmap_BlinkMark(2);
            worldmap_BlinkMark(184);
            worldmap_SetCamera(184);
            WaitSubScreen();
            Wait(60);
            @label_3;
            back2_SetMode(0);
            WaitSubScreen();
            back2_SetMode(-1);
            screen_FadeOut(1, 30);
            supervision_ExecuteStation(LEVEL_T00P01, 'M01A01', 0);
            hold;
        case menu({
            english="Clear clouds",
        }):
            worldmap_SetMode(3);
            back2_SetMode(3);
            WaitSubScreen();
            message_Notice({
                english="Which Level would you like?",
            });
            switch ( message_SwitchMenu(1, 1) ) {
                case menu({
                    english="Level 2",
                }):
                    message_Close();
                    worldmap_ChangeLevel(2);
                    worldmap_SetCamera(15);
                    WaitSubScreen();
                    Wait(60);
                    jump @label_3;
                case menu({
                    english="Level 3",
                }):
                    message_Close();
                    worldmap_ChangeLevel(3);
                    worldmap_SetCamera(25);
                    WaitSubScreen();
                    Wait(60);
                    jump @label_3;
                case menu({
                    english="Level 4",
                }):
                    message_Close();
                    worldmap_ChangeLevel(4);
                    worldmap_SetCamera(30);
                    WaitSubScreen();
                    Wait(60);
                    jump @label_3;
                case menu({
                    english="Level 5",
                }):
                    message_Close();
                    worldmap_ChangeLevel(5);
                    worldmap_SetCamera(35);
                    WaitSubScreen();
                    Wait(60);
                    jump @label_3;
                case menu({
                    english="Level 6",
                }):
                    message_Close();
                    worldmap_ChangeLevel(6);
                    worldmap_SetCamera(42);
                    WaitSubScreen();
                    Wait(60);
                    jump @label_3;
                case menu({
                    english="Level 7",
                }):
                    message_Close();
                    worldmap_ChangeLevel(7);
                    worldmap_SetCamera(47);
                    WaitSubScreen();
                    Wait(60);
                    jump @label_3;
                case menu({
                    english="Level 8",
                }):
                    message_Close();
                    worldmap_ChangeLevel(8);
                    worldmap_SetCamera(68);
                    WaitSubScreen();
                    Wait(60);
                    jump @label_3;
                default:
                    message_Close();
                    jump @label_3;
            }
            break;
        case menu({
            english="Presentation Test",
        }):
            message_Close();
            worldmap_SetMode(3);
            back2_SetMode(3);
            WaitSubScreen();
            worldmap_ChangeLevel(2);
            worldmap_SetCamera(15);
            WaitSubScreen();
            worldmap_SetArrow(15);
            Wait(60);
            worldmap_DeleteArrow();
            worldmap_BlinkMark(15);
            Wait(60);
            worldmap_SetMark(15);
            Wait(30);
            jump @label_3;
        default:
            message_Close();
            jump @label_3;
    }
}
