
def 0 {
    $SUB30_TREASURE_DISCOVER[0] = 0;
    supervision_Acting(0);
    SetAnimation<actor ACTOR_NPC_SOONANSU>(2);
    SetEffect<actor ACTOR_NPC_SOONANO>(EFFECT_JOYOUS, 3);
    ExecuteCommon<actor ACTOR_NPC_SOONANO>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_SOONANO);
    message_SetFace(ACTOR_NPC_SOONANO, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Did you hear the happy news,
            why not?
        """,
    });
    Wait(15);
    SetEffect<actor ACTOR_NPC_SOONANO>(EFFECT_NONE, 3);
    WaitExecuteLives(ACTOR_NPC_SOONANO);
    message_Talk({
        english="""
             Thanks to everyone's recycling
            efforts, Project P recently made a
            new discovery!
        """,
    });
    message_Close();
    se_Play(7944);
    ExecuteCommon<actor ACTOR_NPC_SOONANO>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
    SetEffect<performer 4>(EFFECT_CONFETTI, 3);
    WaitEffect<performer 4>();
    Wait(10);
    ExecuteCommon<actor ACTOR_NPC_SOONANSU>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
    SetEffect<performer 5>(EFFECT_CONFETTI, 3);
    WaitEffect<performer 5>();
    Wait(5);
    ExecuteCommon<actor ACTOR_NPC_SOONANO>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
    SetEffect<performer 6>(EFFECT_CONFETTI, 3);
    WaitEffect<performer 6>();
    Wait(15);
    ExecuteCommon<actor ACTOR_NPC_SOONANSU>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
    SetEffect<performer 7>(EFFECT_CONFETTI, 3);
    WaitEffect<performer 7>();
    Wait(60);
    SetEffect<performer 4>(EFFECT_NONE, 0);
    SetEffect<performer 5>(EFFECT_NONE, 0);
    SetEffect<performer 6>(EFFECT_NONE, 0);
    SetEffect<performer 7>(EFFECT_NONE, 0);
    se_FadeOut(7944, 30);
    Wait(30);
    message_Talk({
        english="""
             This time, treasure was
            discovered, so...
        """,
    });
    message_Talk({
        english="""
             We're offering a higher grade
            of recycled items!
        """,
    });
    message_Close();
    bgm_Stop();
    bgm_PlayFadeIn(BGM_PERFECT_SENTRY_DUTY, 0, 256);
    WaitBgm(BGM_PERFECT_SENTRY_DUTY);
    message_SetFace(ACTOR_NPC_SOONANO, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Please keep recycling! The more
            recycling, the better!
        """,
    });
    message_Close();
    bgm_PlayFadeIn(BGM_SPINDAS_CAFE, 0, 256);
    end;
}
