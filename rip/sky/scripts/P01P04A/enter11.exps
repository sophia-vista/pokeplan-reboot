                    } else {
                        $SCENARIO_TALK_BIT_FLAG[1] = 1;
                        message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
                        message_Talk({
                            english="""
                                 Hey, Team [team:]!
                                You've arrived at just the right time.
                            """,
                        });
                        message_Talk({
                            english="""
                                 Earlier, a strange Pokémon
