                                     ZZZT! Today, I would like you
                                    to search for and apprehend [c_name:RANDOM_REQUEST_NPC02]...
                                    Can you assist me? ZZZT!
                                """,
                            });
                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                            back2_SetMode(7);
                            WaitSubScreen();
                            message_Mail({
                                english="[CN]Would you like to accept this job request?",
                            });
                            switch ( message_SwitchMenu(0, 1) ) {
                                case menu({
                                    english="Yes",
                                }):
                                default:
                                    message_Close();
                                    back2_SetMode(-1);
                                    WaitSubScreen();
                                    Wait(20);
                                    switch ( ProcessSpecial(PROCESS_SPECIAL_ACCEPT_RANDOM_NPC_JOB, 0, 0) ) {
                                        case 1:
                                            message_Mail({
                                                english="""
                                                    [CN][hero] accepted
                                                    [CN]the job request!
                                                """,
                                            });
                                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                            message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
                                            message_Talk({
                                                english="""
                                                     ZZZT! Thank you for your
                                                    continued assistance! ZZZT!
                                                """,
                                            });
                                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                            jump @label_20;
                                        default:
                                            message_Mail({
                                                english="""
                                                    [CN]Your Job List is full,
                                                    [CN]so you cannot accept it.
                                                """,
                                            });
                                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                            jump @label_20;
                                    }
                                    break;
                                case menu({
                                    english="No",
                                }):
                                    message_Close();
                                    back2_SetMode(-1);
                                    WaitSubScreen();
                                    Wait(20);
                                    message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
                                    message_Talk({
                                        english="""
                                             ZZZT! I see... There's no way
                                            around it. Team [team:] is busy too.
                                            ZZZT!
                                        """,
                                    });
                                    jump @label_20;
                            }
                            break;
                    }
                    break;
            }
            break;
        case 6:
            switch ( ProcessSpecial(PROCESS_SPECIAL_GET_RANDOM_NPC_JOB_SUB_TYPE, 0, 0) ) {
                case 4:
                    switch ( ProcessSpecial(PROCESS_SPECIAL_GET_RANDOM_NPC_JOB_STILL_AVAILABLE, 0, 0) ) {
                        case 0:
                            message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
                            message_Talk({
                                english="""
                                     Please, for my friend, bring me
                                    a [CS:I]Gabite Scale[CR]!
                                    Please!
                                """,
                            });
                            jump @label_20;
                        default:
                            if ( $SCENARIO_TALK_BIT_FLAG[1] ) {
                                message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
                                message_Talk({
                                    english="""
                                         Hey, Team [team:]!
                                        Do you think you could lend me a hand?
                                    """,
                                });
                                CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                @label_71;
                                back2_SetMode(7);
                                WaitSubScreen();
                                message_Mail({
                                    english="[CN]Would you like to accept this job request?",
                                });
                                switch ( message_SwitchMenu(0, 1) ) {
                                    case menu({
                                        english="Yes",
                                    }):
                                    default:
                                        message_Close();
                                        back2_SetMode(-1);
                                        WaitSubScreen();
                                        Wait(20);
                                        switch ( ProcessSpecial(PROCESS_SPECIAL_ACCEPT_RANDOM_NPC_JOB, 0, 0) ) {
                                            case 1:
                                                message_Mail({
                                                    english="""
                                                        [CN][hero] accepted
                                                        [CN]the job request!
                                                    """,
                                                });
                                                CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                                message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
                                                message_Talk({
                                                    english="""
                                                         Thank you so very much!
                                                        You've made me very happy!
                                                    """,
                                                });
                                                jump @label_20;
                                            default:
                                                message_Mail({
                                                    english="""
                                                        [CN]Your Job List is full,
                                                        [CN]so you cannot accept it.
                                                    """,
                                                });
                                                CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                                jump @label_20;
                                        }
                                        break;
                                    case menu({
                                        english="No",
                                    }):
                                        message_Close();
                                        back2_SetMode(-1);
                                        WaitSubScreen();
                                        Wait(20);
                                        message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
                                        message_Talk({
                                            english=" WHAAAAT?!",
                                        });
                                        message_Talk({
                                            english="""
                                                 I really thought that if anyone
                                                would help me, it would definitely be
                                                Team [team:]!
                                            """,
                                        });
                                        message_Talk({
                                            english="""
                                                 That's too bad...
                                                Maybe a different exploration team will help...
                                            """,
                                        });
                                        jump @label_20;
                                }
                            } else {
                                $SCENARIO_TALK_BIT_FLAG[1] = 1;
                                message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
                                message_Talk({
                                    english="""
                                         Hey, Team [team:]!
                                        Do you think you could lend me a hand?
                                    """,
                                });
                                message_Talk({
                                    english="""
                                         I am in need of one more
                                        [CS:I]Gabite Scale[CR] to save my sick friend.
                                    """,
                                });
                                message_Talk({
                                    english="""
                                         It's said that when [CS:N]Gabite[CR] admits
                                        the strength of a team, it spares a [CS:I]Gabite
                                        Scale[CR] as a token of appreciation.
                                    """,
                                });
                                message_Talk({
                                    english="""
                                         [CS:N]Gabite[CR] can be found in the
                                        depths of [CS:P]Labyrinth Cave[CR]! Please get a
                                        [CS:I]Gabite Scale[CR] for me!
                                    """,
                                });
                                CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                jump @label_71;
                            }
                            break;
                    }
                    break;
                default:
                    @label_15;
                    switch ( ProcessSpecial(PROCESS_SPECIAL_GET_RANDOM_NPC_JOB_STILL_AVAILABLE, 0, 0) ) {
                        case 0:
                            message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
                            message_Talk({
                                english="""
                                     You know, everyone talks about
                                    how Team [team:] is an incredible
                                    exploration team.
                                """,
                            });
                            jump @label_20;
                        default:
                            message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
                            message_Talk({
                                english="""
                                     I heard that Team [team:]
                                    is a great exploration team. Is it true?
                                """,
                            });
                            message_Talk({
                                english="""
                                     If it is, I'd like you to retrieve
                                    an item for me...
                                """,
                            });
                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                            back2_SetMode(7);
                            WaitSubScreen();
                            message_Mail({
                                english="[CN]Would you like to accept this job request?",
                            });
                            switch ( message_SwitchMenu(0, 1) ) {
                                case menu({
                                    english="Yes",
                                }):
                                default:
                                    message_Close();
                                    back2_SetMode(-1);
                                    WaitSubScreen();
                                    Wait(20);
                                    switch ( ProcessSpecial(PROCESS_SPECIAL_ACCEPT_RANDOM_NPC_JOB, 0, 0) ) {
                                        case 1:
                                            message_Mail({
                                                english="""
                                                    [CN][hero] accepted
                                                    [CN]the job request!
                                                """,
                                            });
                                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                            message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
                                            message_Talk({
                                                english="""
                                                     Thank you!
                                                    I knew the rumors about the superb Team
                                                    [team:] had to be true!
                                                """,
                                            });
                                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                            jump @label_20;
                                        default:
                                            message_Mail({
                                                english="""
                                                    [CN]Your Job List is full,
                                                    [CN]so you cannot accept it.
                                                """,
                                            });
                                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                            jump @label_20;
                                    }
                                    break;
                                case menu({
                                    english="No",
                                }):
                                    message_Close();
                                    back2_SetMode(-1);
                                    WaitSubScreen();
                                    Wait(20);
                                    message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
                                    message_Talk({
                                        english="""
                                             Hmm...
                                            I knew you were that kind of exploration team.
                                        """,
                                    });
                                    jump @label_20;
                            }
                            break;
                    }
                    break;
            }
            break;
        case 11:
            switch ( ProcessSpecial(PROCESS_SPECIAL_GET_RANDOM_NPC_JOB_STILL_AVAILABLE, 0, 0) ) {
                case 0:
                    message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
                    message_Talk({
                        english="""
                             Team [team:] must be an
                            incredible team to take on a challenge like that.
                        """,
                    });
                    jump @label_20;
                default:
                    message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
                    message_Talk({
                        english=" Are you Team [team:]?",
                    });
                    switch ( message_SwitchMenu(0, 1) ) {
                        case menu({
                            english="Yes",
                        }):
                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                            message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
                            message_Talk({
                                english="""
                                     I was previously asked to give
                                    this to you by [c_name:RANDOM_REQUEST_NPC01].
                                """,
                            });
                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                            back2_SetMode(7);
                            WaitSubScreen();
                            message_Mail({
                                english="""
                                    [CN]Wha--[K] This! No matter how you look at it,
                                    [CN]it's a Challenge Letter!
                                """,
                            });
                            message_Mail({
                                english="[CN]Would you like to accept this challenge?",
                            });
                            switch ( message_SwitchMenu(0, 1) ) {
                                case menu({
                                    english="Yes",
                                }):
                                default:
                                    message_Close();
                                    back2_SetMode(-1);
                                    WaitSubScreen();
                                    Wait(20);
                                    switch ( ProcessSpecial(PROCESS_SPECIAL_ACCEPT_RANDOM_NPC_JOB, 0, 0) ) {
                                        case 1:
                                            message_Mail({
                                                english="""
                                                    [CN][hero] accepted
                                                    [CN]the challenge!
                                                """,
                                            });
                                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                            message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
                                            message_Talk({
                                                english="""
                                                     So we're clear. I've definitely
