                            """,
                        });
                        message_Mail({
                            english="""
                                [CN]Act promptly!
                                [CN]That's all!
                            """,
                        });
                        message_Mail({
                            english="""
                                [CN].....................[K]
                                [CN]Would you like to accept this Mission?
                            """,
                        });
                        switch ( message_SwitchMenu(0, 1) ) {
                            case menu({
                                english="Yes",
                            }):
                            default:
                                message_Close();
                                back2_SetMode(-1);
                                WaitSubScreen();
                                Wait(20);
                                switch ( ProcessSpecial(PROCESS_SPECIAL_ACCEPT_RANDOM_NPC_JOB, 0, 0) ) {
                                    case 1:
                                        message_Mail({
                                            english="""
                                                [CN][hero]
                                                [CN]accepted the Special Mission!
                                            """,
                                        });
                                        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                        jump @label_20;
                                    default:
                                        message_Mail({
                                            english="""
                                                [CN]Your Job List is full,
                                                [CN]so you cannot accept it.
                                            """,
                                        });
                                        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                        jump @label_20;
                                }
                                break;
                            case menu({
                                english="No",
