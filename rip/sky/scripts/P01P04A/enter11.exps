                                    back2_SetMode(-1);
                                    WaitSubScreen();
                                    Wait(20);
                                    message_SetFace(ACTOR_TALK_SUB, FACE_NORMAL, FACE_POS_STANDARD);
                                    message_Talk({
                                        english="""
                                             Huh? Oh no!
