
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_P01P04A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    SetAnimation<actor ACTOR_NPC_TOGEPII>(4);
    SetAnimation<actor ACTOR_NPC_BARIYAADO>(4);
    SetAnimation<actor ACTOR_NPC_OKUTAN>(4);
    SetAnimation<actor ACTOR_NPC_SUTORAIKU>(4);
    SetAnimation<actor ACTOR_NPC_JIGUZAGUMA>(4);
    SetAnimation<actor ACTOR_NPC_SANDOPAN>(4);
    se_Play(6669);
    screen_FadeIn(1, 30);
    Wait(30);
    MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m0', 46, 36.5>);
    MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m1', 41.5, 36.5>);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Wow, there's quite a crowd.",
            }
        case 2:
            {
                english=" Wow, there's a crowd.",
            }
        default:
            {
                english=" Wow, there's a crowd.",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    MovePositionMark<performer 0>(1, Position<'m2', 43.5, 27.5>);
    Wait(7);
    MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m3', 46, 29>);
    Move2PositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m4', 41.5, 29>);
    Wait(30);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UP);
    Wait(30);
    ExecuteCommon<actor ACTOR_NPC_PATCHIIRU>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_PATCHIIRU);
    SetEffect<actor ACTOR_NPC_PATCHIIRU>(EFFECT_JOYOUS, 3);
    message_SetFace(ACTOR_NPC_PATCHIIRU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(-1, -1);
    message_Talk({
        english="""
             May I have everyone's attention,
            please! First of all, I'd like to thank you for
            taking time out of your busy schedules!
        """,
    });
    se_FadeOut(6669, 90);
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetEffect<actor ACTOR_NPC_PATCHIIRU>(EFFECT_NONE, 3);
    SetAnimation<actor ACTOR_NPC_TOGEPII>(2);
    SetAnimation<actor ACTOR_NPC_BARIYAADO>(2);
    SetAnimation<actor ACTOR_NPC_OKUTAN>(2);
    SetAnimation<actor ACTOR_NPC_SUTORAIKU>(2);
    SetAnimation<actor ACTOR_NPC_JIGUZAGUMA>(2);
    SetAnimation<actor ACTOR_NPC_PACHIRISU>(2);
    SetAnimation<actor ACTOR_NPC_SANDOPAN>(2);
    SetEffect<actor ACTOR_NPC_PACHIRISU>(EFFECT_NONE, 3);
    SetEffect<actor ACTOR_NPC_NYOROTONO>(EFFECT_NONE, 3);
    Turn2Direction<actor ACTOR_NPC_HERAKUROSU>(4, 10, DIR_UP);
    Turn2Direction<actor ACTOR_NPC_PACHIRISU>(4, 10, DIR_UPRIGHT);
    Wait(3);
    Turn2Direction<actor ACTOR_NPC_JIGUZAGUMA>(4, 10, DIR_UP);
    Wait(4);
    Turn2Direction<actor ACTOR_NPC_BARIYAADO>(4, 10, DIR_UP);
    Wait(6);
    Turn2Direction<actor ACTOR_NPC_NYOROTONO>(4, 10, DIR_UPLEFT);
    Turn2Direction<actor ACTOR_NPC_OKUTAN>(4, 10, DIR_UPLEFT);
    Wait(5);
    Turn2Direction<actor ACTOR_NPC_TOGEPII>(4, 10, DIR_UPLEFT);
    Wait(3);
    MovePositionMark<actor ACTOR_NPC_SANDOPAN>(1, Position<'m5', 34, 24>);
    MovePositionMark<actor ACTOR_NPC_ZANGUUSU>(1, Position<'m6', 31.5, 26.5>);
    MovePositionMark<actor ACTOR_NPC_SUTORAIKU>(1, Position<'m7', 37.5, 31.5>, Position<'m8', 34, 29>);
    MovePositionMark<actor ACTOR_NPC_REDIBA>(1, Position<'m9', 50.5, 30>);
    MovePositionMark<actor ACTOR_NPC_TOGEPII>(1, Position<'m10', 54.5, 26.5>);
    Turn2Direction<actor ACTOR_NPC_REDIBA>(4, 10, DIR_UPLEFT);
    Turn2Direction<actor ACTOR_NPC_TOGEPII>(4, 10, DIR_UPLEFT);
    Turn2Direction<actor ACTOR_NPC_SANDOPAN>(4, 10, DIR_UPRIGHT);
    Turn2Direction<actor ACTOR_NPC_ZANGUUSU>(4, 10, DIR_UPRIGHT);
    Turn2Direction<actor ACTOR_NPC_SUTORAIKU>(4, 10, DIR_UPRIGHT);
    Wait(5);
    MovePositionOffset<actor ACTOR_NPC_JIGUZAGUMA>(1, 0, -8);
    Wait(30);
    message_SetFace(ACTOR_NPC_PATCHIIRU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(-1, -1);
    message_Talk({
        english="""
             Today I would like to give you
            some wonderful news of hopes
            and dreams!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(5138);
    SetEffect<actor ACTOR_NPC_PACHIRISU>(EFFECT_JOYOUS, 3);
    SetEffect<actor ACTOR_NPC_BARIYAADO>(EFFECT_JOYOUS, 3);
    SetEffect<actor ACTOR_NPC_TOGEPII>(EFFECT_JOYOUS, 3);
    ExecuteCommon<actor ACTOR_NPC_HERAKUROSU>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    Wait(3);
    ExecuteCommon<actor ACTOR_NPC_NYOROTONO>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    Wait(60);
    Wait(60);
    SetEffect<actor ACTOR_NPC_PACHIRISU>(EFFECT_NONE, 3);
    SetEffect<actor ACTOR_NPC_BARIYAADO>(EFFECT_NONE, 3);
    SetEffect<actor ACTOR_NPC_TOGEPII>(EFFECT_NONE, 3);
    se_FadeOut(5138, 30);
    Wait(30);
    bgm_PlayFadeIn(BGM_SPINDAS_CAFE, 0, 256);
    message_SetFace(ACTOR_NPC_PATCHIIRU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(-1, -1);
    message_Talk({
        english=" Ahem.",
    });
    message_Talk({
        english="""
             Thanks to your kind patronage,
            this café has been quite popular...
        """,
    });
    message_Talk({
        english="""
             We've been fortunate to have so
            many wonderful customers!
        """,
    });
    message_Talk({
        english="""
             This shop's pride and joy, the
            Recycle Shop, is fully operational and has
            collected many items.
        """,
    });
    message_Talk({
        english="""
             We would like to thank you for
            your kind patronage...
        """,
    });
    message_SetFace(ACTOR_NPC_PATCHIIRU, FACE_JOYOUS, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(-1, -1);
    message_Talk({
        english=" By opening a new service!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    ExecuteCommon<actor ACTOR_NPC_PATCHIIRU>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_PATCHIIRU);
    SetAnimation<actor ACTOR_NPC_PATCHIIRU>(26);
    WaitAnimation<actor ACTOR_NPC_PATCHIIRU>();
    WaitExecuteLives(ACTOR_NPC_PATCHIIRU);
    SetEffect<actor ACTOR_NPC_PATCHIIRU>(EFFECT_JOYOUS, 3);
    message_SetFace(ACTOR_NPC_PATCHIIRU, FACE_SHOUTING, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(-1, -1);
    message_Talk({
        english=" We're calling it Project P!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetEffect<actor ACTOR_NPC_PATCHIIRU>(EFFECT_NONE, 3);
    se_Play(7944);
    ExecuteCommon<actor ACTOR_NPC_SOONANO>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
    SetEffect<performer 3>(EFFECT_CONFETTI, 3);
    WaitEffect<performer 3>();
    Wait(10);
    ExecuteCommon<actor ACTOR_NPC_SOONANSU>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
    SetEffect<performer 4>(EFFECT_CONFETTI, 3);
    WaitEffect<performer 4>();
    Wait(10);
    ExecuteCommon<actor ACTOR_NPC_SOONANO>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
    SetEffect<performer 5>(EFFECT_CONFETTI, 3);
    WaitEffect<performer 5>();
    Wait(10);
    ExecuteCommon<actor ACTOR_NPC_SOONANSU>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
    SetEffect<performer 6>(EFFECT_CONFETTI, 3);
    WaitEffect<performer 6>();
    Wait(10);
    WaitExecutePerformer(6);
    Wait(30);
    se_FadeOut(7944, 60);
    Wait(60);
    se_Play(8962);
    SetEffect<actor ACTOR_NPC_BARIYAADO>(EFFECT_QUESTION_MARK, 3);
    WaitEffect<actor ACTOR_NPC_BARIYAADO>();
    WaitExecuteLives(ACTOR_NPC_BARIYAADO);
    message_SetFace(ACTOR_NPC_BARIYAADO, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(3, 3);
    message_Talk({
        english=" Project P?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_OKUTAN, FACE_NORMAL, FACE_POS_TOP_R_FACEINW);
    message_FacePositionOffset(1, -2);
    message_Talk({
        english=" What's that?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetAnimation<actor ACTOR_NPC_PATCHIIRU>(2);
    Wait(15);
    message_SetFace(ACTOR_NPC_PATCHIIRU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(-1, -1);
    message_Talk({
        english="""
             This project aims to use the
            items gathered at the Recycle Shop in order to
            explore unexplored places.
        """,
    });
    message_Talk({
        english=" Allow me to explain.",
    });
    message_Close();
    screen_FadeOut(1, 30);
    end;
}

def 1 for actor ACTOR_NPC_NYOROTONO {
    SetAnimation(2);
    Wait(30);
    @label_0;
    forever {
        SetEffect(EFFECT_LAUGHING, 3);
        WaitRandom(60, 90);
        SetEffect(EFFECT_NONE, 3);
        WaitRandom(60, 180);
        continue;  // may be redundant
    }
}

def 2 for actor ACTOR_NPC_PACHIRISU {
    @label_1;
    SetAnimation(4);
    SetEffect(EFFECT_JOYOUS, 3);
    WaitRandom(60, 90);
    SetEffect(EFFECT_NONE, 3);
    SetAnimation(2);
    WaitRandom(90, 180);
    jump @label_1;
}
