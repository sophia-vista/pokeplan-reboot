    ExecuteCommon<actor ACTOR_NPC_SOONANO>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_SOONANO);
    message_SetFace(ACTOR_NPC_SOONANO, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Did you hear the happy news,
            why not?
        """,
    });
    Wait(15);
    SetEffect<actor ACTOR_NPC_SOONANO>(EFFECT_NONE, 3);
    WaitExecuteLives(ACTOR_NPC_SOONANO);
    message_Talk({
        english="""
             Thanks to everyone's recycling
            efforts, Project P recently made a
            new discovery!
        """,
    });
    message_Close();
    se_Play(7944);
    ExecuteCommon<actor ACTOR_NPC_SOONANO>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
    SetEffect<performer 4>(EFFECT_CONFETTI, 3);
