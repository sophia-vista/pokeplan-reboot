        english=" I'll mark it on your map for you!",
    });
    message_Close();
    screen_FadeOut(0, 15);
    switch ( $SUB30_SPOT_LEVEL ) {
        case 1:
        default:
            @label_0;
            worldmap_SetMode(4);
            back2_SetMode(3);
            WaitSubScreen();
            worldmap_SetCamera(89);
            worldmap_SetArrow(89);
            worldmap_BlinkMark(89);
            me_Play(6);
            message_Close();
            message_Mail({
                english="""
                    [CN]You can now go to
                    [CN][CS:P]Landslide Cave[CR]!
                """,
            });
            WaitMe(6);
            message_Close();
            dungeon_mode(88) = DMODE_OPEN_AND_REQUEST;
            @label_5;
            screen2_FadeOut(0, 15);
            back2_SetMode(0);
            screen_FadeIn(1, 15);
            message_SetFace(ACTOR_NPC_SOONANO, FACE_NORMAL, FACE_POS_STANDARD);
            message_Talk({
                english=" Please keep recycling!",
            });
            message_Close();
            end;
        case 2:
            worldmap_SetMode(4);
            back2_SetMode(3);
