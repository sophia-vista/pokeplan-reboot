
def 0 {
    sound_Stop();
    back_SetDungeonBanner(19, 0);
    screen_FadeIn(1, 16);
    Wait(60);
    screen_FadeOut(1, 16);
    Wait(15);
    back_SetGround(LEVEL_D12P41A);
    if ( $PERFORMANCE_PROGRESS_LIST[7] ) {
        @label_0;
        supervision_Acting(1);
        camera_SetMyself<performer 0>();
        screen_FadeIn(1, 30);
        bgm_PlayFadeIn(BGM_IN_THE_DEPTHS_OF_THE_PIT, 0, 256);
        MovePositionMark<actor ACTOR_PLAYER_APPOINT>(1, Position<'m4', 32.5, 21.5>);
        MovePositionMark<actor ACTOR_ADVENTURE_NPC1>(1, Position<'m5', 35.5, 23.5>);
        MovePositionMark<actor ACTOR_ADVENTURE_NPC2>(1, Position<'m6', 29.5, 23.5>);
        MovePositionMark<actor ACTOR_ADVENTURE_NPC3>(1, Position<'m7', 32.5, 25.5>);
        WaitExecuteLives(ACTOR_PLAYER_APPOINT);
        Wait(15);
        ExecuteCommon<actor ACTOR_PLAYER_APPOINT>(CORO_LOOK_AROUND_FUNC_SERIES, 0);
        Wait(12);
        ExecuteCommon<actor ACTOR_ADVENTURE_NPC1>(CORO_LOOK_AROUND_LEFT_FUNC_SERIES, 0);
        Wait(4);
        ExecuteCommon<actor ACTOR_ADVENTURE_NPC2>(CORO_LOOK_AROUND_DOWN_FUNC_SERIES, 0);
        Wait(7);
        ExecuteCommon<actor ACTOR_ADVENTURE_NPC3>(CORO_LOOK_AROUND_RIGHT_FUNC_SERIES, 0);
        WaitExecuteLives(ACTOR_PLAYER_APPOINT);
        Wait(15);
        @label_1;
        message_Mail({
            english="[CN]There appears to be no one here.",
        });
        message_Mail({
            english="""
                [CN]It's impossible to go any farther.[K]
                [CN]Let's go back to Treasure Town.
            """,
        });
        message_Close();
        bgm_FadeOut(120);
        screen_FadeOut(1, 60);
        WaitBgm(BGM_IN_THE_DEPTHS_OF_THE_PIT);
        message_Explanation({
            english="""
                [CN][player] cleared [CS:P]Amp Plains[CR]
                [CN]in admirable fashion!
            """,
        });
        message_Close();
        debug_Print('LABEL_D018_CLEAR3');
        end;
    } else {
        supervision_Acting(0);
        camera_SetMyself<performer 0>();
        screen_FadeIn(1, 30);
        bgm_PlayFadeIn(BGM_IN_THE_DEPTHS_OF_THE_PIT, 0, 256);
        MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m0', 30.5, 21.5>);
        MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m1', 34.5, 21.5>);
        MovePositionMark<actor ACTOR_UNIT_NPC1>(1, Position<'m2', 32.5, 25.5>);
        MovePositionMark<actor ACTOR_UNIT_NPC2>(1, Position<'m3', 35.5, 24.5>);
        WaitExecuteLives(ACTOR_PLAYER);
        Wait(15);
        ExecuteCommon<actor ACTOR_ATTENDANT1>(CORO_LOOK_AROUND_FUNC_SERIES, 0);
        Wait(12);
        ExecuteCommon<actor ACTOR_PLAYER>(CORO_LOOK_AROUND_LEFT_FUNC_SERIES, 0);
        Wait(4);
        ExecuteCommon<actor ACTOR_UNIT_NPC1>(CORO_LOOK_AROUND_DOWN_FUNC_SERIES, 0);
        Wait(7);
        ExecuteCommon<actor ACTOR_UNIT_NPC2>(CORO_LOOK_AROUND_RIGHT_FUNC_SERIES, 0);
        WaitExecuteLives(ACTOR_PLAYER);
        Wait(15);
        jump @label_1;
    }
}
