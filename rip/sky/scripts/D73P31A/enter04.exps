
def 0 {
    SetAnimation<actor ACTOR_PLAYER_APPOINT>(2);
    message_Mail({
        english="[CN]Would you like to look at the scenery?",
    });
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
            @label_0;
            message_Close();
            Turn2Direction<actor ACTOR_PLAYER_APPOINT>(4, 10, DIR_UP);
            WaitExecuteLives(ACTOR_PLAYER_APPOINT);
            Wait(6);
            screen_FadeOut(1, 30);
            supervision_ExecuteCommon(CORO_EVENT_S32_02);
            end;
        case menu({
            english="No",
        }):
        default:
            message_Close();
            supervision_Suspend(-2);
            end;
    }
}
