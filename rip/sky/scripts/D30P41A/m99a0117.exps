
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_D30P41A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_TEMPORAL_PINNACLE, 0, 256);
    Wait(30);
    message_SetFace(ACTOR_NPC_DIARUGA, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" ..................",
    });
    message_Talk({
        english="""
             I...[K] I HAVE BEEN DEFEATED...[K]
            GRRR...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Wait(60);
    message_Mail({
        english="[CN][CS:N]Dialga[CR] wants to join the team.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    @label_5;
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    switch ( ProcessSpecial(PROCESS_SPECIAL_PREPARE_MENU_ACCEPT_TEAM_MEMBER, 7, 0) ) { }
    switch ( message_Menu(MENU_ACCEPT_TEAM_MEMBER) ) {
        case 1:
        default:
            @label_0;
            message_SetFace(ACTOR_NPC_NEW_FRIEND, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
            message_Talk({
                english="""
                     TO THE VICTOR...[K]GO THE
                    SPOILS! I ACCEPT THAT!
                """,
            });
            message_Talk({
                english="""
                     I WOULD BE HONORED...[K]
                    TO WALK BY YOUR SIDE!
                """,
            });
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            bgm_Stop();
            me_Play(5);
            message_Mail({
                english="[CN][c_name:NPC_NEW_FRIEND] joined the team!",
            });
            WaitMe(5);
            message_Close();
            screen_FadeOut(1, 60);
            bgm_FadeOut(120);
            WaitBgm(BGM_TEMPORAL_PINNACLE);
            @label_2;
            message_Explanation({
                english="""
                    [CN][player] cleared [CS:P]Temporal Tower[CR]
                    [CN]in admirable fashion!
                """,
            });
            message_Close();
            end;
        case 2:
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_Mail({
                english="""
                    [CN]Are you sure?[K]
                    [CN]You're sure you won't accept
                    [CN]this potential new member?
                """,
            });
            switch ( message_SwitchMenu(0, 1) ) {
                case menu({
                    english="Reconsider",
                }):
                default:
                    jump @label_5;
                case menu({
                    english="Refuse",
                }):
                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                    message_Mail({
                        english="""
                            [CN][player] turned down
                            [CN]the Pokémon's offer to join.
                        """,
                    });
                    message_Mail({
                        english="""
                            [CN][CS:N]Dialga[CR] appears to be
                            [CN]a little disappointed...
                        """,
                    });
                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                    MovePositionMark<actor ACTOR_NPC_DIARUGA>(1, Position<'m0', 34.5, 19.5>);
                    WaitExecuteLives(ACTOR_NPC_DIARUGA);
                    Destroy<actor ACTOR_NPC_DIARUGA>();
                    message_Mail({
                        english="[CN][CS:N]Dialga[CR] sadly went away...",
                    });
                    message_Close();
                    screen_FadeOut(1, 60);
                    bgm_FadeOut(120);
                    WaitBgm(BGM_TEMPORAL_PINNACLE);
                    jump @label_2;
            }
            break;
    }
}
