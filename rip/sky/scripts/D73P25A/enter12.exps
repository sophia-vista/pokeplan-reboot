            message_SetFace(ACTOR_NPC_DONMERU, FACE_NORMAL, FACE_POS_STANDARD);
            message_Talk({
                english="""
                     Thank you for trading with me.
                    You've helped me immensely.
                """,
            });
            message_Close();
            @label_130;
            JumpCommon(CORO_END_TALK);
        } else {
            item_SetVariable(0, $ITEM_BACKUP_TAKE);
            item_SetVariable(1, $ITEM_BACKUP_GET);
            ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
