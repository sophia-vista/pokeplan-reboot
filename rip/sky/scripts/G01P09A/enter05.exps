                                """,
                            });
                            message_Mail({
                                english="""
                                    Oh my gosh, I never suspected [CS:N]Bidoof[CR] could
                                    leer in such an icky way! Eek!
                                """,
                            });
                            message_Mail({
                                english="It's another new discovery! Eek!",
                            });
                            jump @label_1;
                        case 10:
                            @label_18;
                            message_Mail({
                                english="""
                                    [CN][CS:Y]Sunflora[CR]'s Oh My Gosh Diary
                                    [CN]Entry 10: Oh My Gosh! [CS:N]Dusknoir[CR]!
                                    [CN]OO Month XX Day, Sunny
                                """,
                            });
                            message_Mail({
                                english="""
                                    Oh my gosh oh my gosh oh my gosh!
