                            jump @label_1;
                        case 8:
                            @label_20;
                            message_Mail({
                                english="""
                                    [CN][CS:Y]Sunflora[CR]'s Oh My Gosh Diary
                                    [CN]Entry 8: Inspiration!
                                    [CN]OO Month XX Day, Sunny
                                """,
                            });
                            message_Mail({
                                english="""
                                    Oh my gosh! Something happened that was
                                    totally uplifting!
                                """,
                            });
                            message_Mail({
                                english="""
                                    Tonight, Team [team:] had to go without
                                    dinner for some silly reason...
                                """,
                            });
                            message_Mail({
                                english="""
                                    While we were eating (oh my gosh!), [CS:N]Bidoof[CR]
                                    was leaving a part of his dinner untouched!
                                """,
                            });
                            message_Mail({
                                english="""
                                    And this is [CS:N]Bidoof[CR], right? The one we call the
                                    "bottomless barrel" because of his big appetite!
                                """,
                            });
                            message_Mail({
                                english="""
                                    Whatever could have caused that?! Maybe he's
                                    heartbroken!
                                """,
                            });
                            message_Mail({
                                english="""
                                    Well, I guessed that at first. But then I
