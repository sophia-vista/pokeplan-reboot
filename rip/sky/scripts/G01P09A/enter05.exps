            } elseif ( scn($SCENARIO_MAIN) >= [5, 5] ) {
                jump @label_25;
            } elseif ( scn($SCENARIO_MAIN) >= [4, 7] ) {
                jump @label_26;
            } elseif ( scn($SCENARIO_MAIN) >= [4, 3] ) {
                jump @label_27;
            } else {
                jump @label_1;
            }
            break;
    }
}
