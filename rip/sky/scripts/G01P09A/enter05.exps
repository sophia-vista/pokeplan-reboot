                        case 5:
                            @label_23;
                            message_Mail({
                                english="""
                                    [CN][CS:Y]Sunflora[CR]'s Oh My Gosh Diary
                                    [CN]Entry 5: Types and Matchups
                                    [CN]OO Month XX Day, Sunny
                                """,
                            });
                            message_Mail({
                                english="Oh my gosh! I had a nasty scare the other day!",
                            });
                            message_Mail({
                                english="""
                                    While exploring a dungeon, I was careless and
                                    took a hit from a Fire-type move! Silly me!
                                """,
                            });
                            message_Mail({
                                english="""
                                    I'm a Grass type! So I ended up taking a lot of
                                    damage! Eek!
                                """,
                            });
                            message_Mail({
                                english="I should really explain what all this is about.",
                            });
                            message_Mail({
                                english="""
                                    As you know, Pokémon come in many types,
                                    like Fire and Water.
                                """,
                            });
                            message_Mail({
                                english="""
                                    All moves have types too! The matchup
                                    between the attacking move's type and the
                                    defending Pokémon's type affects damage!
                                """,
                            });
                            message_Mail({
                                english="""
                                    As a Grass type, I should really watch out for
                                    Fire-type moves! Knowing how types match up
                                    is so important.
                                """,
                            });
                            message_Mail({
                                english="""
                                    P.S. When I got into trouble because of all
                                    this...[K] It was [CS:N]Loudred[CR] who saved me.
                                """,
                            });
                            message_Mail({
                                english="Thank you, [CS:N]Loudred[CR].",
                            });
                            message_Mail({
                                english="""
                                    That other time I yelled at him! I said, "Oh my
                                    gosh, [CS:N]Loudred[CR]! I never want to go exploring
                                    with you ever again!"
                                """,
                            });
                            message_Mail({
                                english="""
                                    But...eek! Am I ever sorry for saying that!
                                    I take back everything nasty I said!
                                """,
                            });
                            message_Mail({
                                english="""
                                    I wonder if he would go to a dungeon with me
                                    ever again?
                                """,
                            });
                            message_Mail({
                                english="""
                                    I think I will go apologize to him sincerely
                                    tomorrow. Yes, that's what I will do.
                                """,
                            });
                            message_Mail({
                                english="""
                                    I'm sorry, [CS:N]Loudred[CR]. I hope we can keep on
                                    being teammates.
                                """,
                            });
                            jump @label_1;
                        case 4:
