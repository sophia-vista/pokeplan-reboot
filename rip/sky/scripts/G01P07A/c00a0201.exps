
def 0 {
    sound_Stop();
    if ( scn($SCENARIO_MAIN) == [4, 0] ) {
        @label_0;
        back_SetBanner2(LEVEL_S21P01A, 0, 128, 96, 3, {
            english="The Scream",
        });
        screen_FadeIn(1, 45);
        Wait(160);
        screen_FadeOut(1, 45);
        Wait(15);
        @label_4;
        $SCENARIO_MAIN_BIT_FLAG[1] = 1;
        message_Narration(30, {
            english="[CN]The next morning...",
        });
        message_Close();
        Wait(30);
        message_SetFace(ACTOR_NPC_DOGOOMU, FACE_NORMAL, FACE_POS_BOTTOM_L_FACEINW);
        message_Talk({
            english=" UP AND AT 'EM![K] IT'S MORNING!",
        });
        message_Close();
        back_SetGround(LEVEL_G01P07A);
        supervision_StationCommon(0);
        supervision_Acting(0);
        camera_SetMyself<performer 0>();
        SetAnimation<actor ACTOR_PLAYER>(76);
        SetAnimation<actor ACTOR_ATTENDANT1>(76);
        screen_FadeIn(1, 30);
        se_Play(8971);
        camera_SetEffect(2, 2, 3.0);
        SetAnimation<actor ACTOR_NPC_DOGOOMU>(18);
        WaitAnimation<actor ACTOR_NPC_DOGOOMU>();
        WaitExecuteLives(ACTOR_NPC_DOGOOMU);
        SetAnimation<actor ACTOR_NPC_DOGOOMU>(2);
        camera_SetEffect(0, 0, 0);
        Wait(10);
        MovePositionOffset<actor ACTOR_NPC_DOGOOMU>(1.5, -96, 0);
        WaitExecuteLives(ACTOR_NPC_DOGOOMU);
        Destroy<actor ACTOR_NPC_DOGOOMU>();
        SlidePositionOffset<actor ACTOR_ATTENDANT1>(1, 1, 0);
        WaitExecuteLives(ACTOR_ATTENDANT1);
        Wait(2);
        SlidePositionOffset<actor ACTOR_PLAYER>(1, 1, 0);
        SlidePositionOffset<actor ACTOR_ATTENDANT1>(1, -1, 0);
        WaitExecuteLives(ACTOR_ATTENDANT1);
        Wait(2);
        SlidePositionOffset<actor ACTOR_PLAYER>(1, -1, 0);
        SlidePositionOffset<actor ACTOR_ATTENDANT1>(1, 1, 0);
        WaitExecuteLives(ACTOR_ATTENDANT1);
        Wait(2);
        SlidePositionOffset<actor ACTOR_PLAYER>(1, 1, 0);
        SlidePositionOffset<actor ACTOR_ATTENDANT1>(1, -1, 0);
        WaitExecuteLives(ACTOR_ATTENDANT1);
        Wait(2);
        SlidePositionOffset<actor ACTOR_PLAYER>(1, -1, 0);
        message_SetFace(ACTOR_ATTENDANT1, FACE_DIZZY, FACE_POS_STANDARD);
        message_SwitchTalk ($PARTNER_TALK_KIND) {
            case 1:
                {
                    english="""
                         Ugh! Good morning,
                        [hero]...
                    """,
                }
            case 2:
                {
                    english="""
                         Ugh! Good morning,
                        [hero]...
                    """,
                }
            default:
                {
                    english="""
                         Ugh! Good morning,
                        [hero]...
                    """,
                }
        }
        message_Close();
        Wait(30);
        bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD, 0, 256);
        SetAnimation<actor ACTOR_PLAYER>(63);
        SetAnimation<actor ACTOR_ATTENDANT1>(63);
        WaitAnimation<actor ACTOR_PLAYER>();
        WaitAnimation<actor ACTOR_ATTENDANT1>();
        Wait(10);
        SetAnimation<actor ACTOR_PLAYER>(2);
        Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_DOWN);
        SetAnimation<actor ACTOR_ATTENDANT1>(2);
        Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_DOWN);
        Wait(30);
        main_SetGround(LEVEL_G01P07A);
        $SCENARIO_MAIN_BIT_FLAG[7] = 1;
        CallCommon(CORO_HANYOU_SAVE_FUNC);
        CallCommon(CORO_EVENT_END_MAPIN);
