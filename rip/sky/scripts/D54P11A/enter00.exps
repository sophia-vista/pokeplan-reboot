
def 0 {
    debug_Print('ENTER');
    switch ( sector() ) {
        case 1:
            @label_0;
            debug_Print('CHARA_SET');
            supervision_StationCommon(0);
            if ( scn($SCENARIO_SIDE) >= [45, 2] ) {
                @label_1;
                switch ( $EXECUTE_SPECIAL_EPISODE_TYPE ) {
                    case 3:
                    default:
                        break;
                }
                @label_3;
                switch ( sector() ) {
                    case 1:
                        @label_4;
                        debug_Print('LABEL_END');
                        JumpCommon(CORO_COMMON_ENTER);
                    default:
                        debug_Print('LABEL_PLAYER_SET');
                        debug_Print('LABEL_PLAYER_SET_RESUME');
                        if ( $SCENARIO_MAIN_BIT_FLAG[7] ) {
                            debug_Print('LABEL_CHARMS_RESUME');
                            $SCENARIO_MAIN_BIT_FLAG[7] = 0;
                            supervision_StationCommon(62);
                            @label_7;
                            debug_Print('SET_BGM');
                            bgm_PlayFadeIn(BGM_SOUTHERN_JUNGLE, 0, 256);
                            debug_Print('LABEL_ENTER_END');
                            jump @label_4;
                        } else {
                            @label_6;
                            debug_Print('LABEL_CHARMS_SET_NORMAL');
                            supervision_StationCommon(61);
                            jump @label_7;
                        }
                        break;
                }
            } else {
                supervision_StationCommon(1);
                jump @label_1;
            }
            break;
        default:
            screen_FadeOutAll(1, 0);
            debug_Print('LABEL_BACK_SET');
            back_SetGround(LEVEL_D54P11A);
            jump @label_0;
    }
}

def 1 for actor ACTOR_PLAYER_CHARMS {
    SetAnimation(2);
    WaitScreenFade();
    WaitScreenFadeAll();
    end;
}
