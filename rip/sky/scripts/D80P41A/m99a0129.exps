
def 0 {
    back_SetGround(LEVEL_D80P41A);
    if ( $PERFORMANCE_PROGRESS_LIST[7] ) {
        @label_0;
        supervision_Acting(2);
        @label_1;
        supervision_Acting(0);
        camera_SetMyself<performer 0>();
        me_Play(1);
        message_ResetActor();
        message_Explanation({
            english="""
                [CN][player] defeated [CS:N]Gabite[CR]
                [CN]in an impressive manner![W:100]
            """,
        });
        message_Explanation({
            english="""
                [CN][player] triumphed over
                [CN][CS:N]Gabite[CR] in a battle!
            """,
        });
        message_Close();
        Wait(30);
        screen_FadeIn(1, 30);
        bgm_PlayFadeIn(BGM_IN_THE_DEPTHS_OF_THE_PIT, 0, 256);
        Wait(30);
        SetAnimation<actor ACTOR_NPC_GABAITO>(5);
        Wait(60);
        SetAnimation<actor ACTOR_NPC_GABAITO>(2);
        message_Mail({
            english="""
                [CN]Oh?[K]
                [CN][CS:N]Gabite[CR] is saying something.
            """,
        });
        message_Mail({
            english="""
                [CN]Apparently, [CS:N]Gabite[CR]
                [CN]was impressed with you.
            """,
        });
        message_Mail({
            english="""
                [CN]You're getting loot
                [CN]as proof you battled!
            """,
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        se_Play(8194);
        SetEffect<performer 3>(EFFECT_LIGHT_ENGULFING2, 3);
        WaitEffect<performer 3>();
        WaitExecutePerformer(3);
        supervision_Acting(3);
        SetEffect<performer 3>(EFFECT_NONE, 3);
        Wait(30);
        WaitSe(8194);
        Move2PositionMark<actor ACTOR_PLAYER>(1, Position<'m0', 41.5, 29.5>);
        Move2PositionMark<actor ACTOR_PLAYER_APPOINT>(1, Position<'m1', 41.5, 29.5>);
        Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_UP);
        Turn2Direction<actor ACTOR_PLAYER_APPOINT>(4, 10, DIR_UP);
        WaitExecuteLives(ACTOR_PLAYER);
        WaitExecuteLives(ACTOR_PLAYER_APPOINT);
        Wait(30);
        message_Mail({
            english="""
                [CN][player] opened
                [CN]the treasure box.
            """,
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        se_Play(6411);
        SetAnimation<object OBJECT_G01P05A1_106>(18);
        WaitAnimation<object OBJECT_G01P05A1_106>();
        WaitExecuteObject(OBJECT_G01P05A1_106);
        WaitSe(6411);
        message_Mail({
            english="""
                [CN]The treasure box contained...[K]
                [CN]a [CS:I]Gabite Scale[CR]!
            """,
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        item_Set(0, 92, 0);
        switch ( message_Menu(MENU_GIVE_ITEM) ) {
            case 2:
                @label_3;
                bgm_FadeOut(120);
                screen_FadeOut(1, 60);
                WaitBgm(BGM_IN_THE_DEPTHS_OF_THE_PIT);
                message_Explanation({
                    english="""
                        [CN][player] cleared [CS:P]Labyrinth Cave[CR]
                        [CN]in admirable fashion!
                    """,
                });
                message_Close();
                end;
            default:
                Wait(10);
                bgm_Stop();
                me_Play(9);
                message_Mail({
                    english="""
                        [CN][player] obtained
                        [CN]a [CS:I]Gabite Scale[CR]!
                    """,
                });
                WaitMe(9);
                CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                message_Mail({
                    english="[CN] Thank you, [CS:N]Gabite[CR]!",
                });
                message_Close();
                jump @label_3;
        }
    } else {
        supervision_Acting(1);
        jump @label_1;
    }
}
