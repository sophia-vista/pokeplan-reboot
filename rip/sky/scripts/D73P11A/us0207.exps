                                                switch ( ProcessSpecial(PROCESS_SPECIAL_REMOVE_ITEMS_TYPE_IN_BAG, 180, 0) ) { }
                                                message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_STANDARD);
                                                message_Talk({
                                                    english="""
                                                         OK. That's one [CS:I]Sky Gift[CR], to be
                                                        sent to [CS:N]Croagunk[CR]! ♪
                                                    """,
                                                });
                                                message_Talk({
                                                    english=" Anything else we can do?",
                                                });
                                                jump @label_152;
                                            case menu({
                                                english="No",
                                            }):
                                                jump @label_136;
                                        }
                                    }
                                    break;
                                case menu({
                                    english="[partner]",
                                }):
                                    if ( $SCENARIO_MAIN_BIT_FLAG[60] ) {
                                        message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_STANDARD);
                                        message_Talk({
                                            english="""
                                                 We are currently sending a gift
                                                to [partner].
                                            """,
                                        });
                                        message_Talk({
                                            english="""
                                                 Maybe there will be a reply, so
                                                please wait a little while to send another one.
                                            """,
                                        });
                                        message_Talk({
                                            english="""
                                                 If there is any reply for
                                                Team [team:], we will pass it along to
                                                [CS:N]Spinda[CR] to deliver to you...
                                            """,
                                        });
                                        message_Talk({
                                            english=" Please check with [CS:N]Spinda[CR].",
                                        });
                                        message_Close();
                                        jump @label_130;
                                    } else {
                                        message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_STANDARD);
                                        message_Talk({
                                            english="""
                                                 Is it OK to send it to
                                                [partner]?
                                            """,
                                        });
                                        switch ( message_SwitchMenu(0, 1) ) {
                                            case menu({
                                                english="Yes",
                                            }):
                                            default:
                                                $SCENARIO_MAIN_BIT_FLAG[60] = 1;
                                                switch ( ProcessSpecial(PROCESS_SPECIAL_REMOVE_ITEMS_TYPE_IN_BAG, 180, 0) ) { }
                                                message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_STANDARD);
                                                message_Talk({
                                                    english="""
                                                         OK. That's one [CS:I]Sky Gift[CR], to be
                                                        sent to [partner]! ♪
                                                    """,
                                                });
                                                message_Talk({
                                                    english=" Anything else we can do?",
                                                });
                                                jump @label_152;
                                            case menu({
                                                english="No",
                                            }):
                                                jump @label_136;
                                        }
                                    }
                                    break;
                                case menu({
                                    english="Cancel",
                                }):
                                    message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_STANDARD);
                                    message_Talk({
                                        english="""
                                             Come back anytime you want to
                                            send a gift! ♪
                                        """,
                                    });
                                    message_Close();
                                    jump @label_130;
                            }
                            break;
                        default:
                            @label_137;
                            message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_STANDARD);
                            message_Talk({
                                english="""
                                     Oh? I'm afraid you don't
                                    have any [CS:I]Sky Gift[CR]s.
                                """,
                            });
                            message_Close();
                            jump @label_130;
                    }
                    break;
                case menu({
                    english="Info",
                }):
                    message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_STANDARD);
                    message_Talk({
                        english="""
                             [CS:K]Shaymin[CR]'s Delivery Service
                            will send [CS:I]Sky Gift[CR]s to your friends for you.
                        """,
                    });
                    message_Talk({
                        english="""
                             Handing out gifts in person is so
                            very exciting...
                        """,
                    });
                    message_Talk({
                        english="""
                             But delivering a gift that is
                            unexpected is also a wonderful surprise,
                            don't you think?
                        """,
                    });
                    message_Talk({
                        english="""
                             To a person you like, or to
                            someone that's helped you...
                        """,
                    });
                    message_Talk({
                        english="""
                             Anytime you want to send a gift,
                            you can count on [CS:K]Shaymin[CR]'s Delivery Service
                            to get it there! ♪
                        """,
                    });
                    message_Talk({
                        english="""
                             If the person Team [team:]
                            sent a gift to sends a reply in return...
                        """,
                    });
                    message_Talk({
                        english="""
                             We'll pass that reply on to
                            [CS:N]Spinda[CR] to deliver, so please check with
                            him, OK?
                        """,
                    });
                    jump @label_132;
                case menu({
                    english="Cancel",
                }):
                default:
                    message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_STANDARD);
                    message_Talk({
                        english="""
                             Come back anytime you want to
                            send a gift! ♪
                        """,
                    });
                    message_Close();
                    jump @label_130;
            }
        } else {
            $SCENARIO_TALK_BIT_FLAG[123] = 1;
            message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_STANDARD);
            message_Talk({
                english="""
                     Sorry to have kept you waiting!
                    This is [CS:K]Shaymin[CR]'s Delivery Service!
                """,
            });
            message_Talk({
                english="""
                     We are a delivery service that
                    will send [CS:I]Sky Gift[CR]s to your friends for you.
                """,
            });
            message_Talk({
                english="""
                     To a person you like, or to
                    someone that's helped you...
                """,
            });
            message_Talk({
                english="""
                     Anytime you want to send a gift,
                    you can count on [CS:K]Shaymin[CR]'s Delivery Service
                    to get it there! ♪
                """,
            });
            jump @label_132;
        }
    } elseif ( scn($SCENARIO_MAIN) >= [29, 16] || scn($SCENARIO_MAIN) >= [29, 15] || scn($SCENARIO_MAIN) >= [29, 14] || scn($SCENARIO_MAIN) >= [29, 13] || scn($SCENARIO_MAIN) >= [29, 12] || scn($SCENARIO_MAIN) >= [29, 11] || scn($SCENARIO_MAIN) >= [29, 10] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        SetAnimation<actor ACTOR_ATTENDANT1>(2);
        Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_SHEIMI1);
        message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english=" Hi there, travelers!",
        });
        message_Talk({
            english="""
                 This is [CS:K]Shaymin[CR]'s Delivery
                Service.
            """,
        });
        message_Talk({
            english="""
                 But right now we're in the
                middle of opening preparations. Please come
                back later.
            """,
        });
        message_Close();
        jump @label_130;
    } elseif ( scn($SCENARIO_MAIN) >= [29, 8] || scn($SCENARIO_MAIN) >= [29, 6] || scn($SCENARIO_MAIN) >= [29, 5] || scn($SCENARIO_MAIN) >= [29, 4] || scn($SCENARIO_MAIN) >= [29, 3] || scn($SCENARIO_MAIN) >= [29, 2] || scn($SCENARIO_MAIN) >= [29, 1] || scn($SCENARIO_MAIN) >= [25, 4] || scn($SCENARIO_MAIN) >= [25, 3] || scn($SCENARIO_MAIN) >= [25, 2] || scn($SCENARIO_MAIN) >= [25, 2] || scn($SCENARIO_MAIN) >= [25, 1] || scn($SCENARIO_MAIN) >= [24, 1] || scn($SCENARIO_MAIN) >= [24, 1] || scn($SCENARIO_MAIN) >= [23, 3] || scn($SCENARIO_MAIN) >= [23, 2] || scn($SCENARIO_MAIN) >= [23, 1] || scn($SCENARIO_MAIN) >= [22, 3] || scn($SCENARIO_MAIN) >= [22, 2] || scn($SCENARIO_MAIN) >= [21, 2] || scn($SCENARIO_MAIN) >= [21, 1] || scn($SCENARIO_MAIN) >= [20, 4] || scn($SCENARIO_MAIN) >= [20, 3] || scn($SCENARIO_MAIN) >= [20, 2] || scn($SCENARIO_MAIN) >= [20, 1] || scn($SCENARIO_MAIN) >= [17, 3] || scn($SCENARIO_MAIN) >= [17, 1] || scn($SCENARIO_MAIN) >= [16, 2] || scn($SCENARIO_MAIN) >= [16, 0] || scn($SCENARIO_MAIN) >= [15, 4] || scn($SCENARIO_MAIN) >= [15, 1] || scn($SCENARIO_MAIN) >= [14, 5] || scn($SCENARIO_MAIN) >= [14, 4] || scn($SCENARIO_MAIN) >= [14, 2] || scn($SCENARIO_MAIN) >= [14, 1] || scn($SCENARIO_MAIN) >= [13, 2] || scn($SCENARIO_MAIN) >= [13, 1] || scn($SCENARIO_MAIN) >= [12, 4] || scn($SCENARIO_MAIN) >= [12, 3] || scn($SCENARIO_MAIN) >= [12, 1] || scn($SCENARIO_MAIN) >= [10, 2] || scn($SCENARIO_MAIN) >= [10, 1] || scn($SCENARIO_MAIN) >= [9, 5] || scn($SCENARIO_MAIN) >= [9, 4] || scn($SCENARIO_MAIN) >= [9, 2] || scn($SCENARIO_MAIN) >= [9, 1] || scn($SCENARIO_MAIN) >= [8, 7] || scn($SCENARIO_MAIN) >= [8, 6] || scn($SCENARIO_MAIN) >= [8, 5] || scn($SCENARIO_MAIN) >= [8, 3] || scn($SCENARIO_MAIN) >= [8, 2] || scn($SCENARIO_MAIN) >= [8, 1] || scn($SCENARIO_MAIN) >= [7, 6] || scn($SCENARIO_MAIN) >= [7, 3] || scn($SCENARIO_MAIN) >= [7, 2] || scn($SCENARIO_MAIN) >= [7, 1] || scn($SCENARIO_MAIN) >= [6, 5] || scn($SCENARIO_MAIN) >= [6, 1] || scn($SCENARIO_MAIN) >= [5, 5] || scn($SCENARIO_MAIN) >= [4, 7] || scn($SCENARIO_MAIN) >= [4, 5] || scn($SCENARIO_MAIN) >= [4, 3] || scn($SCENARIO_MAIN) >= [4, 2] || scn($SCENARIO_MAIN) >= [4, 1] || scn($SCENARIO_MAIN) >= [4, 0] || scn($SCENARIO_MAIN) >= [3, 1] ) {
        jump @label_130;
    } else {
        jump @label_130;
    }
}
