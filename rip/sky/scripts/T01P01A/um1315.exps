            Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_BANEBUU);
            message_SetFace(ACTOR_NPC_BANEBUU, FACE_NORMAL, FACE_POS_STANDARD);
            message_Talk({
                english="""
                     Inside a dungeon...[K]until you make
                    a move, no enemies can take their turns. Did
                    you know that surprising fact?
                """,
            });
            message_Talk({
                english="""
                     So when you run into an enemy
                    in a dungeon...[K]you don't have to panic.
                """,
            });
            message_Talk({
                english="""
                     That gives you time to stay calm
                    while you choose what to do. You'll be a
                    great explorer if you make careful choices! ♪
                """,
            });
            message_Close();
            jump @label_130;
        } else {
            $SCENARIO_TALK_BIT_FLAG[2] = 1;
            ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
            ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
            SetAnimation<actor ACTOR_ATTENDANT1>(2);
            Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_BANEBUU);
            message_SetFace(ACTOR_NPC_BANEBUU, FACE_NORMAL, FACE_POS_STANDARD);
            message_Talk({
                english="""
                     Oh, [hero] and
                    [partner]!
                """,
            });
            message_Talk({
                english=" It's me! [CS:N]Spoink[CR]!",
            });
            message_Talk({
                english="""
                     Thank you so much for getting
                    my pearl back for me!
                """,
            });
            message_Talk({
                english="""
                     I'll give you a useful tip as
                    further gratitude! ♪
                """,
            });
            message_Talk({
                english="""
                     Inside a dungeon...[K]until you make
                    a move, no enemies can take their turns. Did
                    you know that surprising fact?
                """,
            });
            message_Talk({
                english="""
                     So when you run into an enemy
                    in a dungeon...[K]you don't have to panic.
                """,
            });
            message_Talk({
                english="""
                     That gives you time to stay calm
                    while you choose what to do. You'll be a
                    great explorer if you make careful choices! ♪
                """,
            });
            message_Close();
            jump @label_130;
        }
    } elseif ( scn($SCENARIO_MAIN) >= [4, 3] || scn($SCENARIO_MAIN) >= [4, 2] || scn($SCENARIO_MAIN) >= [4, 1] || scn($SCENARIO_MAIN) >= [4, 0] || scn($SCENARIO_MAIN) >= [3, 1] ) {
        jump @label_130;
    } else {
        jump @label_130;
    }
}
