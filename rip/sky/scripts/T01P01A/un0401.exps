
def 0 {
    if ( scn($SCENARIO_SIDE) >= [43, 2] ) {
    }
    @label_2;
    ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
    ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
    message_SetFace(ACTOR_NPC_ZANGUUSU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             You and [CS:N]Haunter[CR] are both pretty
            famous among exploration teams, you know...
        """,
    });
    message_Talk({
        english="""
             I'd like to fight either one of
            you one day...
        """,
    });
    message_Talk({
        english=" Even if you win...",
    });
    message_Talk({
        english="""
             ...I could probably get a
            scratch or two in with my sharp claws...
        """,
    });
    message_Talk({
        english="""
             Oooh...[K] Just thinking about it
            is exciting!
        """,
    });
    message_Talk({
        english="""
             Please! [K]When you've got some
            free time, come challenge me!
        """,
    });
    message_Close();
    @label_1;
    JumpCommon(CORO_END_TALK);
}
