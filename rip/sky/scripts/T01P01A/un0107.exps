
def 0 {
    if ( scn($SCENARIO_SIDE) >= [40, 7] || scn($SCENARIO_SIDE) >= [40, 3] ) {
        @label_3;
        JumpCommon(CORO_END_TALK);
    } elseif ( scn($SCENARIO_SIDE) >= [40, 2] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        message_SetFace(ACTOR_NPC_HIMEGUMA, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english=" Oh, hi, [CS:Y]Bidoof[CR]!",
        });
        message_Talk({
            english="""
                 Errands again today?[K]
                You're working hard as always.
            """,
        });
        message_Close();
        jump @label_3;
    } else {
        jump @label_3;
    }
}
