def 1 for actor ACTOR_NPC_BANEBUU {
    switch ( sector() ) {
        case 10:
            SetMoveRange(Position<'m0', 43, 34>, 6, 8);
            JumpCommon(CORO_MOVE_TYPE1);
        case 6:
            SetMoveRange(Position<'m1', 43, 34>, 6, 8);
            JumpCommon(CORO_MOVE_TYPE1);
        default:
            JumpCommon(CORO_LIVES_MOVE_NORMAL);
    }
}

