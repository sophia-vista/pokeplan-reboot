def 1 for actor ACTOR_NPC_HIMEGUMA {
    switch ( sector() ) {
        case 4:
            SetMoveRange(Position<'m0', 43, 27>, 7, 7);
            JumpCommon(CORO_MOVE_TYPE1);
        case 2:
            SetMoveRange(Position<'m1', 43, 27>, 7, 7);
            JumpCommon(CORO_MOVE_TYPE1);
        default:
            JumpCommon(CORO_LIVES_MOVE_NORMAL);
    }
}

