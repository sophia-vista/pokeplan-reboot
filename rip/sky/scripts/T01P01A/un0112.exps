
def 0 {
    if ( scn($SCENARIO_SIDE) >= [40, 7] || scn($SCENARIO_SIDE) >= [40, 3] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        message_SetFace(ACTOR_NPC_OKORIZARU, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 I heard that there's a Hot Spring
                around here somewhere...
            """,
        });
        message_Talk({
            english=" Do you know where it is?",
        });
        message_Talk({
            english="""
                 I've always got my arms up, so
                my shoulders get so stiff...
            """,
        });
        message_Talk({
            english="""
                 So...I'd like to get well by
                soaking in the Hot Spring.
            """,
        });
        message_Talk({
            english="""
                 I'm thinking, once I find the Hot
                Spring, I'll ask my sparring partner [CS:N]Mankey[CR] to
                join me.
            """,
        });
        message_Close();
        @label_3;
        JumpCommon(CORO_END_TALK);
    } elseif ( scn($SCENARIO_SIDE) >= [40, 2] ) {
        jump @label_3;
    } else {
        jump @label_3;
    }
}
