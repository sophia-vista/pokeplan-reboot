
def 0 {
    if ( scn($SCENARIO_SIDE) >= [40, 7] || scn($SCENARIO_SIDE) >= [40, 3] || scn($SCENARIO_SIDE) >= [40, 2] ) {
        @label_3;
        JumpCommon(CORO_END_TALK);
    } else {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        message_SetFace(ACTOR_NPC_BAKUUDA, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 If you can graduate from 
                [CS:N]Wigglytuff[CR]'s Guild, you sure can be an 
                amazing explorer!
            """,
        });
        message_Talk({
            english=" Good luck!",
        });
        message_Close();
        jump @label_3;
    }
}
