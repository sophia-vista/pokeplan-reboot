    } elseif ( scn($SCENARIO_MAIN) >= [8, 2] || scn($SCENARIO_MAIN) >= [8, 1] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        SetAnimation<actor ACTOR_ATTENDANT1>(2);
        Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_HEIGANI);
        message_SetFace(ACTOR_NPC_HEIGANI, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 Hey, hey! It's no time to be
                losing motivation! What's a little stink?
            """,
        });
        message_Talk({
            english="""
                 There's an expedition coming up,
                hey, hey!
            """,
        });
        message_Close();
        jump @label_130;
    } elseif ( scn($SCENARIO_MAIN) >= [7, 6] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        SetAnimation<actor ACTOR_ATTENDANT1>(2);
        Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_HEIGANI);
        message_SetFace(ACTOR_NPC_HEIGANI, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 We're going to have a putrid
                time, hey, hey...
            """,
        });
        message_Close();
        jump @label_130;
    } elseif ( scn($SCENARIO_MAIN) >= [7, 3] || scn($SCENARIO_MAIN) >= [7, 2] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        SetAnimation<actor ACTOR_ATTENDANT1>(2);
        Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_HEIGANI);
        message_SetFace(ACTOR_NPC_HEIGANI, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 Hey, hey, hey! Those guys you
                were talking with...
            """,
        });
        message_Talk({
            english="""
                 They looked like some rough
                customers, hey, hey?
            """,
        });
        message_Close();
        jump @label_130;
    } elseif ( scn($SCENARIO_MAIN) >= [7, 1] || scn($SCENARIO_MAIN) >= [6, 5] || scn($SCENARIO_MAIN) >= [6, 1] || scn($SCENARIO_MAIN) >= [5, 5] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        SetAnimation<actor ACTOR_ATTENDANT1>(2);
        Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_HEIGANI);
        message_SetFace(ACTOR_NPC_HEIGANI, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 Hey, hey, you two![K] Want to hear
                a tip about these Job Bulletin Board tasks?
            """,
        });
        switch ( message_SwitchMenu(0, 1) ) {
            case menu({
                english="Yes",
            }):
            default:
                CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                message_SetFace(ACTOR_NPC_HEIGANI, FACE_NORMAL, FACE_POS_STANDARD);
                message_Talk({
                    english="""
                         Sure, you want to hear![K] I'll tell
                        you, hey, hey!
                    """,
                });
                message_Talk({
                    english="""
                         You can take as many of those
                        jobs and outlaw missions for the same dungeon
                        as you want! Hey, hey!
                    """,
                });
                message_Talk({
                    english="""
                         Here's an example! Let's say
                        there are two jobs in the same dungeon, one
                        on 5F and another on 10F...
                    """,
                });
                message_Talk({
                    english="""
                         First, add the jobs to your own
                        Job List. Second, select Take Job for both of
                        them. Third, go to that dungeon!
                    """,
                });
                message_Talk({
                    english="""
                         Once there, you do the job on 5F
                        first! Then, instead of returning here, you
                        continue onward to do the job on 10F!
                    """,
                });
                message_Talk({
                    english="""
                         That way, you do two jobs in one
                        exploration! Hey, hey!
                    """,
                });
                message_Talk({
                    english=" Nice and neat, right? Hey, hey!",
                });
                message_Close();
                jump @label_130;
            case menu({
                english="No",
            }):
                CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                message_SetFace(ACTOR_NPC_HEIGANI, FACE_NORMAL, FACE_POS_STANDARD);
                message_Talk({
                    english="""
                         What, you don't want to know?
                        Say it ain't so, hey, hey...
                    """,
                });
                message_Close();
                jump @label_130;
        }
    } elseif ( scn($SCENARIO_MAIN) >= [4, 7] || scn($SCENARIO_MAIN) >= [4, 5] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        SetAnimation<actor ACTOR_ATTENDANT1>(2);
        Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_HEIGANI);
        message_SetFace(ACTOR_NPC_HEIGANI, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 Hey, hey! You're going out on an
                exploration?
            """,
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        Turn2Direction<actor ACTOR_NPC_HEIGANI>(4, 10, DIR_RIGHT);
        WaitExecuteLives(ACTOR_NPC_HEIGANI);
        message_SetFace(ACTOR_NPC_HEIGANI, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 You can start exploring by going
                out this way, hey, hey!
            """,
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        Turn2DirectionLives<actor ACTOR_NPC_HEIGANI>(4, 10, ACTOR_PLAYER);
        WaitExecuteLives(ACTOR_NPC_HEIGANI);
        message_SetFace(ACTOR_NPC_HEIGANI, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english=" Hey, hey! You be careful!",
        });
        message_Talk({
            english="""
                 Hey, hey! If you're looking for
                adventure, you gotta get ready for whatever
                comes your way!
            """,
        });
        message_Close();
        jump @label_130;
    } elseif ( scn($SCENARIO_MAIN) >= [4, 3] || scn($SCENARIO_MAIN) >= [4, 2] || scn($SCENARIO_MAIN) >= [4, 1] ) {
        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        SetAnimation<actor ACTOR_ATTENDANT1>(2);
        Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_HEIGANI);
        message_SetFace(ACTOR_NPC_HEIGANI, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 Hey, hey, hey! You there![K]
                You're the new rookies at the guild, aren't you?
            """,
        });
        message_Talk({
            english=" Hey, hey! My name's [CS:N]Corphish[CR]!",
        });
        message_Talk({
            english="""
                 I'm an apprentice at [CS:N]Wigglytuff[CR]'s
                Guild too. Hey, hey!
            """,
        });
        message_Talk({
            english="""
                 If you don't know what's going
                on or whatever...you come ask me! You got
                that, hey, hey?
            """,
        });
        message_Close();
        jump @label_130;
    } elseif ( scn($SCENARIO_MAIN) >= [4, 0] || scn($SCENARIO_MAIN) >= [3, 1] ) {
        jump @label_130;
    } else {
        jump @label_130;
    }
}
