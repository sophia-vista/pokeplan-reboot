        ExecuteCommon<actor ACTOR_TALK_MAIN>(CORO_LIVES_REPLY_NORMAL, 0);
        ExecuteCommon<actor ACTOR_TALK_SUB>(CORO_LIVES_REPLY_NORMAL, 0);
        SetAnimation<actor ACTOR_ATTENDANT1>(2);
        Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_RINGUMA);
        message_SetFace(ACTOR_NPC_RINGUMA, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 I don't know if it's because time
                is going out of control or not, but...
            """,
        });
        message_Talk({
            english=" No one can evolve lately.",
        });
        message_Talk({
            english="""
                 You know how Pokémon evolve
                only after certain conditions are met, right?
            """,
        });
        message_Talk({
            english="""
                 Well, right now, no one can
                evolve, no matter what...
            """,
        });
        message_Close();
        jump @label_131;
    } elseif ( scn($SCENARIO_MAIN) >= [4, 5] || scn($SCENARIO_MAIN) >= [4, 3] || scn($SCENARIO_MAIN) >= [4, 2] || scn($SCENARIO_MAIN) >= [4, 1] || scn($SCENARIO_MAIN) >= [4, 0] || scn($SCENARIO_MAIN) >= [3, 1] ) {
        jump @label_131;
    } else {
        jump @label_131;
    }
}
