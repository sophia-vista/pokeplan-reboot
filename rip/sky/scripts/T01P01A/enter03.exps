
def 0 {
    switch ( $EXECUTE_SPECIAL_EPISODE_TYPE ) {
        case 0:
            @label_0;
            if ( scn($SCENARIO_SIDE) < [40, 2] ) {
                @label_4;
                debug_Print('BGM_FADEOUT');
                bgm_FadeOut(60);
                main_EnterGround(LEVEL_T01P03A, 30);
                hold;
            } else {
                @label_3;
                SetAnimation<actor ACTOR_PLAYER_BIPPA>(2);
                SetAnimation<actor ACTOR_PLAYER>(2);
                SetAnimation<actor ACTOR_ATTENDANT1>(2);
                message_Mail({
                    english="""
                        [CN]There's a notice posted here.[K]
                        [CN]Something's written on it...
                    """,
                });
                message_Mail({
                    english="""
                        "[CS:K]Marowak[CR] Dojo has collapsed.[K] But it will rise
                        from the rubble again!"
                    """,
                });
                message_Mail({
                    english="""
                        "Yes! The Dojo will be resurrected to its
                        former glory![K]
                                  - [CS:K]Marowak[CR] Dojo's Sensei -"
                    """,
                });
                message_Close();
                JumpCommon(CORO_END_TALK);
            }
            break;
        case 2:
            SetAnimation<actor ACTOR_PLAYER_KIMAWARI>(2);
            message_SetFace(ACTOR_PLAYER_KIMAWARI, FACE_NORMAL, FACE_POS_STANDARD);
            message_Talk({
                english="""
                     I'd like to do some training at
                    [CS:K]Marowak[CR] Dojo...
                """,
            });
            message_Talk({
                english="""
                     But if I do that, [CS:N]Haunter[CR] will
                    get away!
                """,
            });
            message_Talk({
                english="""
                     I should hold off for now and go
                    catch [CS:N]Haunter[CR]!
                """,
            });
            message_Close();
            JumpCommon(CORO_END_TALK);
        default:
            if ( scn($SCENARIO_MAIN) >= [6, 0] ) {
                if ( $SCENARIO_MAIN_BIT_FLAG[12] ) {
                    jump @label_4;
                } else {
                    debug_Print('BGM_FADEOUT');
                    bgm_FadeOut(60);
                    screen_FadeOutAll(0, 30);
                    screen2_FadeOut(1, 30);
                    WaitScreenFade();
                    WaitScreenFadeAll();
                    screen_FadeOut(1, 0);
                    screen_FadeInAll(1, 0);
                    supervision_ExecuteCommon(CORO_EVENT_M00_05);
                    end;
                }
            } else {
                jump @label_3;
            }
            break;
    }
}

def 1 for actor ACTOR_PLAYER {
    hold;
}

def 2 for actor ACTOR_PLAYER_BIPPA {
    hold;
}
