-- Version 1 had no nickname column on owned_pokemon and no party table. Migrating to version 2 adds both.
ALTER TABLE owned_pokemon ADD COLUMN nickname TEXT;

CREATE TABLE module_party (
    module_id TEXT NOT NULL,
    slot INTEGER NOT NULL CHECK (slot BETWEEN 1 AND 6),
    owned_id TEXT NOT NULL REFERENCES owned_pokemon(id) ON DELETE CASCADE,
    PRIMARY KEY (module_id, slot),
    UNIQUE (module_id, owned_id)
);
