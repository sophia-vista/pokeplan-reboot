-- Version 2 of the spike schema: a slice of the target model (docs/pokelife DATA_AND_MIGRATIONS section 7):
-- one owned Pokémon table, one Bag stack table, one Poké balance and an idempotent reward ledger.
CREATE TABLE owned_pokemon (
    id TEXT NOT NULL PRIMARY KEY,
    species INTEGER NOT NULL,
    level INTEGER NOT NULL DEFAULT 1,
    nickname TEXT
);

CREATE TABLE module_party (
    module_id TEXT NOT NULL,
    slot INTEGER NOT NULL CHECK (slot BETWEEN 1 AND 6),
    owned_id TEXT NOT NULL REFERENCES owned_pokemon(id) ON DELETE CASCADE,
    PRIMARY KEY (module_id, slot),
    UNIQUE (module_id, owned_id)
);

CREATE TABLE bag_stack (
    item_id TEXT NOT NULL PRIMARY KEY,
    count INTEGER NOT NULL CHECK (count >= 0)
);

CREATE TABLE poke_balance (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    amount INTEGER NOT NULL CHECK (amount >= 0)
);

CREATE TABLE reward_ledger (
    event_id TEXT NOT NULL PRIMARY KEY,
    source_module TEXT NOT NULL,
    poke INTEGER NOT NULL,
    settled_at INTEGER NOT NULL
);

insertPokemon:
INSERT INTO owned_pokemon(id, species, level, nickname) VALUES (?, ?, ?, ?);

setParty:
INSERT INTO module_party(module_id, slot, owned_id) VALUES (?, ?, ?);

partyOf:
SELECT slot, owned_id FROM module_party WHERE module_id = ? ORDER BY slot;

releasePokemon:
DELETE FROM owned_pokemon WHERE id = ?;

ensureBalance:
INSERT OR IGNORE INTO poke_balance(id, amount) VALUES (1, 0);

addPoke:
UPDATE poke_balance SET amount = amount + ? WHERE id = 1;

balance:
SELECT amount FROM poke_balance WHERE id = 1;

settle:
INSERT INTO reward_ledger(event_id, source_module, poke, settled_at) VALUES (?, ?, ?, ?);

ledgerCount:
SELECT count(*) FROM reward_ledger;
